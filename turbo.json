{
  "$schema": "https://v2-8-13.turborepo.dev/schema.json",
  "globalDependencies": [
    "script/test-omni-control.ts",
    ".github/actions/omni-binaries/action.yml",
    "script/module-registry.json",
    "script/toolchain-registry.json",
    "packages/*-specialist/skills/**",
    "modules/specialists/*/skills/**"
  ],
  "globalEnv": ["CI", "ORCHESTRA_EXPERIMENTAL_OMNI_SPAWNER", "ORCHESTRA_OMNI_CONTROL"],
  "globalPassThroughEnv": ["CI", "HUGR_OMNI_ADDON", "HUGR_OMNI_SUPERVISOR", "ORCHESTRA_DISABLE_RIPGREP_DOWNLOAD"],
  "tasks": {
    "typecheck": {
      "dependsOn": ["transit"]
    },
    "orchestra#typecheck": {
      "dependsOn": ["transit"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/.github/scripts/archie-host-*.ts",
        "$TURBO_ROOT$/.github/scripts/tsconfig.archie.json",
        "$TURBO_ROOT$/packages/app-shell/src/**"
      ]
    },
    "build": {
      "dependsOn": [],
      "outputs": ["dist/**"]
    },
    // SDK generation cleans source exports that the plugin compiler reads.
    "@orchestra/plugin#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    // A test task hashes only its own package unless it depends on its workspace dependencies. Most of them
    // have no build script, so ^build alone left a cached pass in place after a dependency changed;
    // ^transit puts every workspace dependency's files into each test hash without running anything.
    "transit": {
      "dependsOn": ["^transit"]
    },
    "hugr-omni#transit": {
      "dependsOn": ["^transit"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/native/omni/crates/**",
        "$TURBO_ROOT$/native/omni/Cargo.toml",
        "$TURBO_ROOT$/native/omni/Cargo.lock",
        "$TURBO_ROOT$/native/omni/rust-toolchain.toml",
        "$TURBO_ROOT$/native/omni/.cargo/**"
      ]
    },
    "orchestra#test": {
      "dependsOn": ["transit", "^build"],
      "outputs": [],
      "passThroughEnv": ["*"]
    },
    "@orchestra/core#test": {
      "dependsOn": ["transit", "^build"],
      // Core's tests read these out-of-package CI sources and execute the campaign observation helpers.
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/native/omni/campaign/**/*.ts",
        "$TURBO_ROOT$/script/test-ci-request.ts",
        "$TURBO_ROOT$/script/test-ci-desktop.ts",
        "$TURBO_ROOT$/.github/workflows/test-ci.yml",
        "$TURBO_ROOT$/.github/actions/setup-bun/action.yml",
        "$TURBO_ROOT$/.github/workflows/distribution-bundle.yml",
        "$TURBO_ROOT$/apps/cli/script/test.ts",
        "$TURBO_ROOT$/apps/cli/test/*.test.ts"
      ],
      "outputs": [],
      // Windows PowerShell initializes its module-analysis cache before the recorder's first CIM query.
      // Hash and preserve the runner's cache path; strict mode otherwise triggers cold discovery past 10 s.
      "env": ["PSModuleAnalysisCachePath"]
    },
    "@orchestra/app#test": {
      // Extension: the shell-owned E2E harness consumes the separate web entry.
      "dependsOn": ["transit", "^build", "@orchestra/web#transit"],
      "outputs": []
    },
    "@orchestra/ui#test": {
      "dependsOn": ["transit", "^build"],
      "outputs": []
    },
    "@orchestra/session-ui#test": {
      "dependsOn": ["transit", "^build"],
      "outputs": []
    },
    "@orchestra/cli#test": {
      "dependsOn": ["transit"],
      // The artifact suites import Desktop's CLI artifact verifier, which is not a CLI dependency.
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/apps/desktop/src/main/cli-artifacts.ts",
        "$TURBO_ROOT$/apps/orchestra/src/maestro/**",
        "$TURBO_ROOT$/modules/maestro/coordination/src/**",
        "$TURBO_ROOT$/packages/*-specialist/skills/**",
        "$TURBO_ROOT$/modules/specialists/*/skills/**"
      ],
      "outputs": [],
      // The compiled-CLI suites run only on an Actions runner (GITHUB_ACTIONS=false plus RUNNER_OS) and hand each
      // build and install the runner's own environment.
      "passThroughEnv": ["*"]
    },
    "@orchestra/script#test": {
      "dependsOn": ["transit", "^build"],
      // Extension: resolver integration cases consume the root producer and shared fixture sources.
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/script/monolith-inventory.ts",
        "$TURBO_ROOT$/script/omni-mirror.sh",
        "$TURBO_ROOT$/script/atlas-baseline.mjs",
        "$TURBO_ROOT$/foundation/atlas/scripts/git-source-root.mjs",
        "$TURBO_ROOT$/modules/atlas/scripts/git-source-root.mjs",
        "$TURBO_ROOT$/script/module-registry.json",
        "$TURBO_ROOT$/script/test-ci-package.ts",
        "$TURBO_ROOT$/script/test-ci-location.ts",
        "$TURBO_ROOT$/script/test-ci-request.ts",
        "$TURBO_ROOT$/script/test-ci-paths.ts",
        "$TURBO_ROOT$/script/archive-inventory.ts",
        "$TURBO_ROOT$/script/archive-scopes.json",
        "$TURBO_ROOT$/script/recovery-bundle.ts",
        "$TURBO_ROOT$/script/recovery-publication.ts",
        "$TURBO_ROOT$/apps/cli/script/artifact-elf.ts",
        "$TURBO_ROOT$/nix/scripts/workspace-config.ts",
        "$TURBO_ROOT$/nix/scripts/control-ledger.ts",
        "$TURBO_ROOT$/nix/scripts/verify-distribution.ts",
        "$TURBO_ROOT$/nix/scripts/probe-distribution.ts",
        "$TURBO_ROOT$/nix/scripts/dependency_measurement.py",
        "$TURBO_ROOT$/apps/cli/script/build.ts",
        "$TURBO_ROOT$/apps/cli/script/targets.ts",
        "$TURBO_ROOT$/apps/desktop/scripts/resource-paths.ts",
        "$TURBO_ROOT$/.github/workflows/test-ci.yml",
        "$TURBO_ROOT$/script/test-guard.ts",
        "$TURBO_ROOT$/packages/core/test/fixture/monolith-inventory.ts",
        "$TURBO_ROOT$/packages/core/test/fixture/tmpdir.ts",
        "$TURBO_ROOT$/script/check-module-boundaries.ts",
        "$TURBO_ROOT$/script/module-architecture.ts",
        "$TURBO_ROOT$/script/module-architecture.json",
        "$TURBO_ROOT$/script/boundary-ledger.json"
      ],
      "outputs": []
    },
    "@orchestra/script#typecheck": {
      "dependsOn": ["transit"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/script/*.ts",
        "$TURBO_ROOT$/nix/scripts/workspace-config.ts",
        "$TURBO_ROOT$/nix/scripts/control-ledger.ts",
        "$TURBO_ROOT$/nix/scripts/verify-distribution.ts",
        "$TURBO_ROOT$/nix/scripts/probe-distribution.ts",
        "$TURBO_ROOT$/apps/desktop/src/main/cli-artifacts.ts",
        "$TURBO_ROOT$/apps/desktop/scripts/resource-paths.ts",
        "$TURBO_ROOT$/packages/core/src/ripgrep/bundle.ts",
        "$TURBO_ROOT$/packages/core/src/ripgrep/release.ts",
        "$TURBO_ROOT$/packages/core/test/fixture/monolith-inventory.ts",
        "$TURBO_ROOT$/packages/core/test/fixture/tmpdir.ts"
      ]
    },
    "@orchestra/codemode#test": {
      "dependsOn": ["transit"],
      "outputs": []
    },
    "@orchestra/effect-drizzle-sqlite#test": {
      "dependsOn": ["transit"],
      "outputs": []
    },
    "@orchestra/http-recorder#test": {
      "dependsOn": ["transit"],
      "outputs": []
    },
    "@orchestra/httpapi-codegen#test": {
      "dependsOn": ["transit"],
      "outputs": []
    },
    "@orchestra/llm#test": {
      "dependsOn": ["transit"],
      "outputs": []
    },
    "@orchestra/maestro-arsenal#test": {
      "dependsOn": ["transit"],
      "outputs": []
    },
    "@orchestra/relay#test": {
      "dependsOn": ["transit"],
      "outputs": []
    },
    "@orchestra/client#test": {
      "dependsOn": ["transit"],
      "outputs": []
    },
    "@orchestra/schema#test": {
      "dependsOn": ["transit"],
      "outputs": []
    },
    "@orchestra/protocol#test": {
      "dependsOn": ["transit"],
      "outputs": []
    },
    "@orchestra/server#test": {
      "dependsOn": ["transit"],
      "outputs": []
    },
    "@orchestra/atlas-boundary#test": {
      "dependsOn": ["transit"],
      "outputs": []
    },
    "@orchestra/sdk-next#test": {
      "dependsOn": ["transit"],
      "outputs": []
    },
    "@orchestra/tui#test": {
      "dependsOn": ["transit"],
      "outputs": []
    },
    "@orchestra/desktop#test": {
      "dependsOn": ["transit"],
      "outputs": []
    }
  }
}
