{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "orchestra",
  "description": "AI-powered development tool",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "bun run --cwd apps/cli src/index.ts",
    "dev:desktop": "bun --cwd apps/desktop dev",
    "dev:web": "bun --cwd apps/web dev",
    "dev:storybook": "bun --cwd apps/storybook storybook",
    "lint": "oxlint",
    "check:godfile": "bun run script/godfile.ts",
    "check:guards": "bun run script/guards/run.ts",
    "check:spawn-imports": "bun run script/check-spawn-imports.ts",
    "check:boundaries": "bun run script/check-module-boundaries.ts",
    "check:ripgrep-pins": "bun run script/check-ripgrep-pins.ts",
    "typecheck": "bun turbo typecheck",
    "upgrade-opentui": "bun run script/upgrade-opentui.ts",
    "postinstall": "bun run --cwd packages/core fix-node-pty",
    "prepare": "husky",
    "random": "echo 'Random script'",
    "translate:app": "bun run packages/app-shell/script/translate-app.ts",
    "test": "echo 'do not run tests from root' && exit 1",
    "omni:build": "cargo build --manifest-path native/omni/Cargo.toml -p hugr-omni-node -p omni-supervisor",
    "test:ci": "bun run script/test-ci.ts"
  },
  "workspaces": {
    "packages": [
      "packages/*",
      "apps/cli",
      "apps/desktop",
      "apps/storybook",
      "apps/web",
      "modules/relay",
      "modules/capability-assets",
      "modules/maestro/arsenal",
      "modules/maestro/coordination",
      "modules/app-dock",
      "modules/janitor",
      "modules/continuity",
      "modules/engine-adapters/claude-code",
      "tooling/httpapi-codegen",
      "tooling/http-recorder",
      "native/omni/bindings/node",
      "native/omni/campaign",
      "modules/atlas/boundary"
    ],
    "catalog": {
      "@effect/opentelemetry": "4.0.6",
      "@effect/platform-node": "4.0.6",
      "@effect/sql-sqlite-bun": "4.0.6",
      "@npmcli/arborist": "10.0.4",
      "@types/bun": "1.4.4",
      "@types/cross-spawn": "6.0.6",
      "@octokit/rest": "22.0.1",
      "@opentui/core": "0.6.8",
      "@opentui/keymap": "0.6.8",
      "@opentui/solid": "0.6.8",
      "@tanstack/solid-virtual": "3.13.49",
      "@shikijs/stream": "4.5.0",
      "ulid": "3.0.2",
      "@kobalte/core": "0.13.14",
      "@corvu/drawer": "0.2.4",
      "@types/luxon": "3.7.6",
      "@types/node": "26.6.5",
      "@types/semver": "7.8.0",
      "@tsconfig/node22": "22.0.6",
      "@tsconfig/bun": "1.0.11",
      "@openauthjs/openauth": "0.4.3",
      "@pierre/diffs": "1.6.1",
      "opentui-spinner": "0.0.7",
      "@solid-primitives/storage": "4.4.0",
      "@tailwindcss/vite": "4.3.3",
      "diff": "9.0.0",
      "dompurify": "3.4.17",
      "drizzle-kit": "1.0.0-rc.5",
      "drizzle-orm": "1.0.0-rc.5",
      "effect": "4.0.6",
      "ai": "7.0.153",
      "cross-spawn": "7.0.6",
      "fuzzysort": "4.0.2",
      "luxon": "3.7.2",
      "marked": "18.1.1",
      "marked-shiki": "1.2.1",
      "remend": "1.4.0",
      "@playwright/test": "1.64.1",
      "semver": "7.8.5",
      "typescript": "7.0.2",
      "@typescript/native-preview": "7.0.0-dev.20260707.2",
      "zod": "4.6.7",
      "remeda": "2.54.1",
      "shiki": "4.5.0",
      "solid-list": "0.3.0",
      "tailwindcss": "4.3.3",
      "vite": "8.3.5",
      "@solidjs/meta": "0.29.4",
      "@solidjs/router": "1.0.0",
      "@sentry/solid": "11.9.0",
      "@sentry/vite-plugin": "11.9.0",
      "solid-js": "1.9.17",
      "solid-sonner": "0.3.2",
      "vite-plugin-solid": "2.11.14",
      "@lydell/node-pty": "1.2.0-beta.18"
    }
  },
  "devDependencies": {
    "@actions/artifact": "6.3.1",
    "@tsconfig/bun": "catalog:",
    "@types/mime-types": "3.0.1",
    "@typescript/native-preview": "catalog:",
    "glob": "13.0.6",
    "husky": "9.1.7",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2005",
    "prettier": "3.9.10",
    "semver": "^7.8.5",
    "turbo": "2.11.10"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "3.0.78",
    "@orchestra/plugin": "workspace:*",
    "@orchestra/script": "workspace:*",
    "@turbo/darwin-64": "2.11.10",
    "heap-snapshot-toolkit": "1.1.3",
    "typescript": "catalog:"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/gustavomhss/hugr-orchestra"
  },
  "license": "MIT",
  "prettier": {
    "semi": false,
    "printWidth": 120
  },
  "trustedDependencies": [
    "esbuild",
    "node-pty",
    "protobufjs",
    "tree-sitter",
    "tree-sitter-bash",
    "tree-sitter-powershell",
    "web-tree-sitter",
    "electron"
  ],
  "overrides": {
    "@ai-sdk/anthropic": "3.0.111",
    "@opentui/core": "catalog:",
    "@opentui/keymap": "catalog:",
    "@opentui/solid": "catalog:",
    "@types/bun": "catalog:",
    "@types/node": "catalog:"
  },
  "patchedDependencies": {
    "@dnd-kit/dom@0.5.0": "patches/@dnd-kit%2Fdom@0.5.0.patch",
    "@npmcli/agent@4.0.2": "patches/@npmcli%2Fagent@4.0.2.patch",
    "@silvia-odwyer/photon-node@0.3.4": "patches/@silvia-odwyer%2Fphoton-node@0.3.4.patch",
    "@standard-community/standard-openapi@0.2.9": "patches/@standard-community%2Fstandard-openapi@0.2.9.patch",
    "solid-js@1.9.10": "patches/solid-js@1.9.10.patch",
    "@ai-sdk/xai@3.0.102": "patches/@ai-sdk%2Fxai@3.0.102.patch",
    "@ai-sdk/mistral@3.0.51": "patches/@ai-sdk%2Fmistral@3.0.51.patch",
    "gcp-metadata@8.1.2": "patches/gcp-metadata@8.1.2.patch",
    "pacote@21.5.0": "patches/pacote@21.5.0.patch",
    "@ai-sdk/google@3.0.73": "patches/@ai-sdk%2Fgoogle@3.0.73.patch",
    "@pierre/trees@1.0.0-beta.4": "patches/@pierre%2Ftrees@1.0.0-beta.4.patch",
    "@modelcontextprotocol/sdk@1.29.0": "patches/@modelcontextprotocol%2Fsdk@1.29.0.patch",
    "effect@4.0.0-beta.83": "patches/effect@4.0.0-beta.83.patch",
    "@tanstack/virtual-core@3.17.3": "patches/@tanstack%2Fvirtual-core@3.17.3.patch",
    "@ai-sdk/openai-compatible@2.0.41": "patches/@ai-sdk%2Fopenai-compatible@2.0.41.patch",
    "@ai-sdk/groq@3.0.31": "patches/@ai-sdk%2Fgroq@3.0.31.patch",
    "@ai-sdk/anthropic@3.0.111": "patches/@ai-sdk%2Fanthropic@3.0.111.patch",
    "@ai-sdk/amazon-bedrock@4.0.166": "patches/@ai-sdk%2Famazon-bedrock@4.0.166.patch",
    "tree-sitter@0.25.0": "patches/tree-sitter@0.25.0.patch",
    "@opentui/core@0.4.5": "patches/@opentui%2Fcore@0.4.5.patch"
  }
}
