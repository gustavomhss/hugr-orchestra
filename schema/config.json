{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/Config.Info",
  "$defs": {
    "PermissionV2.Effect": {
      "type": "string",
      "enum": [
        "allow",
        "deny",
        "ask"
      ]
    },
    "PermissionV2.Rule": {
      "type": "object",
      "properties": {
        "action": {
          "type": "string"
        },
        "resource": {
          "type": "string"
        },
        "effect": {
          "$ref": "#/$defs/PermissionV2.Effect"
        }
      },
      "required": [
        "action",
        "resource",
        "effect"
      ],
      "additionalProperties": false
    },
    "PermissionV2.Ruleset": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/PermissionV2.Rule"
      }
    },
    "ConfigV2.Provider.Request": {
      "type": "object",
      "properties": {
        "headers": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "body": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "ConfigV2.Agent": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "model": {
          "type": "string",
          "$ref": "https://models.dev/model-schema.json#/$defs/Model"
        },
        "variant": {
          "type": "string"
        },
        "request": {
          "$ref": "#/$defs/ConfigV2.Provider.Request"
        },
        "system": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "engine": {
          "type": "string",
          "enum": [
            "orchestra",
            "claude-code"
          ]
        },
        "mode": {
          "type": "string",
          "enum": [
            "subagent",
            "primary",
            "all"
          ]
        },
        "hidden": {
          "type": "boolean"
        },
        "color": {
          "anyOf": [
            {
              "pattern": "^#[0-9a-fA-F]{6}$",
              "type": "string"
            },
            {
              "type": "string",
              "enum": [
                "primary",
                "secondary",
                "accent",
                "success",
                "warning",
                "error",
                "info"
              ]
            }
          ]
        },
        "steps": {
          "exclusiveMinimum": 0,
          "type": "integer",
          "maximum": 9007199254740991
        },
        "disabled": {
          "type": "boolean"
        },
        "permissions": {
          "$ref": "#/$defs/PermissionV2.Ruleset"
        }
      },
      "additionalProperties": false
    },
    "ConfigV2.Watcher": {
      "type": "object",
      "properties": {
        "ignore": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "ConfigV2.Formatter.Entry": {
      "type": "object",
      "properties": {
        "disabled": {
          "type": "boolean"
        },
        "command": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "environment": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "extensions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "ConfigV2.LSP.Server": {
      "type": "object",
      "properties": {
        "command": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "extensions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "disabled": {
          "type": "boolean"
        },
        "env": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "initialization": {
          "type": "object"
        }
      },
      "required": [
        "command"
      ],
      "additionalProperties": false
    },
    "ConfigV2.Attachments.Image": {
      "type": "object",
      "properties": {
        "auto_resize": {
          "type": "boolean"
        },
        "max_width": {
          "exclusiveMinimum": 0,
          "type": "integer",
          "maximum": 9007199254740991
        },
        "max_height": {
          "exclusiveMinimum": 0,
          "type": "integer",
          "maximum": 9007199254740991
        },
        "max_base64_bytes": {
          "exclusiveMinimum": 0,
          "type": "integer",
          "maximum": 9007199254740991
        }
      },
      "additionalProperties": false
    },
    "ConfigV2.Attachments": {
      "type": "object",
      "properties": {
        "image": {
          "$ref": "#/$defs/ConfigV2.Attachments.Image"
        }
      },
      "additionalProperties": false
    },
    "ConfigV2.ToolOutput": {
      "type": "object",
      "properties": {
        "max_lines": {
          "exclusiveMinimum": 0,
          "type": "integer",
          "maximum": 9007199254740991
        },
        "max_bytes": {
          "exclusiveMinimum": 0,
          "type": "integer",
          "maximum": 9007199254740991
        },
        "lean": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "ConfigV2.MCP.Timeout": {
      "type": "object",
      "properties": {
        "startup": {
          "exclusiveMinimum": 0,
          "type": "integer",
          "maximum": 9007199254740991,
          "description": "Maximum time in milliseconds to establish and initialize the MCP server."
        },
        "request": {
          "exclusiveMinimum": 0,
          "type": "integer",
          "maximum": 9007199254740991,
          "description": "Maximum time in milliseconds to wait for each MCP request after initialization."
        }
      },
      "additionalProperties": false
    },
    "ConfigV2.MCP.Local": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "local"
          ]
        },
        "command": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "cwd": {
          "type": "string",
          "description": "Working directory for the MCP server process. Relative paths resolve from the workspace directory."
        },
        "environment": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "disabled": {
          "type": "boolean"
        },
        "timeout": {
          "$ref": "#/$defs/ConfigV2.MCP.Timeout"
        }
      },
      "required": [
        "type",
        "command"
      ],
      "additionalProperties": false
    },
    "ConfigV2.MCP.OAuth": {
      "type": "object",
      "properties": {
        "client_id": {
          "type": "string"
        },
        "client_secret": {
          "type": "string"
        },
        "scope": {
          "type": "string"
        },
        "callback_port": {
          "minimum": 1,
          "maximum": 65535,
          "type": "integer"
        },
        "redirect_uri": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "ConfigV2.MCP.Remote": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "remote"
          ]
        },
        "url": {
          "type": "string"
        },
        "headers": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "oauth": {
          "anyOf": [
            {
              "$ref": "#/$defs/ConfigV2.MCP.OAuth"
            },
            {
              "type": "boolean",
              "enum": [
                false
              ]
            }
          ]
        },
        "disabled": {
          "type": "boolean"
        },
        "timeout": {
          "$ref": "#/$defs/ConfigV2.MCP.Timeout"
        }
      },
      "required": [
        "type",
        "url"
      ],
      "additionalProperties": false
    },
    "ConfigV2.MCP": {
      "type": "object",
      "properties": {
        "timeout": {
          "$ref": "#/$defs/ConfigV2.MCP.Timeout"
        },
        "servers": {
          "type": "object",
          "additionalProperties": {
            "anyOf": [
              {
                "$ref": "#/$defs/ConfigV2.MCP.Local"
              },
              {
                "$ref": "#/$defs/ConfigV2.MCP.Remote"
              }
            ]
          }
        }
      },
      "additionalProperties": false
    },
    "ConfigV2.Compaction.Keep": {
      "type": "object",
      "properties": {
        "tokens": {
          "minimum": 0,
          "type": "integer",
          "maximum": 9007199254740991
        }
      },
      "additionalProperties": false
    },
    "ConfigV2.Compaction": {
      "type": "object",
      "properties": {
        "auto": {
          "type": "boolean"
        },
        "prune": {
          "type": "boolean"
        },
        "keep": {
          "$ref": "#/$defs/ConfigV2.Compaction.Keep"
        },
        "buffer": {
          "minimum": 0,
          "type": "integer",
          "maximum": 9007199254740991
        }
      },
      "additionalProperties": false
    },
    "ConfigV2.Continuity": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Keep long sessions under the context limit with masking and background summaries (default: true)"
        },
        "trigger": {
          "type": "number",
          "description": "Fraction of the model context window at which a background summary runs, between 0 and 0.7 (default: 0.4)"
        }
      },
      "additionalProperties": false
    },
    "ConfigV2.Command": {
      "type": "object",
      "properties": {
        "template": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "agent": {
          "type": "string"
        },
        "model": {
          "type": "string",
          "$ref": "https://models.dev/model-schema.json#/$defs/Model"
        },
        "variant": {
          "type": "string"
        },
        "subtask": {
          "type": "boolean"
        }
      },
      "required": [
        "template"
      ],
      "additionalProperties": false
    },
    "ConfigV2.Reference.Git": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string"
        },
        "branch": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "hidden": {
          "type": "boolean"
        }
      },
      "required": [
        "repository"
      ],
      "additionalProperties": false
    },
    "ConfigV2.Reference.Local": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "hidden": {
          "type": "boolean"
        }
      },
      "required": [
        "path"
      ],
      "additionalProperties": false
    },
    "ConfigV2.Plugin.Entry": {
      "type": "object",
      "properties": {
        "package": {
          "type": "string"
        },
        "options": {
          "type": "object"
        }
      },
      "required": [
        "package"
      ],
      "additionalProperties": false
    },
    "Policy.Effect": {
      "type": "string",
      "enum": [
        "allow",
        "deny"
      ]
    },
    "ConfigV2.Experimental.Policy": {
      "type": "object",
      "properties": {
        "action": {
          "anyOf": [
            {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "provider.use"
                  ]
                }
              ]
            }
          ]
        },
        "effect": {
          "$ref": "#/$defs/Policy.Effect"
        },
        "resource": {
          "type": "string"
        }
      },
      "required": [
        "action",
        "effect",
        "resource"
      ],
      "additionalProperties": false
    },
    "ConfigV2.Experimental": {
      "type": "object",
      "properties": {
        "policies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ConfigV2.Experimental.Policy"
          }
        },
        "primary_tools": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Tools that should only be available to primary agents."
        }
      },
      "additionalProperties": false
    },
    "ConfigV2.Relay.Judge": {
      "type": "object",
      "properties": {
        "backend": {
          "type": "string",
          "enum": [
            "stub",
            "api"
          ],
          "description": "Judge backend for Relay judge controls: the marker stub (default) or the Messages API"
        },
        "model": {
          "type": "string",
          "description": "Model the API judge asks",
          "$ref": "https://models.dev/model-schema.json#/$defs/Model"
        },
        "baseURL": {
          "type": "string",
          "description": "Messages API endpoint; defaults to https://api.anthropic.com"
        },
        "apiKey": {
          "type": "string",
          "description": "API key for the judge endpoint"
        },
        "votes": {
          "exclusiveMinimum": 0,
          "type": "integer",
          "maximum": 9007199254740991,
          "description": "Samples per verdict (default: 1)"
        },
        "maxContext": {
          "exclusiveMinimum": 0,
          "type": "integer",
          "maximum": 9007199254740991,
          "description": "Characters read per context file before truncation (default: 120000)"
        },
        "maxTokens": {
          "exclusiveMinimum": 0,
          "type": "integer",
          "maximum": 9007199254740991,
          "description": "Reply token budget (default: 8192)"
        }
      },
      "additionalProperties": false
    },
    "ConfigV2.Relay": {
      "type": "object",
      "properties": {
        "judge": {
          "$ref": "#/$defs/ConfigV2.Relay.Judge",
          "description": "Relay judge settings"
        }
      },
      "additionalProperties": false
    },
    "ConfigV2.ResearchLimits": {
      "type": "object",
      "properties": {
        "indexer_bytes": {
          "exclusiveMinimum": 0,
          "type": "integer",
          "maximum": 9007199254740991,
          "description": "Memory cap of one code indexer run in bytes (default and maximum: 2 GiB)"
        },
        "probe_bytes": {
          "exclusiveMinimum": 0,
          "type": "integer",
          "maximum": 9007199254740991,
          "description": "Memory cap of one research probe in bytes (default and maximum: 1 GiB)"
        },
        "scratch_bytes": {
          "exclusiveMinimum": 0,
          "type": "integer",
          "maximum": 9007199254740991,
          "description": "Scratch disk of one research probe in bytes (default and maximum: 2 GiB)"
        },
        "index_bytes": {
          "exclusiveMinimum": 0,
          "type": "integer",
          "maximum": 9007199254740991,
          "description": "Disk budget of the code index cache in bytes (default and maximum: 4 GiB)"
        }
      },
      "additionalProperties": false
    },
    "ConfigV2.Research": {
      "type": "object",
      "properties": {
        "limits": {
          "$ref": "#/$defs/ConfigV2.ResearchLimits"
        }
      },
      "additionalProperties": false
    },
    "Config.Maestro": {
      "type": "object",
      "properties": {
        "atlas": {
          "type": "object",
          "properties": {
            "projectID": {
              "minLength": 1,
              "type": "string"
            },
            "directory": {
              "minLength": 1,
              "type": "string"
            },
            "sourceDirectory": {
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "projectID",
            "directory"
          ],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "Provider.AISDK": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "aisdk"
          ]
        },
        "package": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "settings": {
          "type": "object"
        }
      },
      "required": [
        "type",
        "package"
      ],
      "additionalProperties": false
    },
    "Provider.Native": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "native"
          ]
        },
        "url": {
          "type": "string"
        },
        "settings": {
          "type": "object"
        }
      },
      "required": [
        "type",
        "settings"
      ],
      "additionalProperties": false
    },
    "Provider.Api": {
      "anyOf": [
        {
          "$ref": "#/$defs/Provider.AISDK"
        },
        {
          "$ref": "#/$defs/Provider.Native"
        }
      ]
    },
    "Model.Capabilities": {
      "type": "object",
      "properties": {
        "tools": {
          "type": "boolean"
        },
        "input": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "output": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "tools",
        "input",
        "output"
      ],
      "additionalProperties": false
    },
    "ConfigV2.Model.Cost.Cache": {
      "type": "object",
      "properties": {
        "read": {
          "type": "number"
        },
        "write": {
          "type": "number"
        }
      },
      "additionalProperties": false
    },
    "ConfigV2.Model.Cost": {
      "type": "object",
      "properties": {
        "tier": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "context"
              ]
            },
            "size": {
              "type": "integer",
              "maximum": 9007199254740991
            }
          },
          "required": [
            "type",
            "size"
          ],
          "additionalProperties": false
        },
        "input": {
          "type": "number"
        },
        "output": {
          "type": "number"
        },
        "cache": {
          "$ref": "#/$defs/ConfigV2.Model.Cost.Cache"
        }
      },
      "required": [
        "input",
        "output"
      ],
      "additionalProperties": false
    },
    "ConfigV2.Model.Limit": {
      "type": "object",
      "properties": {
        "context": {
          "type": "integer",
          "maximum": 9007199254740991
        },
        "input": {
          "type": "integer",
          "maximum": 9007199254740991
        },
        "output": {
          "type": "integer",
          "maximum": 9007199254740991
        }
      },
      "additionalProperties": false
    },
    "ConfigV2.Model": {
      "type": "object",
      "properties": {
        "family": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "api": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "type": {
                  "type": "string",
                  "enum": [
                    "aisdk"
                  ]
                },
                "package": {
                  "type": "string"
                },
                "url": {
                  "type": "string"
                },
                "settings": {
                  "type": "object"
                }
              },
              "required": [
                "type",
                "package"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "type": {
                  "type": "string",
                  "enum": [
                    "native"
                  ]
                },
                "url": {
                  "type": "string"
                },
                "settings": {
                  "type": "object"
                }
              },
              "required": [
                "type",
                "settings"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                }
              },
              "required": [
                "id"
              ],
              "additionalProperties": false
            }
          ]
        },
        "capabilities": {
          "$ref": "#/$defs/Model.Capabilities"
        },
        "request": {
          "type": "object",
          "properties": {
            "headers": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "body": {
              "type": "object"
            },
            "variant": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "variants": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "headers": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "body": {
                "type": "object"
              }
            },
            "required": [
              "id"
            ],
            "additionalProperties": false
          }
        },
        "cost": {
          "anyOf": [
            {
              "$ref": "#/$defs/ConfigV2.Model.Cost"
            },
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/ConfigV2.Model.Cost"
              }
            }
          ]
        },
        "disabled": {
          "type": "boolean"
        },
        "limit": {
          "$ref": "#/$defs/ConfigV2.Model.Limit"
        }
      },
      "additionalProperties": false
    },
    "ConfigV2.Provider": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "env": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "api": {
          "$ref": "#/$defs/Provider.Api"
        },
        "request": {
          "$ref": "#/$defs/ConfigV2.Provider.Request"
        },
        "models": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/ConfigV2.Model"
          }
        }
      },
      "additionalProperties": false
    },
    "Config.Info": {
      "type": "object",
      "properties": {
        "$schema": {
          "type": "string",
          "description": "JSON schema reference for configuration validation"
        },
        "shell": {
          "type": "string",
          "description": "Default shell to use for terminal and shell tool execution"
        },
        "model": {
          "type": "string",
          "description": "Default model to use when no session or agent model is selected",
          "$ref": "https://models.dev/model-schema.json#/$defs/Model"
        },
        "default_agent": {
          "type": "string",
          "description": "Default primary agent to use when no session agent is selected"
        },
        "autoupdate": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "string",
              "enum": [
                "notify"
              ]
            }
          ],
          "description": "Automatically update or notify when a new version is available"
        },
        "username": {
          "type": "string",
          "description": "Username displayed in conversations and used for telemetry identity"
        },
        "permissions": {
          "$ref": "#/$defs/PermissionV2.Ruleset",
          "description": "Ordered tool permission rules applied to agent tool use"
        },
        "agents": {
          "type": "object",
          "additionalProperties": {
