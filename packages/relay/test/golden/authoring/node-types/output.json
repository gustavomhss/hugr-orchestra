{
  "workflow": [
    {
      "type": "relay.startTrigger",
      "label": "Workflow start",
      "inputs": 0,
      "outputs": [
        "main"
      ],
      "maximum": 1,
      "parameters": [
        {
          "name": "relayBrief",
          "label": "Workflow objective",
          "type": "text",
          "default": ""
        },
        {
          "name": "relayRetryBudget",
          "label": "Fixes allowed per step",
          "type": "number",
          "default": 3,
          "minimum": 0,
          "maximum": 99
        }
      ]
    },
    {
      "type": "relay.execute",
      "label": "Run task",
      "inputs": 1,
      "outputs": [
        "main"
      ],
      "parameters": [
        {
          "name": "instructions",
          "label": "Instructions",
          "type": "text",
          "default": ""
        },
        {
          "name": "skill",
          "label": "Skill",
          "type": "skill",
          "default": ""
        },
        {
          "name": "skillMode",
          "label": "How to use the skill",
          "type": "options",
          "default": "combine",
          "options": [
            {
              "value": "combine",
              "label": "Skill plus instructions"
            },
            {
              "value": "replace",
              "label": "Skill replaces instructions"
            }
          ]
        },
        {
          "name": "checklist",
          "label": "Criteria to advance",
          "type": "json",
          "default": "[]"
        }
      ]
    },
    {
      "type": "relay.gate",
      "label": "Check criteria",
      "inputs": 1,
      "outputs": [
        "main"
      ],
      "parameters": [
        {
          "name": "instructions",
          "label": "Instructions",
          "type": "text",
          "default": ""
        },
        {
          "name": "skill",
          "label": "Skill",
          "type": "skill",
          "default": ""
        },
        {
          "name": "skillMode",
          "label": "How to use the skill",
          "type": "options",
          "default": "combine",
          "options": [
            {
              "value": "combine",
              "label": "Skill plus instructions"
            },
            {
              "value": "replace",
              "label": "Skill replaces instructions"
            }
          ]
        },
        {
          "name": "checklist",
          "label": "Criteria to advance",
          "type": "json",
          "default": "[]"
        }
      ]
    },
    {
      "type": "relay.review",
      "label": "Review change",
      "inputs": 1,
      "outputs": [
        "main"
      ],
      "parameters": [
        {
          "name": "instructions",
          "label": "Instructions",
          "type": "text",
          "default": ""
        },
        {
          "name": "skill",
          "label": "Skill",
          "type": "skill",
          "default": ""
        },
        {
          "name": "skillMode",
          "label": "How to use the skill",
          "type": "options",
          "default": "combine",
          "options": [
            {
              "value": "combine",
              "label": "Skill plus instructions"
            },
            {
              "value": "replace",
              "label": "Skill replaces instructions"
            }
          ]
        },
        {
          "name": "checklist",
          "label": "Criteria to advance",
          "type": "json",
          "default": "[]"
        }
      ]
    },
    {
      "type": "relay.inject",
      "label": "Provide context",
      "inputs": 1,
      "outputs": [
        "main"
      ],
      "parameters": [
        {
          "name": "instructions",
          "label": "Instructions",
          "type": "text",
          "default": ""
        },
        {
          "name": "skill",
          "label": "Skill",
