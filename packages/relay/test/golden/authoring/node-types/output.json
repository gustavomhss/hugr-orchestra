              "value": "combine",
              "label": "Skill plus instructions"
            },
            {
              "value": "replace",
              "label": "Skill replaces instructions"
            }
          ]
        },
        {
          "name": "checklist",
          "label": "Criteria to advance",
          "type": "json",
          "default": "[]"
        },
        {
          "name": "text",
          "label": "Context",
          "type": "text",
          "default": ""
