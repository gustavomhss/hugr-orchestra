#!/usr/bin/env bash
# relay-note — append ONE entry to an arm's hash chain, through the shared gate core.
#
# The daemon's wait channel (V10) has to write to the same ledger the hook writes, and the hash
# chain's format lives in exactly one place (lib/relay-gate.sh `relay_chain_append`). Rather than
# reimplement prev/seq/mac in Python and let two encodings drift, the daemon shells out to this.
#
# Usage: relay-note <ledger.jsonl> <sprint.json> <compact-json-body>
#
# Locking used to live here, on the argument that an arm has one sequential writer and the daemon only
# writes while the agent is parked inside a tool call. That argument is still true and still not
# enough — a live run raced two `relay-gate` processes over one state dir and forked the chain. The
# lock moved into `relay_chain_append` itself, so EVERY writer gets it rather than the one that
# remembered to ask.
set -euo pipefail
[ $# -eq 3 ] || { echo "usage: relay-note <ledger> <sprint> <json-body>" >&2; exit 2; }
LEDGER="$1"; SPRINT="$2"; BODY="$3"
HOOK_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
. "$HOOK_DIR/../lib/relay-gate.sh"

relay_chain_append "$BODY"
