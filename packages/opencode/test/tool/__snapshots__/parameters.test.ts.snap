  ],
  "type": "object",
}
`;

exports[`tool parameters JSON Schema (wire shape) read 1`] = `
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "filePath": {
      "description": "The absolute path to the file or directory to read",
      "type": "string",
    },
    "limit": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "minimum": -9007199254740991,
          "type": "integer",
        },
        {
          "type": "string",
        },
      ],
      "description": "Maximum number of lines to read (defaults to 2000)",
    },
    "offset": {
      "anyOf": [
        {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991,
              "minimum": -9007199254740991,
              "type": "integer",
            },
            {
              "exclusiveMaximum": 0,
              "maximum": 9007199254740991,
              "minimum": -9007199254740991,
              "type": "integer",
            },
          ],
        },
        {
          "type": "string",
        },
      ],
      "description": "Line number to start reading from (1-indexed). Negative values read from end (for example, -3 reads last 3 lines).",
    },
  },
  "required": [
    "filePath",
  ],
  "type": "object",
}
`;

