exports[`tool parameters JSON Schema (wire shape) task 1`] = `
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "authorizationID": {
      "description": "AuthorizationGranted ID for current team dispatch.",
      "type": "string",
    },
    "background": {
      "description": "Run the agent in the background. You will be notified when it completes. DO NOT sleep, poll, or proactively check on its progress",
      "type": "boolean",
    },
    "command": {
      "description": "The command that triggered this task",
      "type": "string",
    },
    "description": {
      "description": "The short label the user sees for this task (3-5 words)",
      "type": "string",
    },
    "governed": {
      "description": "Exact approval binding required only for an explicit governed Task.",
      "properties": {
        "approvalMessageID": {
          "type": "string",
        },
        "contextHash": {
          "type": "string",
        },
        "memberID": {
          "type": "string",
        },
        "planRevisionID": {
          "type": "string",
        },
        "policyHash": {
          "type": "string",
        },
        "projectID": {
          "type": "string",
        },
        "revisionHash": {
          "type": "string",
        },
        "sessionID": {
          "type": "string",
        },
        "taskHash": {
          "type": "string",
        },
        "validationHash": {
          "type": "string",
        },
        "validationRecordID": {
          "type": "string",
        },
      },
      "required": [
        "sessionID",
        "projectID",
        "memberID",
        "approvalMessageID",
        "planRevisionID",
        "revisionHash",
        "validationRecordID",
        "validationHash",
        "contextHash",
        "policyHash",
        "taskHash",
      ],
      "type": "object",
    },
    "model": {
      "description": "Run the subagent on a specific model as 'providerID/modelID' (e.g. 'openrouter/deepseek/deepseek-chat', 'groq/llama-3.3-70b-versatile'). Overrides the subagent's configured model and the parent session model. The provider part also selects credentials: OAuth subscriptions (Claude Max, ChatGPT) and API keys resolve per providerID at run time — use a custom provider alias in opencode.json to pin a second key for the same backend.",
      "type": "string",
    },
    "prompt": {
      "description": "The task for the agent to perform",
      "type": "string",
    },
    "subagent_type": {
      "description": "The type of specialized agent to use for this task",
      "type": "string",
    },
    "task_id": {
      "description": "Set only to continue an earlier task: the exact task_id that call returned. The agent resumes with its earlier context. An unknown id fails.",
      "type": "string",
    },
  },
  "required": [
    "description",
    "prompt",
    "subagent_type",
  ],
  "type": "object",
}
`;

