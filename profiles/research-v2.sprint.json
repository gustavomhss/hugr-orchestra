{
  "brief": "research-v2 v1.0.0 \u2014 Research v2 \u2014 explore tiered, analyze verified, report audit\u00e1vel. 100% OSS, compos\u00e1vel via library, n8n-ready placeholder.",
  "gen": 0,
  "retry_budget": 5,
  "macros": [
    {
      "id": "explore",
      "title": "Explore Codebase"
    },
    {
      "id": "analyze",
      "title": "Deep Analysis"
    },
    {
      "id": "report",
      "title": "Report Findings"
    }
  ],
  "work_packages": [
    {
      "id": "explore.inject",
      "macro": "explore",
      "kind": "inject",
      "title": "Inject Context",
      "instructions": "Inject codebase overview + library skill tdd",
      "file": "tdd",
      "checklist": []
    },
    {
      "id": "explore.map",
      "macro": "explore",
      "kind": "execute",
      "title": "Map Structure",
      "instructions": "BFS file org + dependencies, tiered",
      "checklist": [
        {
          "id": "map-written",
          "assert": "this state wrote the structure map",
          "cmd": "test -s ${research_dir}/map.json",
          "origin": "pe-profile:research-v2@1.0.0"
        }
      ]
    },
    {
      "id": "explore.patterns",
      "macro": "explore",
      "kind": "execute",
      "title": "Identify Patterns",
      "instructions": "Coding patterns, conventions, tiers per file",
      "checklist": [
        {
          "id": "patterns-written",
          "assert": "this state wrote the pattern register",
          "cmd": "test -s ${research_dir}/patterns.json",
          "origin": "pe-profile:research-v2@1.0.0"
        }
      ]
    },
    {
      "id": "explore.checklist",
      "macro": "explore",
      "kind": "gate",
      "title": "Checklist Gate",
      "instructions": "",
      "checklist": [
        {
          "id": "structure_mapped",
          "assert": "structure_mapped",
          "cmd": "jq -e '(.files | length) > 0 and all(.files[]; .path and .role and .tier)' ${research_dir}/map.json >/dev/null",
          "origin": "pe-profile:research-v2@1.0.0"
        },
        {
          "id": "patterns_identified",
          "assert": "patterns_identified",
          "cmd": "jq -e '(.patterns | length) > 0 and all(.patterns[]; (.evidence | length) > 0)' ${research_dir}/patterns.json >/dev/null",
          "origin": "pe-profile:research-v2@1.0.0"
        }
      ]
    },
    {
      "id": "analyze.inject",
      "macro": "analyze",
      "kind": "inject",
      "title": "Inject Context",
      "instructions": "Inject exploration findings + impact entries",
      "file": "",
      "text": "Use tiered impact entries from explore phase",
      "checklist": []
    },
    {
      "id": "analyze.deep_dive",
      "macro": "analyze",
      "kind": "execute",
      "title": "Deep Dive",
      "instructions": "Analyze target areas, coletar evid\u00eancia por comando",
      "checklist": [
        {
          "id": "analysis-written",
          "assert": "this state wrote the analysis",
          "cmd": "test -s ${research_dir}/analysis.json",
          "origin": "pe-profile:research-v2@1.0.0"
        }
      ]
    },
    {
      "id": "analyze.review",
      "macro": "analyze",
      "kind": "review",
      "title": "Self-Review",
      "instructions": "Verify completeness via verify",
      "checklist": [
        {
          "id": "analyze-review-verdict",
          "assert": "the reviewer returned APPROVE",
          "cmd": "test \"$(jq -r .verdict ${research_dir}/review-analyze.json)\" = APPROVE",
          "origin": "pe-profile:research-v2@1.0.0"
        },
        {
          "id": "analyze-review-is-substantive",
          "assert": "the review carries at least 200 characters",
          "cmd": "test \"$(jq -r '.findings // \"\" | length' ${research_dir}/review-analyze.json)\" -ge 200",
          "origin": "pe-profile:research-v2@1.0.0"
        },
        {
          "id": "analyze-review-engages-with-the-diff",
          "context": [
            "${research_dir}/review-analyze.json"
          ],
          "judge": "Does this review describe the change in the diff? FAIL if it makes claims the diff does not support, if it is generic enough to apply to any change, or if it omits a material part of the diff.",
          "diff": true,
          "blocking": true,
          "origin": "pe-profile:research-v2@1.0.0"
        }
      ]
    },
    {
      "id": "analyze.checklist",
      "macro": "analyze",
      "kind": "gate",
      "title": "Checklist Gate",
      "instructions": "",
      "checklist": [
        {
          "id": "analysis_complete",
          "assert": "analysis_complete",
          "cmd": "jq -e '(.areas | length) > 0 and all(.areas[]; (.findings | length) > 0)' ${research_dir}/analysis.json >/dev/null",
          "origin": "pe-profile:research-v2@1.0.0"
        },
        {
          "id": "findings_documented",
          "assert": "findings_documented",
          "cmd": "${research_tools}/replay-evidence ${research_dir}/analysis.json --cwd ${repo_root}",
          "origin": "pe-profile:research-v2@1.0.0"
        }
      ]
    },
    {
      "id": "report.inject",
      "macro": "report",
      "kind": "inject",
      "title": "Inject Context",
      "instructions": "Inject analysis results",
      "file": "",
      "text": "The analysis findings and their replayed evidence are the only admissible input to the report.",
      "checklist": []
    },
    {
      "id": "report.synthesize",
      "macro": "report",
      "kind": "execute",
      "title": "Synthesize",
      "instructions": "Combine findings, custo por macro via artifact offload",
      "checklist": [
        {
          "id": "report-written-here",
          "assert": "this state wrote the report",
          "cmd": "test -s ${research_dir}/report.md",
          "origin": "pe-profile:research-v2@1.0.0"
        }
      ]
    },
    {
      "id": "report.review",
      "macro": "report",
      "kind": "review",
      "title": "Review Report",
      "instructions": "Review report quality + output_contract shape",
      "checklist": [
        {
          "id": "report-review-verdict",
          "assert": "the reviewer returned APPROVE",
          "cmd": "test \"$(jq -r .verdict ${research_dir}/review-report.json)\" = APPROVE",
          "origin": "pe-profile:research-v2@1.0.0"
        },
        {
          "id": "report-review-is-substantive",
          "assert": "the review carries at least 200 characters",
          "cmd": "test \"$(jq -r '.findings // \"\" | length' ${research_dir}/review-report.json)\" -ge 200",
          "origin": "pe-profile:research-v2@1.0.0"
        },
        {
          "id": "report-review-engages-with-the-diff",
          "context": [
            "${research_dir}/review-report.json"
          ],
          "judge": "Does this review describe the change in the diff? FAIL if it makes claims the diff does not support, if it is generic enough to apply to any change, or if it omits a material part of the diff.",
          "diff": true,
          "blocking": true,
          "origin": "pe-profile:research-v2@1.0.0"
        }
      ]
    },
    {
      "id": "report.checklist",
      "macro": "report",
      "kind": "gate",
      "title": "Gate \u2014 Attested",
      "instructions": "",
      "checklist": [
        {
          "id": "report_written",
          "assert": "report_written",
          "cmd": "test \"$(wc -w < ${research_dir}/report.md)\" -ge 200 && grep -q '^## Conclusions' ${research_dir}/report.md",
          "origin": "pe-profile:research-v2@1.0.0"
        },
        {
          "id": "conclusions_clear",
          "assert": "conclusions_clear",
          "cmd": "${research_tools}/cite-check ${research_dir}/report.md ${research_dir}/analysis.json",
          "origin": "pe-profile:research-v2@1.0.0"
        }
      ]
    }
  ]
}
