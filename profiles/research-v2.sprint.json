        {
          "id": "command_evidence_replays",
          "assert": "command_evidence_replays",
          "cmd": "${research_tools}/../criterion ${research_tools}/research-check evidence command_evidence_replays --research-dir ${research_dir} --repo-root ${repo_root}",
          "origin": "pe-profile:research-v2@2.0.0"
