{
  "brief": "research-v2 v2.0.0 \u2014 Research \u2014 derived from ACH (competing hypotheses, diagnosticity), GRADE (certainty as arithmetic), the Admiralty code (source reliability apart from item credibility), PRISMA-S (a search someone else could run), grounded theory (constant comparison, memoing, saturation) and Zettelkasten atomicity",
  "gen": 0,
  "retry_budget": 5,
  "macros": [
    {
      "id": "question",
      "title": "Bind the question"
    },
    {
      "id": "survey",
      "title": "Survey the ground"
    },
    {
      "id": "evidence",
      "title": "Establish the findings"
    },
    {
      "id": "contest",
      "title": "Contest the findings"
    },
    {
      "id": "synthesis",
      "title": "Conclude"
    },
    {
      "id": "report",
      "title": "Write the report"
    }
  ],
  "work_packages": [
    {
      "id": "question.frame",
      "macro": "question",
      "kind": "execute",
      "title": "Frame",
      "instructions": "State the question and the setting; declare each answer criterion as A-<n>; list the exclusions; record the prior belief; enumerate the competing hypotheses H-<n> BEFORE weighing evidence (ACH step 1)",
      "checklist": [
        {
          "id": "question-written",
          "assert": "this state wrote the bound question",
          "cmd": "test -s ${research_dir}/question.json",
          "origin": "pe-profile:research-v2@2.0.0"
        }
      ]
    },
    {
      "id": "question.gate",
      "macro": "question",
      "kind": "gate",
      "title": "Question gate",
      "instructions": "Tier 2 validates exit criteria",
      "checklist": [
        {
          "id": "question_stated",
          "assert": "question_stated",
          "cmd": "${research_tools}/../criterion ${research_tools}/research-check question question_stated --research-dir ${research_dir} --repo-root ${repo_root}",
          "origin": "pe-profile:research-v2@2.0.0"
        },
        {
          "id": "answer_shape_declared",
          "assert": "answer_shape_declared",
          "cmd": "${research_tools}/../criterion ${research_tools}/research-check question answer_shape_declared --research-dir ${research_dir} --repo-root ${repo_root}",
          "origin": "pe-profile:research-v2@2.0.0"
        },
        {
          "id": "out_of_scope_declared",
          "assert": "out_of_scope_declared",
          "cmd": "${research_tools}/../criterion ${research_tools}/research-check question out_of_scope_declared --research-dir ${research_dir} --repo-root ${repo_root}",
          "origin": "pe-profile:research-v2@2.0.0"
        },
        {
          "id": "competing_hypotheses_enumerated",
          "assert": "competing_hypotheses_enumerated",
          "cmd": "${research_tools}/../criterion ${research_tools}/research-check question competing_hypotheses_enumerated --research-dir ${research_dir} --repo-root ${repo_root}",
          "origin": "pe-profile:research-v2@2.0.0"
        }
      ]
    },
    {
      "id": "survey.gather",
      "macro": "survey",
      "kind": "execute",
      "title": "Gather",
      "instructions": "Register and freeze every source with an Admiralty reliability grade; record each search so someone else could run it; record what was found and excluded, and what was never looked at; declare the stop rule",
      "checklist": [
        {
          "id": "sources-written",
          "assert": "this state wrote the source register",
          "cmd": "test -s ${research_dir}/sources.json",
          "origin": "pe-profile:research-v2@2.0.0"
        }
      ]
    },
    {
      "id": "survey.gate",
      "macro": "survey",
      "kind": "gate",
      "title": "Survey gate",
      "instructions": "Tier 2 validates exit criteria",
      "checklist": [
        {
          "id": "sources_registered",
          "assert": "sources_registered",
          "cmd": "${research_tools}/../criterion ${research_tools}/research-check survey sources_registered --research-dir ${research_dir} --repo-root ${repo_root}",
          "origin": "pe-profile:research-v2@2.0.0"
        },
        {
          "id": "source_reliability_rated",
          "assert": "source_reliability_rated",
          "cmd": "${research_tools}/../criterion ${research_tools}/research-check survey source_reliability_rated --research-dir ${research_dir} --repo-root ${repo_root}",
          "origin": "pe-profile:research-v2@2.0.0"
        },
        {
          "id": "search_record_is_reproducible",
          "assert": "search_record_is_reproducible",
          "cmd": "${research_tools}/../criterion ${research_tools}/research-check survey search_record_is_reproducible --research-dir ${research_dir} --repo-root ${repo_root}",
          "origin": "pe-profile:research-v2@2.0.0"
        },
        {
          "id": "excluded_sources_recorded",
          "assert": "excluded_sources_recorded",
          "cmd": "${research_tools}/../criterion ${research_tools}/research-check survey excluded_sources_recorded --research-dir ${research_dir} --repo-root ${repo_root}",
          "origin": "pe-profile:research-v2@2.0.0"
        },
        {
          "id": "not_searched_declared",
          "assert": "not_searched_declared",
          "cmd": "${research_tools}/../criterion ${research_tools}/research-check survey not_searched_declared --research-dir ${research_dir} --repo-root ${repo_root}",
          "origin": "pe-profile:research-v2@2.0.0"
        },
        {
          "id": "retrieved_sources_are_snapshotted",
          "assert": "retrieved_sources_are_snapshotted",
          "cmd": "${research_tools}/../criterion ${research_tools}/research-check survey retrieved_sources_are_snapshotted --research-dir ${research_dir} --repo-root ${repo_root}",
          "origin": "pe-profile:research-v2@2.0.0"
        },
        {
          "id": "saturation_is_declared",
          "assert": "saturation_is_declared",
          "cmd": "${research_tools}/../criterion ${research_tools}/research-check survey saturation_is_declared --research-dir ${research_dir} --repo-root ${repo_root}",
          "origin": "pe-profile:research-v2@2.0.0"
        }
      ]
    },
    {
      "id": "evidence.establish",
      "macro": "evidence",
      "kind": "execute",
      "title": "Establish",
      "instructions": "Record each finding as it is found: one claim, evidence that resolves to a frozen source, an Admiralty credibility grade, what would refute it, and where it sits against the corpus already held. Memo as you go",
      "checklist": [
        {
          "id": "findings-written",
          "assert": "this state wrote the findings register",
          "cmd": "test -s ${research_dir}/findings.json",
          "origin": "pe-profile:research-v2@2.0.0"
        },
        {
          "id": "memos-written",
          "assert": "this state wrote analytic memos as it worked",
          "cmd": "test -s ${research_dir}/memos.json",
          "origin": "pe-profile:research-v2@2.0.0"
        }
      ]
    },
    {
      "id": "evidence.cold_review",
      "macro": "evidence",
      "kind": "review",
      "title": "Cold review",
      "instructions": "Apply GROUNDED (the evidence supports the claim), TOOTHED (the falsifier could actually be observed) and ATOMIC (one claim per finding \u2014 this one is judgment, not machine-checkable); verdict APPROVE or FIXES-NEEDED",
      "checklist": [
        {
          "id": "evidence-review-verdict",
          "assert": "the cold reviewer returned APPROVE",
          "cmd": "test \"$(jq -r .verdict ${research_dir}/review-evidence.json)\" = APPROVE",
          "origin": "pe-profile:research-v2@2.0.0"
        },
        {
          "id": "evidence-review-is-substantive",
          "assert": "the review carries at least 250 characters of findings",
          "cmd": "test \"$(jq -r '.findings // \"\" | length' ${research_dir}/review-evidence.json)\" -ge 250",
          "origin": "pe-profile:research-v2@2.0.0"
        },
        {
          "id": "evidence-review-engages-with-the-diff",
          "context": [
            "${research_dir}/review-evidence.json"
          ],
          "paths": [
            "${research_dir}/findings.json"
          ],
          "judge": "Does this review apply GROUNDED (the evidence really supports the claim), TOOTHED (the falsifier is a concrete observation) and ATOMIC (one claim per finding) to the findings in the diff, by id? FAIL if it approves or rejects without naming specific items from the diff, if it makes a claim the diff does not support, if it is generic enough to apply to any artifact of this kind, or if it leaves part of the diff unjudged. Judge the review's ENGAGEMENT with the diff, not its verdict: a well-supported FIXES-NEEDED that names specific items and checks them against the diff SATISFIES this criterion, and a glowing APPROVE that names nothing does not.",
          "diff": true,
          "blocking": true,
          "origin": "pe-profile:research-v2@2.0.0"
        }
      ]
    },
    {
      "id": "evidence.gate",
      "macro": "evidence",
      "kind": "gate",
      "title": "Evidence gate",
      "instructions": "Tier 2 validates exit criteria",
      "checklist": [
