#!/usr/bin/env python3
"""cite-check — every conclusion in a report must cite a finding that exists.

"Conclusions are clear" is judgment and this does not claim to measure it. What it measures is the
half that is computable and that carries most of the weight: a conclusion citing no finding is not a
conclusion, it is an assertion, and a conclusion citing a finding that does not exist is worse.

A report's `## Conclusions` section is read as a bullet list. Each bullet must name at least one
finding, by the claim text or by an explicit `[F-n]` index into the analysis.

Usage: cite-check <report.md> <analysis.json>
Exit:  0 every conclusion cites a real finding · 1 otherwise · 2 usage/IO error
"""
import json
import re
import sys


def main(argv):
    if len(argv) != 2:
        print("usage: cite-check <report.md> <analysis.json>", file=sys.stderr)
        return 2
    try:
        report = open(argv[0]).read()
        doc = json.load(open(argv[1]))
    except (OSError, ValueError) as e:
        print(f"cite-check: {e}", file=sys.stderr)
        return 2

    claims = [str(f.get("claim", "")).strip()
              for area in (doc.get("areas") or []) for f in (area.get("findings") or [])]
    claims = [c for c in claims if c]
    if not claims:
        print("cite-check: the analysis records no findings to cite", file=sys.stderr)
        return 1

    m = re.search(r"^##\s+Conclusions\s*$(.*?)(?=^##\s|\Z)", report, re.M | re.S)
    if not m:
        print("cite-check: the report has no '## Conclusions' section", file=sys.stderr)
        return 1
    bullets = [b.strip() for b in re.findall(r"^\s*[-*]\s+(.+)$", m.group(1), re.M)]
    if not bullets:
        print("cite-check: the Conclusions section lists nothing", file=sys.stderr)
        return 1

    # A citation is an explicit [F-n] index, or a substantial verbatim span of a claim — verbatim
    # because a paraphrase is exactly where a conclusion drifts from what the evidence supports.
    bad = []
    for b in bullets:
        idx = [int(n) for n in re.findall(r"\[F-(\d+)\]", b)]
        if idx and all(1 <= i <= len(claims) for i in idx):
            continue
        if any(c[:40].lower() in b.lower() for c in claims if len(c) >= 12):
            continue
        bad.append(b[:80])
    if bad:
        print(f"cite-check: {len(bad)} of {len(bullets)} conclusions cite no finding:", file=sys.stderr)
        for b in bad:
            print(f"  - {b}", file=sys.stderr)
        return 1
    print(f"{len(bullets)} conclusions, every one citing a recorded finding")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
