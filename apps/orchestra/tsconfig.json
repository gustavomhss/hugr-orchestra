{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@tsconfig/bun/tsconfig.json",
  "exclude": ["node_modules", "dist", "test/research/fixtures/index-repo", "test/research/fixtures/probe-repo"],
  "include": ["**/*", "../../.github/scripts/archie-host-*.ts"],
  "compilerOptions": {
    "jsx": "preserve",
    "jsxImportSource": "@opentui/solid",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": [],
    "noUncheckedIndexedAccess": false,
    "customConditions": ["browser"],
    "paths": {
      "@/*": ["./src/*"],
      "@test/*": ["./test/*"]
    }
  },
  // The app-shell tests reach app-shell source by relative path (ledger R5). This reference resolves
  // those imports against app-shell's declarations, so the app-shell's own "@/" alias never lands on
  // this package's paths.
  "references": [{ "path": "../../packages/app-shell" }]
}
