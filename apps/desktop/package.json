{
  "name": "@orchestra/desktop",
  "private": true,
  "version": "1.18.27",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/gustavomhss/hugr-orchestra",
  "bugs": "https://github.com/gustavomhss/hugr-orchestra/issues",
  "author": {
    "name": "Orchestra"
  },
  "scripts": {
    "linux": "bun scripts/linux-workspace.ts",
    "typecheck": "tsgo -b",
    "test": "bun test && node --experimental-strip-types --test \"src/**/*.node.test.ts\"",
    "test:app-dock:e2e": "bun run src/main/app-dock-security.test.ts",
    "test:app-dock:tools": "bun run src/main/app-dock-tools.test.ts",
    "test:app-dock:rpc": "bun run src/main/app-dock-rpc.test.ts",
    "test:app-dock:live": "bun run src/main/app-dock-live.test.ts",
    "test:app-dock:youtube": "bun run src/main/app-dock-youtube.test.ts",
    "predev": "bun ./scripts/predev.ts",
    "install-electron": "bun ./scripts/install-electron.ts",
    "dev": "electron-vite dev",
    "prebuild": "bun ./scripts/prebuild.ts",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "package": "electron-builder --config electron-builder.config.ts",
    "package:mac": "electron-builder --mac --config electron-builder.config.ts",
    "package:win": "electron-builder --win --config electron-builder.config.ts",
    "package:linux": "electron-builder --linux --config electron-builder.config.ts"
  },
  "main": "./out/main/index.js",
  "dependencies": {
    "@orchestra/core": "workspace:*",
    "hugr-omni": "workspace:*",
    "@zip.js/zip.js": "2.24.0",
    "effect": "catalog:",
    "electron-context-menu": "5.1.0",
    "electron-log": "^5",
    "electron-store": "12.0.0",
    "electron-updater": "6.8.11",
    "electron-window-state": "^5.0.3",
    "drizzle-orm": "catalog:"
  },
  "devDependencies": {
    "@actions/artifact": "6.3.1",
    "@lydell/node-pty": "catalog:",
    "@orchestra/app": "workspace:*",
    "@orchestra/app-dock": "workspace:*",
    "@orchestra/omni-campaign": "workspace:*",
    "@orchestra/plugin": "workspace:*",
    "@orchestra/schema": "workspace:*",
    "@orchestra/script": "workspace:*",
    "@orchestra/ui": "workspace:*",
    "@sentry/solid": "catalog:",
    "@sentry/vite-plugin": "catalog:",
    "@solid-primitives/i18n": "2.2.1",
    "@solid-primitives/storage": "catalog:",
    "@solidjs/meta": "catalog:",
    "@solidjs/router": "1.0.0",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "@typescript/native-preview": "catalog:",
    "@valibot/to-json-schema": "1.8.0",
    "electron": "45.0.0",
    "electron-builder": "26.18.0",
    "electron-vite": "^6",
    "solid-js": "catalog:",
    "sury": "11.0.0",
    "typescript": "~7.0.2",
    "vite": "catalog:",
    "zod-openapi": "6.0.2"
  },
  "optionalDependencies": {
    "@lydell/node-pty-darwin-arm64": "1.2.0-beta.15",
    "@lydell/node-pty-darwin-x64": "1.2.0-beta.15",
    "@lydell/node-pty-linux-arm64": "1.2.0-beta.15",
    "@lydell/node-pty-linux-x64": "1.2.0-beta.15",
    "@lydell/node-pty-win32-arm64": "1.2.0-beta.15",
    "@lydell/node-pty-win32-x64": "1.2.0-beta.15",
    "@parcel/watcher-darwin-arm64": "2.6.0",
    "@parcel/watcher-darwin-x64": "2.6.0",
    "@parcel/watcher-linux-arm64-glibc": "2.6.0",
    "@parcel/watcher-linux-arm64-musl": "2.6.0",
    "@parcel/watcher-linux-x64-glibc": "2.6.0",
    "@parcel/watcher-linux-x64-musl": "2.6.0",
    "@parcel/watcher-win32-arm64": "2.6.0",
    "@parcel/watcher-win32-x64": "2.6.0"
  }
}
