{
  lib,
  stdenvNoCC,
  callPackage,
  bun ? callPackage ./bun.nix { },
  rev ? "dirty",
  hash ?
    (lib.pipe ./hashes.json [
      builtins.readFile
      builtins.fromJSON
    ]).nodeModules.${stdenvNoCC.hostPlatform.system},
}:
let
  packageJson = lib.pipe ../packages/orchestra/package.json [
    builtins.readFile
    builtins.fromJSON
  ];
  platform = stdenvNoCC.hostPlatform;
  bunCpu = if platform.isAarch64 then "arm64" else "x64";
  bunOs = if platform.isLinux then "linux" else "darwin";
  # Filter the workspace graph, including build/dev dependencies. Keeping only
  # legacy orchestra misses modern CLI and toolkit workspaces not reachable there.
  workspaces = lib.listToAttrs (
    map (path: {
      name = (builtins.fromJSON (builtins.readFile (../. + "/${path}/package.json"))).name;
      value = {
        inherit path;
        manifest = builtins.fromJSON (builtins.readFile (../. + "/${path}/package.json"));
      };
    }) workspacePaths
  );
  # The root manifest owns the workspace list (e.g. native/omni/bindings/node).
  # Expand a trailing `/*` like Bun does; any other glob fails evaluation loudly.
  workspacePaths = lib.concatMap (pattern:
    if lib.hasSuffix "/*" pattern then
      let
        directory = lib.removeSuffix "/*" pattern;
      in
      map (name: "${directory}/${name}") (
        builtins.filter (name:
          builtins.pathExists (../. + "/${directory}/${name}/package.json")
        ) (builtins.attrNames (builtins.readDir (../. + "/${directory}")))
      )
    else if lib.hasInfix "*" pattern then
      throw "Unsupported workspace pattern in package.json: ${pattern}"
    else
      [ pattern ]
  ) (lib.importJSON ../package.json).workspaces.packages;
  selected = builtins.genericClosure {
    startSet = map (key: { inherit key; }) [
      "@orchestra/cli"
      "orchestra"
      "@orchestra/desktop"
      "@orchestra/app"
      "@orchestra/web"
    ];
    operator = item:
      let
        manifest = workspaces.${item.key}.manifest;
        dependencies = (manifest.dependencies or { })
          // (manifest.devDependencies or { })
          // (manifest.optionalDependencies or { });
      in map (key: { inherit key; }) (
        builtins.filter (name: lib.hasPrefix "workspace:" dependencies.${name})
          (builtins.attrNames dependencies)
      );
  };
in
stdenvNoCC.mkDerivation {
  pname = "orchestra-node_modules";
  version = "${packageJson.version}+${lib.replaceString "-" "." rev}";

  src = lib.fileset.toSource {
    root = ../.;
    fileset = lib.fileset.intersection (lib.fileset.fromSource (lib.sources.cleanSource ../.)) (
      lib.fileset.unions ([
        ../packages
        ../apps
        ../modules
        ../assets
        ../bun.lock
        ../package.json
        ../bunfig.toml
        ../tsconfig.json
        ../script/module-registry.json
        ../script/toolchain-registry.json
        ../patches
        ../.github/TEAM_MEMBERS # required by @orchestra/script
      ] ++ map (entry: ../. + "/${entry.path}") (lib.importJSON ../script/module-registry.json).modules
        ++ map (entry: ../. + "/${entry.path}") (builtins.attrValues (lib.importJSON ../script/toolchain-registry.json).roots))
    );
  };

  impureEnvVars = lib.fetchers.proxyImpureEnvVars ++ [
    "GIT_PROXY_COMMAND"
    "SOCKS_SERVER"
  ];

  nativeBuildInputs = [ bun ];

  dontConfigure = true;

  buildPhase = ''
    runHook preBuild
    export BUN_INSTALL_CACHE_DIR=$(mktemp -d)
    bun install \
      --cpu="${bunCpu}" \
      --os="${bunOs}" \
      --filter '!./' \
      ${lib.concatMapStringsSep " \\\n      " (item: "--filter ${lib.escapeShellArg ("./" + workspaces.${item.key}.path)}") selected} \
      --frozen-lockfile \
      --ignore-scripts \
      --no-progress
    bun --bun ${./scripts/canonicalize-node-modules.ts}
    printf 'NODE_MODULES_RECEIPT:{"name":"%s","system":"%s","out":"%s","phase":"canonicalize"}\n' "$name" '${platform.system}' "$out"
    bun --bun ${./scripts/normalize-bun-binaries.ts}
    printf 'NODE_MODULES_RECEIPT:{"name":"%s","system":"%s","out":"%s","phase":"normalize"}\n' "$name" '${platform.system}' "$out"
    runHook postBuild
  '';

  installPhase = ''
    runHook preInstall
    mkdir -p $out
    find . -type d -name node_modules -prune -exec cp -R --parents {} $out \;
    test -d $out/node_modules/.bun
    test -n "$(find $out/node_modules/.bun -mindepth 1 -print -quit)"
    runHook postInstall
    echo "NODE_MODULES_INSTALL_COMPLETE:${platform.system}"
    printf 'NODE_MODULES_RECEIPT:{"name":"%s","system":"%s","out":"%s","phase":"install"}\n' "$name" '${platform.system}' "$out"
  '';

  dontFixup = true;

  passthru = {
    workspacePaths = map (item: workspaces.${item.key}.path) selected;
    hashStatus = "stale: measurement pending for Bun 1.3.14 and final workspace closure";
  };

  outputHashAlgo = "sha256";
  outputHashMode = "recursive";
  outputHash = hash;

  meta.platforms = [
    "aarch64-linux"
    "x86_64-linux"
    "aarch64-darwin"
    "x86_64-darwin"
  ];
}
