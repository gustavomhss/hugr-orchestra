      ]
    },
    {
      "id": "L3-ADOPT-02",
      "sections": [
        "3 / Preparação e aprovação / item 2"
      ],
      "change": "Resposta do owner genuína, role=user, mesma Session, posterior à apresentação, sem qualquer role=user intermediária inclusive sintética; distingue as recusas.",
      "basis": [
        "s3-l2-revision/bodies/l2-maestro.md / seção 2",
        "s3-provenance/sources/modules/maestro/coordination/src/approval.ts:135-146"
      ]
    },
    {
      "id": "L3-ADOPT-03",
      "sections": [
        "4 / Estado possível"
      ],
      "change": "Separa release de arm parked, sob run lock e com human-release na próxima avaliação, da recuperação/remoção de lock antigo com gate-recovered antes da remoção; explicita a composição Relay.release → recover → ArmEvaluate.release.",
      "basis": [
        "s3-provenance/sources/modules/relay/src/arm/evaluate.ts:67-89",
        "s3-provenance/sources/packages/core/src/relay.ts:374-418",
        "s3-provenance/sources/packages/core/src/relay.ts:517-520"
      ]
    },
    {
      "id": "L3-ADOPT-04",
      "sections": [
        "4 / Recuperação segura / item 5",
        "6 / efeito desconhecido"
      ],
      "change": "Retira a condição baseada em perigo de duplicação para unknown-effect, alinha ao L2 Relay e impede que a regra geral amplie o contrato específico Dock.",
      "basis": [
        "s3-l2-revision/bodies/l2-relay.md / seção 2 / item 5",
        "s3-l2-revision/bodies/l2-integrations.md / seção 3"
      ]
    },
    {
      "id": "L3-ADOPT-05",
      "sections": [
        "5 / Tratamento da ação / stale-not-dispatched"
      ],
      "change": "Especifica no máximo uma repetição automática somente para NativeRPCError, code stale-ref, outcome not-dispatched, attempt < 1; não amplia para outros stale/failures.",
      "basis": [
        "s3-l2-revision/bodies/l2-integrations.md / seção 3",
