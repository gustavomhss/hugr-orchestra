+    expect(indexOwnership(f.store, f.ref, { scope: "unit", need: "entry" }, () => "v1").kind).toBe("hold")
+    expect(planOwnershipUpdate(f.store, f.ref, "unit", () => ({ kind: "present", version: "v1" })).kind).toBe("hold")
