+        if (existsSync(path) && JSON.parse(readFileSync(path, "utf8")).name === name) { manifest = path; break }
+        const parent = dirname(current)
+        if (parent === current) throw new Error(`evaluation-runtime-package: ${name}`)
+        current = parent
+      }
+    }
