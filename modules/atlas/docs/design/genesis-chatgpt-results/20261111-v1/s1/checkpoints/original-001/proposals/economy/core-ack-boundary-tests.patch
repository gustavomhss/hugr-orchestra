+  test("S1-AC08 reserve commit failure prevents forwarding through the real executor", async () => {
+    const env = envelope({ attempts: 5, outputTokens: 100, inFlight: 5 })
+    const { guard, hits, app } = chain(env, { key: "s1-reserve-failure" }, [SUCCESS()])
+    const observed = await Effect.runPromise(Effect.gen(function* () {
+      yield* seedEnvelope(env)
+      const failing = yield* LLMClient.generate(LLM.request({
+        model: model(), prompt: "Say hello.", generation: { maxTokens: 4 },
+      })).pipe(Effect.flip)
+      return { failing, outcomes: yield* guard.outcomes, rows: yield* recoverEnvelopeAttempts(env.envelopeId) }
+    }).pipe(Effect.provide(faultLayer({ failReserveCommit: true })), Effect.provide(app)))
+    expect(hitsOf(hits)).toBe(0)
+    expect(observed.rows).toEqual([])
+    expect(observed.outcomes).toMatchObject([{ kind: "economy-refusal", reason: "storage" }])
+    expect(transportMessage(observed.failing)).toContain("economy-dispatch-refused:storage")
+  })
