@@ -0,0 +1,150 @@
+// Explicit extended source capture. Existing file:/members: limits and refusals stay unchanged.
+// blob: is a bounded byte/mode record; link: captures a literal, never follows its target;
+// retained:<commit>:<.atlas path> reads historical Git evidence, never a live Atlas authority/store.
+import { createHash } from "node:crypto"
+import { closeSync, constants, fstatSync, lstatSync, openSync, readlinkSync, readSync, realpathSync } from "node:fs"
+import { resolve } from "node:path"
+import { id } from "@atlas/kernel"
+import type { OwnershipInputObservation } from "@atlas/knowledge"
+import { isContainedIn } from "./containment.js"
+import { runGitStrict, runGitStrictBytes } from "./run-git.js"
+
+export const OWNERSHIP_SOURCE_BYTE_LIMIT = 8 * 1024 * 1024
+export type OwnershipSourceCapture = {
+  readonly observation: OwnershipInputObservation
+  readonly bytes?: Uint8Array
+  readonly members?: readonly string[]
+  readonly memberKeys?: ReadonlyMap<string, string>
+  readonly sourceMembers?: readonly { readonly path: string; readonly key: string; readonly mode: string }[]
+}
+
+/** All output bytes are a source-evidence record, not prose, authority, or decoded binary content. */
+export function captureOwnershipExtendedInput(repoPath: string, key: string, absent?: (path: string) => boolean): OwnershipSourceCapture {
+  try {
+    const root = realpathSync(repoPath)
+    if (key.startsWith("retained:")) return retained(root, key.slice(9))
+    const prefix = key.startsWith("blob:") ? "blob:" : key.startsWith("link:") ? "link:" : key.startsWith("source-members:") ? "source-members:" : undefined
+    if (prefix === undefined) return unavailable()
+    const path = key.slice(prefix.length)
+    if (!allowed(path)) return unavailable()
+    if (prefix === "source-members:") return membership(root, path, absent)
+    const before = ancestry(root, path)
+    const file = resolve(root, path)
+    const stat = lstatSync(file)
+    if (prefix === "link:") {
+      if (!stat.isSymbolicLink() || stat.size > 4096) return unavailable()
+      const target = readlinkSync(file, { encoding: "buffer" })
+      if (target.length > 4096 || !sameStat(stat, lstatSync(file)) || !sameAncestry(root, path, before)) return unavailable()
+      return record({ kind: "ownership-symlink-evidence", version: 1, path, mode: "120000", targetBytes: Array.from(target),
+        authority: "literal repository link only; target not followed or granted authority" })
+    }
+    if (!stat.isFile() || stat.isSymbolicLink() || stat.size > OWNERSHIP_SOURCE_BYTE_LIMIT) return unavailable()
+    const descriptor = openSync(file, constants.O_RDONLY | (constants.O_NOFOLLOW ?? 0) | (constants.O_NONBLOCK ?? 0))
+    try {
+      const opened = fstatSync(descriptor)
+      if (!opened.isFile() || !sameStat(stat, opened) || !isContainedIn(root, realpathSync(file))) return unavailable()
+      const parts: Buffer[] = []
+      const buffer = Buffer.alloc(65536)
+      let size = 0
+      for (;;) {
+        const count = readSync(descriptor, buffer, 0, buffer.length, null)
+        if (count === 0) break
+        size += count
+        if (size > OWNERSHIP_SOURCE_BYTE_LIMIT) return unavailable()
+        parts.push(Buffer.from(buffer.subarray(0, count)))
+      }
+      if (size !== opened.size || !sameStat(opened, fstatSync(descriptor)) || !sameStat(stat, lstatSync(file)) || !sameAncestry(root, path, before)) return unavailable()
+      const bytes = Buffer.concat(parts, size)
+      return record({ kind: "ownership-file-evidence", version: 1, path, mode: (stat.mode & 0o111) === 0 ? "100644" : "100755",
+        size, sha256: createHash("sha256").update(bytes).digest("hex"), contentBytes: Array.from(bytes),
+        authority: "source bytes and executable mode only; interpretation and authority require the frozen recipe" })
+    } finally { closeSync(descriptor) }
+  } catch (error) {
+    const path = key.startsWith("blob:") || key.startsWith("link:") ? key.slice(5) : undefined
+    if (path !== undefined && allowed(path) && error !== null && typeof error === "object" && "code" in error && error.code === "ENOENT" && absent?.(path))
+      return { observation: { kind: "absent" } }
+    return unavailable()
+  }
+}
+
+export function capturedExtendedInputVersion(bytes: Uint8Array): string {
+  return String(id({ kind: "ownership-captured-source", version: 1, bytes: Array.from(bytes) }))
+}
+
+function membership(root: string, path: string, absent?: (path: string) => boolean): OwnershipSourceCapture {
+  const before = ancestry(root, `${path}/sentinel`)
+  const dir = lstatSync(resolve(root, path))
+  if (!dir.isDirectory() || dir.isSymbolicLink()) return unavailable()
+  const output = runGitStrict(root, ["ls-files", "--cached", "--others", "--exclude-standard", "-z", "--", `:(literal)${path}`])
+  if (output.truncated || output.stderr !== "" || output.stdout !== "" && !output.stdout.endsWith("\0")) return unavailable()
+  const paths = output.stdout === "" ? [] : output.stdout.split("\0").slice(0, -1)
+  if (paths.some((item) => !allowed(item) || !item.startsWith(`${path}/`))) return unavailable()
+  const entries: { path: string; key: string; mode: string }[] = []
+  for (const item of [...new Set(paths)].sort()) {
+    let stat: ReturnType<typeof lstatSync>
+    try { ancestry(root, item); stat = lstatSync(resolve(root, item)) } catch (error) {
+      if (error !== null && typeof error === "object" && "code" in error && error.code === "ENOENT" && absent?.(item)) continue
+      return unavailable()
+    }
+    // Only the ordinary observer's verified negative lookup may remove a tracked missing member.
+    if (!stat.isFile() && !stat.isSymbolicLink()) return unavailable()
+    entries.push({ path: item, key: `${stat.isSymbolicLink() ? "link" : "blob"}:${item}`,
+      mode: stat.isSymbolicLink() ? "120000" : (stat.mode & 0o111) === 0 ? "100644" : "100755" })
+  }
+  if (!sameStat(dir, lstatSync(resolve(root, path))) || !sameAncestry(root, `${path}/sentinel`, before)) return unavailable()
+  const capture = record({ kind: "ownership-source-membership", version: 1, path, entries,
+    exclusions: [".git and .atlas paths are refused; retained Git evidence uses an explicit immutable key"] })
+  return { ...capture, members: entries.map((entry) => entry.path), memberKeys: new Map(entries.map((entry) => [entry.path, entry.key])), sourceMembers: entries }
+}
+
+function retained(root: string, value: string): OwnershipSourceCapture {
+  const match = /^([0-9a-f]{40}):(.+)$/.exec(value)
+  if (match === null) return unavailable()
+  const commit = match[1]!
+  const path = match[2]!
+  if (!path.split("/").includes(".atlas") || !allowed(path, true)) return unavailable()
+  const tree = runGitStrict(root, ["--no-lazy-fetch", "ls-tree", "-r", "-z", "--full-tree", commit])
+  if (tree.truncated || tree.stderr !== "" || !tree.stdout.endsWith("\0")) return unavailable()
+  const matching = tree.stdout.split("\0").filter((line) => line.slice(line.indexOf("\t") + 1) === path)
+  if (matching.length !== 1) return unavailable()
+  const header = /^(100644|100755) blob ([0-9a-f]{40})\t/.exec(matching[0]!)
+  if (header === null) return unavailable()
+  const blob = header[2]!
+  const count = runGitStrict(root, ["--no-lazy-fetch", "cat-file", "-s", blob])
+  if (count.truncated || count.stderr !== "" || !/^\d+\n$/.test(count.stdout) || Number(count.stdout) > OWNERSHIP_SOURCE_BYTE_LIMIT) return unavailable()
+  const content = runGitStrictBytes(root, ["--no-lazy-fetch", "cat-file", "blob", blob])
+  if (content.truncated || content.stderr.length !== 0) return unavailable()
+  const bytes = content.stdout
+  if (bytes.length !== Number(count.stdout) || createHash("sha1").update(`blob ${bytes.length}\0`).update(bytes).digest("hex") !== blob) return unavailable()
+  return record({ kind: "ownership-retained-git-evidence", version: 1, commit, path, blob, mode: header[1], size: bytes.length,
+    sha256: createHash("sha256").update(bytes).digest("hex"), contentBytes: Array.from(bytes),
+    authority: "committed historical evidence only; not current state, authorization, policy or served knowledge" })
+}
+
+function ancestry(root: string, path: string) {
+  const components = path.split("/")
+  const stamps: { path: string; dev: number; ino: number }[] = []
+  for (let i = 0; i < components.length - 1; i++) {
+    const name = resolve(root, ...components.slice(0, i + 1))
+    const stat = lstatSync(name)
+    if (!stat.isDirectory() || stat.isSymbolicLink() || !isContainedIn(root, name)) throw new Error("source-capture-ancestor-refused")
+    stamps.push({ path: name, dev: stat.dev, ino: stat.ino })
+  }
+  return stamps
+}
+function sameAncestry(root: string, path: string, before: ReturnType<typeof ancestry>): boolean {
+  const after = ancestry(root, path)
+  return before.length === after.length && before.every((stat, index) => stat.path === after[index]?.path && stat.dev === after[index]?.dev && stat.ino === after[index]?.ino)
+}
+function sameStat(before: ReturnType<typeof lstatSync>, after: ReturnType<typeof lstatSync>): boolean {
+  return before !== undefined && after !== undefined && before.dev === after.dev && before.ino === after.ino && before.size === after.size && before.mode === after.mode && before.mtimeMs === after.mtimeMs && before.ctimeMs === after.ctimeMs
+}
+function allowed(path: string, retained = false): boolean {
+  return path.length > 0 && !path.startsWith("/") && !path.includes("\\") && !/[\u0000-\u001f\u007f]/.test(path) && !/^[A-Za-z]:/.test(path) &&
+    !path.split("/").some((part) => !part || [".", "..", ".git", ...(retained ? [] : [".atlas"])].includes(part))
+}
+function record(value: unknown): OwnershipSourceCapture {
+  const bytes = new TextEncoder().encode(JSON.stringify(value) + "\n")
+  return { observation: { kind: "present", version: capturedExtendedInputVersion(bytes) }, bytes }
+}
+const unavailable = (): OwnershipSourceCapture => ({ observation: { kind: "unavailable" } })
