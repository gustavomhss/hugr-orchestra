+// Real filesystem/Git fixture for mechanical CI only; never a campaign source or judgment.
+import { mkdtempSync, mkdirSync, readFileSync, rmSync, writeFileSync } from "node:fs"
+import { tmpdir } from "node:os"
+import { join } from "node:path"
+import { runGit } from "../../src/run-git.js"
+import { observeOwnershipInput } from "../../src/ownership-input.js"
+import { captureOwnershipExtendedInput } from "../../src/ownership-source-capture.js"
+import type { OwnershipRebuildRequest, OwnershipRecipe } from "../../src/ownership-rebuild.js"
+import { SCOPE, zamiFixture } from "./ownership-rebuild-fixture.js"
+
+export function sourceCaptureFixture() {
+  const root = mkdtempSync(join(tmpdir(), "ownership-capture-ci-"))
+  runGit(root, ["init", "-q"])
+  mkdirSync(join(root, "src"))
+  writeFileSync(join(root, "src/one.txt"), "first\n")
+  writeFileSync(join(root, "recipe.ts"), "// explicit mechanical fixture recipe\n")
+  runGit(root, ["add", "--", "src/one.txt", "recipe.ts"])
+  const capture = (key: string) => captureOwnershipExtendedInput(root, key, (path) => observeOwnershipInput(root, `file:${path}`).kind === "absent")
+  const observe = (key: string) => observeOwnershipInput(root, key)
+  const cleanup = () => rmSync(root, { recursive: true, force: true })
+  return { root, capture, observe, cleanup }
+}
+
+export function sourceRebuildFixture() {
+  const host = sourceCaptureFixture()
+  const fixture = zamiFixture()
+  const keys = ["file:recipe.ts", "source-members:src", "blob:src/one.txt"]
+  const inputs = keys.map((key) => {
+    const observed = host.observe(key)
+    if (observed.kind !== "present") throw new Error(JSON.stringify(observed))
+    return { key, version: observed.version }
+  })
+  const baseline = fixture.artifact("z", inputs, [], "initial synthetic body\n")
+  const manifest = fixture.store.put({ kind: "ownership-manifest", version: 1, scope: SCOPE, entries: [{ key: "z", artifact: baseline.ref }], roots: { operational: "z" } })
+  const calls: string[] = []
+  const recipe: OwnershipRecipe = { key: "z", recipeInputKey: "file:recipe.ts", recipeVersion: inputs[0]!.version,
+    declaredInputs: keys, mandatoryInputs: ["file:recipe.ts", "source-members:src"], required: [],
+    run: (input) => {
+      calls.push("z")
+      return { body: JSON.stringify({ members: input.lists.get("source-members:src"), versions: [...input.captured] }),
+        authorityBasis: "synthetic filesystem CI only", evidence: ["fixture, not semantic acceptance"], gaps: ["no native producer"] }
+    } }
+  const request: OwnershipRebuildRequest = { store: fixture.store, manifest, scope: SCOPE, contract: fixture.contractRef,
+    observe: host.observe, readCapturedBytes: (key) => key.startsWith("file:") ? new Uint8Array(readFileSync(join(host.root, key.slice(5)))) : host.capture(key).bytes,
+    listMembers: () => [], listSourceMembers: (dir) => host.capture(`source-members:${dir}`).sourceMembers,
+    recipes: new Map([["z", recipe]]), evaluate: fixture.evaluate }
+  return { ...host, ...fixture, request, calls }
+}
