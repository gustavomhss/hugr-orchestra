+import { describe, expect, test } from "vitest"
+import { unlinkSync, writeFileSync } from "node:fs"
+import { join } from "node:path"
+import { rebuildOwnershipUpdate } from "../src/ownership-rebuild.js"
+import { sourceRebuildFixture } from "./fixtures/ownership-source-capture-fixture.js"
+
+describe("source membership rebuild through the actual executor; synthetic CI judgments", () => {
+  test("SR-01 adding an oversized source binds the new blob and executes the affected recipe", () => {
+    const fixture = sourceRebuildFixture()
+    try {
+      writeFileSync(join(fixture.root, "src/new.bin"), Buffer.alloc(256001, 0xe2))
+      const result = rebuildOwnershipUpdate(fixture.request)
+      if (result.kind === "hold") throw new Error(JSON.stringify(result))
+      expect(result.affected).toEqual(["z"])
+      expect(result.calls).toEqual(["z"])
+      expect(fixture.receiptInputs(result.manifest, "z").map((input) => input.key)).toContain("blob:src/new.bin")
+    } finally { fixture.cleanup() }
+  })
+
+  test("SR-02 a corroborated removal drops the dynamic input instead of retaining stale bytes", () => {
+    const fixture = sourceRebuildFixture()
+    try {
+      unlinkSync(join(fixture.root, "src/one.txt"))
+      const result = rebuildOwnershipUpdate(fixture.request)
+      if (result.kind === "hold") throw new Error(JSON.stringify(result))
+      expect(result.calls).toEqual(["z"])
+      expect(fixture.receiptInputs(result.manifest, "z").map((input) => input.key)).not.toContain("blob:src/one.txt")
+    } finally { fixture.cleanup() }
+  })
+
+  test("SR-03 caller omissions cannot replace the exact captured membership record", () => {
+    const fixture = sourceRebuildFixture()
+    try {
+      writeFileSync(join(fixture.root, "src/one.txt"), "new source")
+      const result = rebuildOwnershipUpdate({ ...fixture.request, listSourceMembers: () => [] })
+      expect(result).toMatchObject({ kind: "hold", reason: "ownership-integrity", evidence: ["source-members:src", "source-member-list-binding"] })
+      expect(fixture.calls).toEqual([])
+    } finally { fixture.cleanup() }
+  })
+
+  test("SR-04 a missing source-members capture is not an empty population", () => {
+    const fixture = sourceRebuildFixture()
+    try {
+      expect(rebuildOwnershipUpdate({ ...fixture.request, listSourceMembers: () => undefined })).toMatchObject({ kind: "hold", reason: "ownership-input-unavailable" })
+      expect(fixture.calls).toEqual([])
+    } finally { fixture.cleanup() }
+  })
+})
