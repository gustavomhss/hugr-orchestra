+import { describe, expect, test } from "vitest"
+import { mkdirSync, readFileSync, symlinkSync, truncateSync, writeFileSync } from "node:fs"
+import { join } from "node:path"
+import { runGit, runGitStrict, runGitStrictBytes } from "../src/run-git.js"
+import { OWNERSHIP_SOURCE_BYTE_LIMIT } from "../src/ownership-source-capture.js"
+import { sourceCaptureFixture } from "./fixtures/ownership-source-capture-fixture.js"
+
+describe("extended source capture; real filesystem/Git mechanical CI", () => {
+  test("SCAP-01 explicit blob capture preserves bytes above the unchanged file limit", () => {
+    const fixture = sourceCaptureFixture()
+    try {
+      const source = Buffer.alloc(256001, 0xe1)
+      writeFileSync(join(fixture.root, "src/large.bin"), source)
+      expect(fixture.observe("file:src/large.bin")).toEqual({ kind: "unavailable" })
+      const result = fixture.capture("blob:src/large.bin")
+      expect(result.observation.kind).toBe("present")
+      const record = JSON.parse(new TextDecoder().decode(result.bytes))
+      expect(new Uint8Array(record.contentBytes)).toEqual(new Uint8Array(source))
+      expect(record.mode).toBe("100644")
+    } finally { fixture.cleanup() }
+  })
+
+  test("SCAP-02 the extended capture still refuses oversized files and traversal", () => {
+    const fixture = sourceCaptureFixture()
+    try {
+      truncateSync(join(fixture.root, "src/one.txt"), OWNERSHIP_SOURCE_BYTE_LIMIT + 1)
+      expect(fixture.capture("blob:src/one.txt").observation).toEqual({ kind: "unavailable" })
+      for (const key of ["blob:../secret", "blob:.git/config", "blob:.atlas/policy", "blob:src/../recipe.ts"])
+        expect(fixture.capture(key).observation).toEqual({ kind: "unavailable" })
+    } finally { fixture.cleanup() }
+  })
+
+  test.skipIf(process.platform === "win32")("SCAP-03 links remain literal; neither final nor ancestor links expose target bytes", () => {
+    const fixture = sourceCaptureFixture()
+    try {
+      symlinkSync("../recipe.ts", join(fixture.root, "src/link.txt"))
+      symlinkSync("src", join(fixture.root, "alias"))
+      expect(fixture.observe("file:src/link.txt")).toEqual({ kind: "unavailable" })
+      expect(fixture.capture("blob:src/link.txt").observation).toEqual({ kind: "unavailable" })
+      const literal = fixture.capture("link:src/link.txt")
+      const record = JSON.parse(new TextDecoder().decode(literal.bytes))
+      expect(new TextDecoder().decode(new Uint8Array(record.targetBytes))).toBe("../recipe.ts")
+      expect(record).not.toHaveProperty("contentBytes")
+      expect(fixture.capture("blob:alias/one.txt").observation).toEqual({ kind: "unavailable" })
+    } finally { fixture.cleanup() }
+  })
+
+  test("SCAP-04 nested retained binary evidence comes from the commit, not mutable live state", () => {
+    const fixture = sourceCaptureFixture()
+    try {
+      mkdirSync(join(fixture.root, "src/.atlas"))
+      const binary = new Uint8Array([0, 255, 128, 193, 10])
+      writeFileSync(join(fixture.root, "src/.atlas/evidence.bin"), binary)
+      runGit(fixture.root, ["add", "--", "src/.atlas/evidence.bin"])
+      runGit(fixture.root, ["-c", "user.name=CI fixture", "-c", "user.email=fixture@example.invalid", "commit", "-qm", "fixture only"])
+      const commit = runGit(fixture.root, ["rev-parse", "HEAD"]).trim()
+      const blob = runGit(fixture.root, ["rev-parse", `${commit}:src/.atlas/evidence.bin`]).trim()
+      expect(runGitStrictBytes(fixture.root, ["cat-file", "blob", blob]).stdout).toEqual(binary)
+      expect(() => runGitStrict(fixture.root, ["cat-file", "blob", blob])).toThrow()
+      writeFileSync(join(fixture.root, "src/.atlas/evidence.bin"), "changed live state")
+      expect(fixture.observe("file:src/.atlas/evidence.bin")).toEqual({ kind: "unavailable" })
+      const result = fixture.capture(`retained:${commit}:src/.atlas/evidence.bin`)
+      expect(result.observation.kind).toBe("present")
+      const record = JSON.parse(new TextDecoder().decode(result.bytes))
+      expect(new Uint8Array(record.contentBytes)).toEqual(binary)
+      expect(record.authority).toContain("not current state")
+      expect(readFileSync(join(fixture.root, "src/.atlas/evidence.bin"), "utf8")).toBe("changed live state")
+    } finally { fixture.cleanup() }
+  })
+})
