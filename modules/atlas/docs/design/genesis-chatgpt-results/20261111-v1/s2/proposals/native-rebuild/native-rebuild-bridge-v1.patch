--- /dev/null
+++ b/modules/atlas/scripts/ownership-native-rebuild.ts
@@ -0,0 +1,105 @@
+// Isolated, resumable native rebuild. No model dispatch, projection mutation or activation.
+import { createHash } from "node:crypto"
+import { lstatSync, readFileSync, realpathSync, writeFileSync } from "node:fs"
+import { dirname, join, resolve } from "node:path"
+import { asHash } from "@atlas/kernel"
+import { CAS_REL } from "../packages/adapter-io/src/okf-store.js"
+import { createDiskStore } from "../packages/adapter-io/src/store.js"
+import { headSha } from "../packages/adapter-io/src/run-git.js"
+import { isContainedIn } from "../packages/adapter-io/src/containment.js"
+import { observeOwnershipInput, ownershipInput } from "../packages/adapter-io/src/ownership-input.js"
+import { captureOwnershipExtendedInput } from "../packages/adapter-io/src/ownership-source-capture.js"
+import { rebuildNativeOwnership } from "../packages/adapter-io/src/ownership-native-rebuild.js"
+import type { NativeOwnershipRebuildRequest } from "../packages/adapter-io/src/ownership-native-rebuild.js"
+import type { NativeOwnershipJudgeSubmission, NativeOwnershipSubmission } from "../packages/adapter-io/src/ownership-native-import.js"
+
+const object = (value: unknown): value is Record<string, unknown> => typeof value === "object" && value !== null && !Array.isArray(value)
+const text = (value: unknown): value is string => typeof value === "string" && value.trim().length > 0 && value.normalize("NFC") === value
+const hash = (value: unknown): value is string => typeof value === "string" && /^[0-9a-f]{64}$/.test(value)
+const strings = (value: unknown): value is readonly string[] => Array.isArray(value) && value.every(text)
+const sha256 = (data: Uint8Array) => createHash("sha256").update(data).digest("hex")
+if (!Bun.argv[2] || !Bun.argv[3] || !Bun.argv[4])
+  throw new Error("Usage: ownership-native-rebuild.ts <isolated-candidate-repo> <bundle.json> <new-result.json>")
+const repo = realpathSync(resolve(Bun.argv[2]))
+if (realpathSync(dirname(import.meta.path)) !== realpathSync(join(repo, "modules", "atlas", "scripts")))
+  throw new Error("native-rebuild-code-root-mismatch")
+const bundlePath = realpathSync(resolve(Bun.argv[3]))
+const bundleRoot = dirname(bundlePath)
+const bundle: unknown = JSON.parse(readFileSync(bundlePath, "utf8"))
+if (!object(bundle) || bundle.kind !== "ownership-native-rebuild-bundle" || bundle.version !== 1 || !hash(bundle.manifest) ||
+  !text(bundle.scope) || !hash(bundle.contract) || !object(bundle.nativeControl) || !text(bundle.nativeControl.key) || !hash(bundle.nativeControl.version) ||
+  !bundle.nativeControl.key.startsWith("file:") || !Array.isArray(bundle.recipes)) throw new Error("native-rebuild-bundle-malformed")
+const nativeControlBytes = original(bundle.nativeControlOriginal).bytes
+if (sha256(nativeControlBytes) !== sha256(read(repo, bundle.nativeControl.key.slice(5)))) throw new Error("native-rebuild-control-file-mismatch")
+const control: unknown = JSON.parse(new TextDecoder("utf-8", { fatal: true }).decode(nativeControlBytes))
+if (!object(control) || typeof control.implementationRevision !== "string" || headSha(repo) !== control.implementationRevision)
+  throw new Error("native-rebuild-implementation-revision-mismatch")
+const recipes: NativeOwnershipRebuildRequest["recipes"] = bundle.recipes.map((recipe) => {
+  if (!object(recipe) || !text(recipe.key) || !text(recipe.recipeInputKey) || !hash(recipe.recipeVersion) || !strings(recipe.declaredInputs) ||
+    !(recipe.mandatoryInputs === undefined || strings(recipe.mandatoryInputs)) || !strings(recipe.required) || !text(recipe.task)) throw new Error("native-rebuild-recipe-malformed")
+  return { key: recipe.key, recipeInputKey: recipe.recipeInputKey, recipeVersion: recipe.recipeVersion,
+    declaredInputs: recipe.declaredInputs, ...(recipe.mandatoryInputs === undefined ? {} : { mandatoryInputs: recipe.mandatoryInputs }), required: recipe.required, task: recipe.task }
+})
+const implementations = ["modules/atlas/scripts/ownership-native-rebuild.ts", "modules/atlas/packages/adapter-io/src/ownership-native-rebuild.ts",
+  "modules/atlas/packages/adapter-io/src/ownership-rebuild.ts", "modules/atlas/packages/adapter-io/src/ownership-input.ts",
+  "modules/atlas/packages/adapter-io/src/ownership-source-capture.ts", "modules/atlas/packages/adapter-io/src/run-git.ts"]
+for (const recipe of recipes) {
+  if (implementations.some((path) => !(recipe.mandatoryInputs ?? recipe.declaredInputs).includes(`file:${path}`) || ownershipInput(repo, `file:${path}`) === undefined))
+    throw new Error("native-rebuild-implementation-unbound")
+}
+const sourceCapture = (key: string) => captureOwnershipExtendedInput(repo, key, (path) => observeOwnershipInput(repo, `file:${path}`).kind === "absent")
+const result = rebuildNativeOwnership({
+  store: createDiskStore(join(repo, CAS_REL)), manifest: asHash(bundle.manifest), scope: bundle.scope, contract: asHash(bundle.contract),
+  nativeControl: { key: bundle.nativeControl.key, version: bundle.nativeControl.version }, nativeControlBytes, recipes,
+  submissions: submissions(bundle.submissions), judgments: judgments(bundle.judgments),
+  observe: (key) => observeOwnershipInput(repo, key),
+  readCapturedBytes: (key) => {
+    if (!key.startsWith("file:")) return sourceCapture(key).bytes
+    try { return read(repo, key.slice(5)) } catch { return undefined }
+  },
+  listMembers: (path) => {
+    const members = sourceCapture(`source-members:${path}`).members
+    if (members === undefined) throw new Error("native-rebuild-member-capture-unavailable")
+    return members
+  },
+  listSourceMembers: (path) => {
+    const members = sourceCapture(`source-members:${path}`).sourceMembers
+    if (members === undefined) throw new Error("native-rebuild-source-member-capture-unavailable")
+    return members
+  },
+})
+writeFileSync(resolve(Bun.argv[4]), JSON.stringify(result, null, 2) + "\n", { flag: "wx" })
+console.log(JSON.stringify(result))
+process.exitCode = result.outcome.kind === "candidate" ? 0 : 2
+
+function submissions(value: unknown): readonly NativeOwnershipSubmission[] {
+  if (!Array.isArray(value)) throw new Error("native-rebuild-submissions-malformed")
+  return value.map((entry) => {
+    if (!object(entry) || !text(entry.key) || !text(entry.sessionId) || !text(entry.agentId) || !text(entry.attemptId)) throw new Error("native-rebuild-submission-identity")
+    return { key: entry.key, sessionId: entry.sessionId, agentId: entry.agentId, attemptId: entry.attemptId,
+      request: original(entry.request), response: original(entry.response), receipt: original(entry.receipt) }
+  })
+}
+function judgments(value: unknown): readonly NativeOwnershipJudgeSubmission[] {
+  if (!Array.isArray(value)) throw new Error("native-rebuild-judgments-malformed")
+  return value.map((entry) => {
+    if (!object(entry) || entry.role !== "J1" && entry.role !== "J2" || !text(entry.reviewer) || !text(entry.epoch)) throw new Error("native-rebuild-judge-identity")
+    return { role: entry.role, reviewer: entry.reviewer, epoch: entry.epoch,
+      request: original(entry.request), response: original(entry.response), receipt: original(entry.receipt) }
+  })
+}
+function original(value: unknown) {
+  if (!object(value) || !text(value.path) || !hash(value.sha256)) throw new Error("native-rebuild-original-ref")
+  const bytes = read(bundleRoot, value.path)
+  if (sha256(bytes) !== value.sha256) throw new Error("native-rebuild-original-digest")
+  return { bytes, sha256: value.sha256 }
+}
+function read(base: string, path: string): Uint8Array {
+  if (path.startsWith("/") || path.includes("\\") || /^[A-Za-z]:/.test(path) || path.split("/").some((part) => !part || [".", "..", ".git", ".atlas"].includes(part)))
+    throw new Error("native-rebuild-path-refused")
+  const file = realpathSync(resolve(base, path))
+  if (!isContainedIn(base, file)) throw new Error("native-rebuild-outside-root")
+  const stat = lstatSync(file)
+  if (!stat.isFile() || stat.size > 16 * 1024 * 1024) throw new Error("native-rebuild-input-limit")
+  return new Uint8Array(readFileSync(file))
+}
