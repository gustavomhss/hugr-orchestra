+// Synthetic transport ONLY. No model, native agent, actual S5 judgment or campaign result.
+import type { Hash } from "@atlas/contracts"
+import type { OwnershipBody } from "@atlas/knowledge"
+import { bindNativeOwnershipReviews, prepareNativeOwnership } from "../../src/ownership-native-import.js"
+import type { NativeOwnershipCandidate, NativeOwnershipSubmission } from "../../src/ownership-native-import.js"
+import { nativeRebuildRecipesIdentity } from "../../src/ownership-native-rebuild.js"
+import type { NativeOwnershipRebuildRequest } from "../../src/ownership-native-rebuild.js"
+import { file, nativeFixture, raw } from "./ownership-native-fixture.js"
+
+export function rebuildFixture() {
+  const first = nativeFixture()
+  const controlKey = "file:fixture/rebuild-control.json"
+  const implementation = first.plan.controls.find((control) => control.role === "recipe")!
+  const declaredInputs = [...first.plan.controls.map((control) => control.input.key), first.source.input.key, controlKey].sort()
+  const recipes = [{ key: first.key, recipeInputKey: implementation.input.key, recipeVersion: implementation.input.version,
+    declaredInputs, mandatoryInputs: declaredInputs, required: [], task: "Synthetic CI response transport; no real agent dispatch" }]
+  const nativeControlBytes = raw({ kind: "ownership-native-rebuild-control", version: 1, campaign: first.plan.campaign,
+    scope: first.plan.scope, sourceRevision: first.plan.sourceRevision, protocolRevision: first.plan.protocolRevision,
+    implementationRevision: first.plan.implementationRevision, contract: first.plan.contract,
+    recipeContractsHash: nativeRebuildRecipesIdentity(recipes), reviewers: first.plan.reviewers }).bytes
+  const control = file(first.files, controlKey.slice(5), nativeControlBytes)
+  const fixture = nativeFixture({ files: first.files, store: first.store, inputs: [first.source.input, control.input] })
+  const candidate = prepareNativeOwnership({ ...fixture, submissions: [fixture.submission()] })
+  if (candidate.kind === "hold") throw new Error(JSON.stringify(candidate))
+  const imported = bindNativeOwnershipReviews({ ...fixture, candidate, reviews: [fixture.judgment("J1", candidate), fixture.judgment("J2", candidate)] })
+  if (imported.kind === "hold") throw new Error(JSON.stringify(imported))
+  const request: NativeOwnershipRebuildRequest = {
+    store: fixture.store, manifest: imported.manifest, scope: fixture.plan.scope, contract: fixture.plan.contract,
+    observe: (key) => { const version = fixture.current(key); return version === undefined ? { kind: "absent" } : { kind: "present", version } },
+    readCapturedBytes: (key) => fixture.files.get(key), listMembers: () => [],
+    nativeControl: control.input, nativeControlBytes, recipes, submissions: [], judgments: [],
+  }
+  const submission = (pending: { document: Hash; sha256: string }, changes: Record<string, unknown> = {}): NativeOwnershipSubmission => {
+    const body = fixture.store.get(pending.document) as OwnershipBody
+    const request = { bytes: new Uint8Array(body.bytes), sha256: pending.sha256 }
+    const response = raw({ kind: "ownership-native-response", version: 1, requestSha256: request.sha256, key: fixture.key,
+      body: "Updated synthetic body\n", authorityBasis: "synthetic CI transport only", validity: "supported", gaps: ["no semantic acceptance"], evidence: ["fixture"], ...changes })
+    const identity = { key: fixture.key, sessionId: "fixture-s2", agentId: "fixture-rebuild-producer", attemptId: "fixture-rebuild-attempt" }
+    const receipt = raw({ kind: "ownership-native-transport-receipt", version: 1, adapter: "nativeChatGPT", campaign: fixture.plan.campaign,
+      completion: "COMPLETED", ...identity, requestSha256: request.sha256, responseSha256: response.sha256,
+      reservation: { commit: "1".repeat(40), path: "fixture/reservation.json", sha256: "a".repeat(64) } })
+    return { ...identity, request, response, receipt }
+  }
+  const judgment = (role: "J1" | "J2", pending: { document: Hash; sha256: string }, changes: Record<string, unknown> = {}) => {
+    const candidate: NativeOwnershipCandidate = { kind: "candidate", candidate: pending.document, reviewDocument: pending.document, reviewedManifestSha256: pending.sha256 }
+    return fixture.judgment(role, candidate, changes)
+  }
+  return { ...fixture, request, submission, judgment }
+}
