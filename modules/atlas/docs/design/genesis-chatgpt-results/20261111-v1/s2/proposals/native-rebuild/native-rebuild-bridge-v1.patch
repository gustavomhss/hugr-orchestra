--- /dev/null
+++ b/modules/atlas/packages/adapter-io/src/ownership-native-rebuild.ts
@@ -0,0 +1,233 @@
+// Native transport over the existing incremental executor. This adapter never dispatches a model.
+// Missing originals yield a durable request; reruns validate preserved bytes, not a new interpretation.
+import { createHash } from "node:crypto"
+import type { Hash } from "@atlas/contracts"
+import { id } from "@atlas/kernel"
+import { isOwnershipArtifact, isOwnershipContract, isOwnershipManifest, isOwnershipReceipt, isOwnershipReview } from "@atlas/knowledge"
+import type { OwnershipInput, OwnershipRefusal, OwnershipReview } from "@atlas/knowledge"
+import { capturedExtendedInputVersion } from "./ownership-source-capture.js"
+import { rebuildOwnershipUpdate } from "./ownership-rebuild.js"
+import type { OwnershipRecipe, OwnershipRecipeInput, OwnershipRebuildRequest, OwnershipRebuildResult } from "./ownership-rebuild.js"
+import type { NativeOwnershipJudgeSubmission, NativeOwnershipSubmission } from "./ownership-native-import.js"
+
+type Original = { readonly bytes: Uint8Array; readonly sha256: string }
+type Recipe = Omit<OwnershipRecipe, "run"> & { readonly task: string }
+type Control = {
+  readonly kind: "ownership-native-rebuild-control"; readonly version: 1; readonly campaign: "20261111-v1"
+  readonly scope: string; readonly sourceRevision: string; readonly protocolRevision: string; readonly implementationRevision: string
+  readonly contract: Hash; readonly recipeContractsHash: Hash
+  readonly reviewers: Readonly<Record<"J1" | "J2", { readonly id: string; readonly epoch: string }>>
+}
+type Pending = {
+  readonly kind: "pending-production" | "pending-review"; readonly key: string
+  readonly document: Hash; readonly sha256: string
+}
+type Preserved = { readonly request: Hash; readonly response: Hash; readonly receipt: Hash }
+
+export interface NativeOwnershipRebuildRequest extends Omit<OwnershipRebuildRequest, "recipes" | "evaluate"> {
+  /** Must already be an obligatory baseline receipt input for every artifact. */
+  readonly nativeControl: OwnershipInput
+  readonly nativeControlBytes: Uint8Array
+  readonly recipes: readonly Recipe[]
+  readonly submissions: readonly NativeOwnershipSubmission[]
+  readonly judgments: readonly NativeOwnershipJudgeSubmission[]
+}
+
+export type NativeOwnershipRebuildExecution = {
+  readonly kind: "native-rebuild-execution"
+  readonly outcome: OwnershipRebuildResult | Pending
+  readonly executionReceipt: Hash
+}
+
+/** Binding authority is resolved by the coordinator from S1/S5 before this call. This boundary
+ * checks the exact baseline-bound roster/control, captured inputs, originals and both decisions.
+ * It neither creates authority nor accepts caller-provided affected sets or cache entries. */
+export function rebuildNativeOwnership(request: NativeOwnershipRebuildRequest): NativeOwnershipRebuildExecution {
+  const events: unknown[] = []
+  const finish = (outcome: OwnershipRebuildResult | Pending): NativeOwnershipRebuildExecution => ({
+    kind: "native-rebuild-execution", outcome,
+    executionReceipt: request.store.put({ kind: "ownership-native-rebuild-receipt", version: 1,
+      baseline: request.manifest, scope: request.scope, nativeControl: request.nativeControl, outcome, events,
+      transport: "preserved-nativeChatGPT-originals", modelDispatchesByThisAdapter: 0,
+      physicalAttempts: "UNKNOWN", tokens: "UNKNOWN", billing: "UNKNOWN" }),
+  })
+  const control = decode({ bytes: request.nativeControlBytes, sha256: sha256(request.nativeControlBytes) })
+  if (!isControl(control) || control.scope !== request.scope || control.contract !== request.contract ||
+    control.recipeContractsHash !== nativeRebuildRecipesIdentity(request.recipes) || !request.nativeControl.key.startsWith("file:") ||
+    sourceVersion(request.nativeControlBytes) !== request.nativeControl.version)
+    return finish(hold("malformed-ownership", ["native-rebuild-control"]))
+  const controlObservation = request.observe(request.nativeControl.key)
+  if (controlObservation.kind !== "present" || controlObservation.version !== request.nativeControl.version)
+    return finish(hold("ownership-input-changed", ["native-rebuild-control", request.nativeControl.key]))
+  const contract = request.store.get(request.contract)
+  if (!isOwnershipContract(contract) || id(contract) !== request.contract) return finish(hold("ownership-review", ["native-rebuild-contract"]))
+  const manifest = request.store.get(request.manifest)
+  if (!isOwnershipManifest(manifest) || id(manifest) !== request.manifest || manifest.scope !== request.scope)
+    return finish(hold("ownership-integrity", ["native-rebuild-baseline"]))
+  if (!sameSet(manifest.entries.map((entry) => entry.key), request.recipes.map((recipe) => recipe.key)))
+    return finish(hold("malformed-ownership", ["native-rebuild-recipe-coverage"]))
+  for (const entry of manifest.entries) {
+    const artifact = request.store.get(entry.artifact)
+    const receipt = isOwnershipArtifact(artifact) ? request.store.get(artifact.receipt) : undefined
+    const recipe = request.recipes.find((value) => value.key === entry.key)!
+    if (!isOwnershipArtifact(artifact) || id(artifact) !== entry.artifact || !isOwnershipReceipt(receipt) || id(receipt) !== artifact.receipt ||
+      !receipt.inputs.some((input) => input.key === request.nativeControl.key && input.version === request.nativeControl.version) ||
+      !(recipe.mandatoryInputs ?? recipe.declaredInputs).includes(request.nativeControl.key) || !text(recipe.task))
+      return finish(hold("ownership-review", [entry.key, "native-rebuild-control-not-baseline-bound"]))
+    const reviewers = receipt.reviews.map((ref) => request.store.get(ref))
+    if (!reviewers.every(isOwnershipReview) || !sameSet(reviewers.map((review) => review.reviewer), [control.reviewers.J1.id, control.reviewers.J2.id]))
+      return finish(hold("ownership-review", [entry.key, "native-rebuild-baseline-reviewers"]))
+  }
+  let paused: Pending | OwnershipRefusal | undefined
+  const produced = new Map<string, { originals: Preserved; producer: string; requestSha256: string }>()
+  const recipes = new Map<string, OwnershipRecipe>(request.recipes.map((recipe) => [recipe.key, {
+    ...recipe, run: (input: OwnershipRecipeInput) => {
+      const inputs: OwnershipInput[] = []
+      const capture: { key: string; bytes?: Hash; members?: readonly string[] }[] = []
+      for (const [key, observation] of [...input.captured].sort(([a], [b]) => a < b ? -1 : a > b ? 1 : 0)) {
+        if (observation.kind !== "present") {
+          paused = hold("ownership-input-unavailable", [recipe.key, key]); return blocked()
+        }
+        inputs.push({ key, version: observation.version })
+        if (["file:", "blob:", "link:", "retained:", "source-members:"].some((prefix) => key.startsWith(prefix))) {
+          const data = input.bytes.get(key)
+          if (data === undefined || (key.startsWith("file:") ? sourceVersion(data) : capturedExtendedInputVersion(data)) !== observation.version) {
+            paused = hold("ownership-integrity", [recipe.key, key, "native-capture-bytes"]); return blocked()
+          }
+          capture.push({ key, bytes: request.store.put({ kind: "ownership-body", version: 1, bytes: Array.from(data) }) })
+        }
+        if (key.startsWith("members:")) {
+          const members = input.lists.get(key.slice(8))
+          if (members === undefined || id({ kind: "ownership-membership", version: 2, bytes: Array.from(encode(members.join("\0"))) }) !== observation.version) {
+            paused = hold("ownership-integrity", [recipe.key, key, "native-capture-members"]); return blocked()
+          }
+          capture.push({ key, members: [...members] })
+        }
+      }
+      const dependencies = [...input.dependencies].map(([key, result]) => ({ key, result }))
+      const prompt = original({ kind: "ownership-native-rebuild-request", version: 1, campaign: control.campaign,
+        baseline: request.manifest, scope: request.scope, key: recipe.key, nativeControl: request.nativeControl,
+        contract: request.contract, recipeInputKey: recipe.recipeInputKey, recipeVersion: recipe.recipeVersion,
+        inputs, dependencies, capture, task: recipe.task })
+      const document = request.store.put({ kind: "ownership-body", version: 1, bytes: Array.from(prompt.bytes) })
+      const submissions = request.submissions.filter((value) => value.key === recipe.key && value.request.sha256 === prompt.sha256)
+      if (submissions.length === 0) {
+        paused = { kind: "pending-production", key: recipe.key, document, sha256: prompt.sha256 }; return blocked()
+      }
+      if (submissions.length !== 1) { paused = hold("malformed-ownership", [recipe.key, "duplicate-native-rebuild-originals"]); return blocked() }
+      const submission = submissions[0]!
+      const originals = preserve(request, submission)
+      const response = decode(submission.response)
+      const receipt = decode(submission.receipt)
+      events.push({ step: "producer-originals", key: recipe.key, attemptId: submission.attemptId, originals: originals ?? null })
+      if (originals === undefined || ![submission.sessionId, submission.agentId, submission.attemptId].every(text) ||
+        [control.reviewers.J1.id, control.reviewers.J2.id].includes(submission.agentId) ||
+        sha256(submission.request.bytes) !== prompt.sha256 ||
+        !object(response) || !sameSet(Object.keys(response), ["kind", "version", "requestSha256", "key", "body", "authorityBasis", "validity", "gaps", "evidence"]) ||
+        response.kind !== "ownership-native-response" || response.version !== 1 || response.requestSha256 !== prompt.sha256 ||
+        response.key !== recipe.key || !nonempty(response.body) || !text(response.authorityBasis) ||
+        !strings(response.gaps) || !strings(response.evidence) || !["supported", "blocked"].includes(String(response.validity)) ||
+        !transport(receipt, submission, control.campaign)) {
+        paused = hold("malformed-ownership", [recipe.key, "native-rebuild-original-binding"]); return blocked()
+      }
+      if (new TextDecoder("utf-8", { fatal: true, ignoreBOM: true }).decode(encode(response.body)) !== response.body) {
+        paused = hold("malformed-ownership", [recipe.key, "native-rebuild-body-unicode"]); return blocked()
+      }
+      if (response.validity === "blocked") { paused = hold("ownership-blocked", [recipe.key, ...response.gaps]); return blocked() }
+      produced.set(recipe.key, { originals, producer: submission.agentId, requestSha256: prompt.sha256 })
+      return { body: response.body, authorityBasis: response.authorityBasis, validity: "supported", gaps: response.gaps, evidence: response.evidence }
+    },
+  }]))
+  const outcome = rebuildOwnershipUpdate({ ...request, recipes, evaluate: (input) => {
+    const producer = produced.get(input.key)
+    if (producer === undefined) return hold("ownership-missing", [input.key, "native-rebuild-producer"])
+    const dossier = original({ kind: "ownership-native-rebuild-candidate", version: 1, campaign: control.campaign,
+      baseline: request.manifest, candidate_revision: control.implementationRevision, nativeControl: request.nativeControl,
+      contract: request.contract, ...input, producer })
+    const document = request.store.put({ kind: "ownership-body", version: 1, bytes: Array.from(dossier.bytes) })
+    const selected = request.judgments.filter((review) => {
+      const decision = decode(review.response)
+      return object(decision) && decision.reviewed_manifest_sha256 === dossier.sha256
+    })
+    if (selected.length === 0) {
+      paused = { kind: "pending-review", key: input.key, document, sha256: dossier.sha256 }
+      return hold("ownership-review", [input.key, document, "native-pair-required"])
+    }
+    if (!sameSet(selected.map((review) => review.role), ["J1", "J2"])) return hold("ownership-review", [input.key, "native-rebuild-pair"])
+    const reviews: Hash[] = []
+    for (const review of selected) {
+      const appointed = control.reviewers[review.role]
+      const originals = preserve(request, review)
+      const prompt = decode(review.request)
+      const decision = decode(review.response)
+      const receipt = decode(review.receipt)
+      events.push({ step: "judge-originals", key: input.key, role: review.role, originals: originals ?? null })
+      if (originals === undefined || review.reviewer !== appointed.id || review.epoch !== appointed.epoch ||
+        !object(prompt) || prompt.kind !== "ownership-native-judge-request" || prompt.version !== 1 ||
+        prompt.campaign !== control.campaign || prompt.judge_role !== review.role || prompt.reviewer !== appointed.id || prompt.epoch !== appointed.epoch ||
+        prompt.reviewed_manifest_sha256 !== dossier.sha256 || prompt.candidate_revision !== control.implementationRevision ||
+        !object(decision) || !sameSet(Object.keys(decision), ["campaign", "judge_role", "reviewed_manifest_sha256", "candidate_revision", "decision", "criteria", "critical_findings", "permitted_unknowns", "optional_suggestions"]) ||
+        decision.campaign !== control.campaign || decision.judge_role !== review.role || decision.reviewed_manifest_sha256 !== dossier.sha256 ||
+        decision.candidate_revision !== control.implementationRevision || decision.decision !== "PASS" ||
+        !Array.isArray(decision.criteria) || !decision.criteria.every(object) || !sameSet(decision.criteria.map((criterion) => String(criterion.id)), contract.criteria) ||
+        decision.criteria.some((criterion) => criterion.verdict !== "PASS" || !nonempty(criterion.reason) || !strings(criterion.evidence) || criterion.evidence.length === 0) ||
+        !Array.isArray(decision.critical_findings) || decision.critical_findings.length !== 0 || !Array.isArray(decision.permitted_unknowns) || !Array.isArray(decision.optional_suggestions) ||
+        !object(receipt) || receipt.kind !== "ownership-native-transport-receipt" || receipt.version !== 1 || receipt.adapter !== "nativeChatGPT" ||
+        receipt.campaign !== control.campaign || receipt.completion !== "COMPLETED" || receipt.agentId !== appointed.id || receipt.epoch !== appointed.epoch ||
+        receipt.requestSha256 !== review.request.sha256 || receipt.responseSha256 !== review.response.sha256 ||
+        !text(receipt.sessionId) || !text(receipt.attemptId) || !reference(receipt.reservation))
+        return hold("ownership-review", [input.key, review.role, "native-rebuild-decision"])
+      const bound: OwnershipReview = { kind: "ownership-review", version: 1, reviewer: appointed.id,
+        contract: request.contract, inputs: id({ inputs: input.inputs, dependencies: input.dependencies }), result: input.result,
+        criteria: contract.criteria, verdict: "pass",
+        provenance: `nativeChatGPT ${review.role} epoch ${appointed.epoch}; rebuild dossier ${document}; original decision ${originals.response}; original request ${originals.request}; transport receipt ${originals.receipt}` }
+      reviews.push(request.store.put(bound))
+    }
+    return { kind: "ready", reviews }
+  } })
+  return finish(paused ?? outcome)
+}
+
+/** Freeze the recipe contract separately from observed implementation versions. A recipe edit
+ * changes its own input version; it must not invalidate unrelated recipes through a global roster. */
+export function nativeRebuildRecipesIdentity(recipes: readonly Recipe[]): Hash {
+  return id(recipes.map((recipe) => ({ key: recipe.key, recipeInputKey: recipe.recipeInputKey,
+    declaredInputs: recipe.declaredInputs, mandatoryInputs: recipe.mandatoryInputs ?? recipe.declaredInputs,
+    required: recipe.required, task: recipe.task })))
+}
+
+function isControl(value: unknown): value is Control {
+  return object(value) && value.kind === "ownership-native-rebuild-control" && value.version === 1 && value.campaign === "20261111-v1" &&
+    text(value.scope) && hash(value.contract) && hash(value.recipeContractsHash) &&
+    [value.sourceRevision, value.protocolRevision, value.implementationRevision].every((revision) => typeof revision === "string" && /^[0-9a-f]{40}$/.test(revision)) &&
+    object(value.reviewers) && sameSet(Object.keys(value.reviewers), ["J1", "J2"]) &&
+    Object.values(value.reviewers).every((reviewer) => object(reviewer) && text(reviewer.id) && text(reviewer.epoch)) &&
+    object(value.reviewers.J1) && object(value.reviewers.J2) && value.reviewers.J1.id !== value.reviewers.J2.id
+}
+function preserve(request: NativeOwnershipRebuildRequest, submission: { readonly request: Original; readonly response: Original; readonly receipt: Original }): Preserved | undefined {
+  if ([submission.request, submission.response, submission.receipt].some((data) => !hash(data.sha256) || data.bytes.length === 0 || sha256(data.bytes) !== data.sha256)) return undefined
+  const put = (data: Original) => request.store.put({ kind: "ownership-body", version: 1, bytes: Array.from(data.bytes) })
+  return { request: put(submission.request), response: put(submission.response), receipt: put(submission.receipt) }
+}
+function transport(value: unknown, submission: NativeOwnershipSubmission, campaign: string): boolean {
+  return object(value) && value.kind === "ownership-native-transport-receipt" && value.version === 1 && value.adapter === "nativeChatGPT" &&
+    value.campaign === campaign && value.completion === "COMPLETED" && value.sessionId === submission.sessionId && value.agentId === submission.agentId &&
+    value.attemptId === submission.attemptId && value.requestSha256 === submission.request.sha256 && value.responseSha256 === submission.response.sha256 && reference(value.reservation)
+}
+function decode(value: Original): unknown {
+  if (!hash(value.sha256) || value.bytes.length === 0 || sha256(value.bytes) !== value.sha256) return undefined
+  try { return JSON.parse(new TextDecoder("utf-8", { fatal: true, ignoreBOM: true }).decode(value.bytes)) } catch { return undefined }
+}
+const encode = (value: string) => new TextEncoder().encode(value)
+const sha256 = (bytes: Uint8Array) => createHash("sha256").update(bytes).digest("hex")
+const original = (value: unknown) => { const bytes = encode(JSON.stringify(value, null, 2) + "\n"); return { bytes, sha256: sha256(bytes) } }
+const sourceVersion = (bytes: Uint8Array) => id({ kind: "ownership-source", version: 1, bytes: Array.from(bytes) })
+const object = (value: unknown): value is Record<string, unknown> => typeof value === "object" && value !== null && !Array.isArray(value)
+const nonempty = (value: unknown): value is string => typeof value === "string" && value.trim().length > 0
+const text = (value: unknown): value is string => nonempty(value) && value.normalize("NFC") === value
+const strings = (value: unknown): value is readonly string[] => Array.isArray(value) && value.every(text)
+const hash = (value: unknown): value is Hash => typeof value === "string" && /^[0-9a-f]{64}$/.test(value)
+const reference = (value: unknown) => object(value) && typeof value.commit === "string" && /^[0-9a-f]{40}$/.test(value.commit) && text(value.path) && hash(value.sha256)
+const sameSet = (left: readonly string[], right: readonly string[]) => left.length === right.length && new Set(left).size === left.length && new Set(right).size === right.length && left.every((value) => right.includes(value))
+const hold = (reason: OwnershipRefusal["reason"], evidence: readonly string[]): OwnershipRefusal => ({ kind: "hold", reason, evidence })
+const blocked = () => ({ body: "", validity: "blocked" as const, gaps: ["native transport is incomplete; inspect the durable request or refusal"] })
