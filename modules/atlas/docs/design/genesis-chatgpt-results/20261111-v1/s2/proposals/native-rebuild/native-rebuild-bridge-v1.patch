+import { describe, expect, test } from "vitest"
+import { readOwnership } from "@atlas/knowledge"
+import { rebuildNativeOwnership } from "../src/ownership-native-rebuild.js"
+import { bytes } from "./fixtures/ownership-native-fixture.js"
+import { rebuildFixture } from "./fixtures/ownership-native-rebuild-fixture.js"
+
+function changedFixture() {
+  const fixture = rebuildFixture()
+  fixture.files.set(fixture.source.input.key, bytes("export const value = 2\n"))
+  const first = rebuildNativeOwnership(fixture.request)
+  if (first.outcome.kind !== "pending-production") throw new Error(JSON.stringify(first.outcome))
+  const submission = fixture.submission(first.outcome)
+  const request = { ...fixture.request, submissions: [submission] }
+  return { ...fixture, request, first, submission }
+}
+
+describe("native rebuild bridge; synthetic mechanical CI only", () => {
+  test("NR-01 identical valid baseline uses the real executor cache with no recipe calls", () => {
+    const fixture = rebuildFixture()
+    const result = rebuildNativeOwnership(fixture.request)
+    expect(result.outcome).toEqual({ kind: "candidate", manifest: fixture.request.manifest, affected: [], calls: [] })
+    expect(fixture.store.get(result.executionReceipt)).toMatchObject({ events: [], modelDispatchesByThisAdapter: 0 })
+  })
+
+  test("NR-02 source change creates a preserved production request, not a candidate", () => {
+    const fixture = changedFixture()
+    expect(fixture.first.outcome).toMatchObject({ kind: "pending-production", key: fixture.key })
+    const prompt = JSON.parse(new TextDecoder().decode(fixture.submission.request.bytes))
+    expect(prompt.inputs).toContainEqual({ key: fixture.source.input.key, version: fixture.current(fixture.source.input.key) })
+    expect(prompt.capture.find((entry: { key: string }) => entry.key === fixture.source.input.key).bytes).toBeTruthy()
+  })
+
+  test("NR-03 original producer bytes pause for both current judgments; exact replay completes", () => {
+    const fixture = changedFixture()
+    const pending = rebuildNativeOwnership(fixture.request)
+    if (pending.outcome.kind !== "pending-review") throw new Error(JSON.stringify(pending.outcome))
+    const judgments = [fixture.judgment("J1", pending.outcome), fixture.judgment("J2", pending.outcome)]
+    const complete = rebuildNativeOwnership({ ...fixture.request, judgments })
+    if (complete.outcome.kind !== "candidate") throw new Error(JSON.stringify(complete.outcome))
+    expect(complete.outcome.calls).toEqual([fixture.key])
+    expect(readOwnership(fixture.store, complete.outcome.manifest, { scope: fixture.request.scope, key: fixture.key, maxBytes: 4096 }, fixture.current))
+      .toMatchObject({ kind: "ready", body: "Updated synthetic body\n" })
+    const replay = rebuildNativeOwnership({ ...fixture.request, manifest: complete.outcome.manifest, submissions: [], judgments: [] })
+    expect(replay.outcome).toEqual({ kind: "candidate", manifest: complete.outcome.manifest, affected: [], calls: [] })
+  })
+
+  test("NR-04 a veto is preserved and cannot produce a rebuilt manifest", () => {
+    const fixture = changedFixture()
+    const pending = rebuildNativeOwnership(fixture.request)
+    if (pending.outcome.kind !== "pending-review") throw new Error(JSON.stringify(pending.outcome))
+    const result = rebuildNativeOwnership({ ...fixture.request, judgments: [fixture.judgment("J1", pending.outcome), fixture.judgment("J2", pending.outcome, { decision: "FIX-FIRST" })] })
+    expect(result.outcome).toMatchObject({ kind: "hold", reason: "ownership-review" })
+    expect(fixture.store.get(result.executionReceipt)).toMatchObject({ events: expect.arrayContaining([expect.objectContaining({ step: "judge-originals", role: "J2" })]) })
+  })
+
+  test("NR-05 an appointed judge cannot supply producer output", () => {
+    const fixture = changedFixture()
+    const result = rebuildNativeOwnership({ ...fixture.request, submissions: [{ ...fixture.submission, agentId: fixture.plan.reviewers.J1.id }] })
+    expect(result.outcome).toMatchObject({ kind: "hold", reason: "malformed-ownership" })
+  })
+
+  test("NR-06 dishonest captured bytes cannot bind a real observation", () => {
+    const fixture = changedFixture()
+    const result = rebuildNativeOwnership({ ...fixture.request, readCapturedBytes: (key) => key === fixture.source.input.key ? bytes("different captured bytes") : fixture.files.get(key) })
+    expect(result.outcome).toMatchObject({ kind: "hold", reason: "ownership-integrity" })
+  })
+
+  test("NR-07 changed recipes or a new roster require a newly bound control", () => {
+    const fixture = rebuildFixture()
+    const recipes = fixture.request.recipes.map((recipe) => ({ ...recipe, task: "unapproved altered task" }))
+    expect(rebuildNativeOwnership({ ...fixture.request, recipes }).outcome).toMatchObject({ kind: "hold", reason: "malformed-ownership" })
+    const nativeControlBytes = bytes(new TextDecoder().decode(fixture.request.nativeControlBytes).replace("fixture-current-judge-1", "forged-current-judge-1"))
+    expect(rebuildNativeOwnership({ ...fixture.request, nativeControlBytes }).outcome).toMatchObject({ kind: "hold", reason: "malformed-ownership" })
+  })
+})
diff --git a/modules/atlas/scripts/ownership-native-rebuild.ts b/modules/atlas/scripts/ownership-native-rebuild.ts
