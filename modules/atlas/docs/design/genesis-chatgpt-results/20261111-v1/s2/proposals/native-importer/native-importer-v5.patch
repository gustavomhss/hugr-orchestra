+++ b/modules/atlas/packages/adapter-io/test/ownership-native-import.test.ts
@@ -0,0 +1,121 @@
+import { describe, expect, test } from "vitest"
+import type { Hash } from "@atlas/contracts"
+import { readOwnership } from "@atlas/knowledge"
+import type { OwnershipArtifact, OwnershipBody, OwnershipManifest, OwnershipResult } from "@atlas/knowledge"
+import { bindNativeOwnershipReviews, prepareNativeOwnership } from "../src/ownership-native-import.js"
+import type { NativeOwnershipCandidate } from "../src/ownership-native-import.js"
+import { bytes, candidateResult, nativeFixture, sha256 } from "./fixtures/ownership-native-fixture.js"
+
+const prepare = (fixture: ReturnType<typeof nativeFixture>, body?: string, changes?: Record<string, unknown>) => {
+  const candidate = prepareNativeOwnership({ ...fixture, submissions: [fixture.submission(body, changes)] })
+  if (candidate.kind === "hold") throw new Error(JSON.stringify(candidate))
+  return candidate
+}
+const pair = (fixture: ReturnType<typeof nativeFixture>, candidate: NativeOwnershipCandidate) =>
+  [fixture.judgment("J1", candidate), fixture.judgment("J2", candidate)]
+
+describe("native ownership import mechanical conformance; no real judge or model dispatch", () => {
+  test("NI-01 private preparation retains original body bytes, including non-NFC text", () => {
+    const fixture = nativeFixture()
+    const text = "Cafe\u0301: original byte identity\n"
+    const candidate = prepare(fixture, text)
+    const result = candidateResult(fixture.store, candidate)
+    const body = fixture.store.get(result.body) as OwnershipBody
+    expect(new Uint8Array(body.bytes)).toEqual(bytes(text))
+    expect(new Uint8Array(body.bytes)).not.toEqual(bytes(text.normalize("NFC")))
+    expect(fixture.store.get(candidate.candidate)).toMatchObject({ kind: "ownership-native-candidate" })
+    expect(candidate).not.toHaveProperty("manifest")
+  })
+
+  test("NI-02 a missing, duplicate or wrong-candidate judge cannot bind a manifest", () => {
+    const fixture = nativeFixture()
+    const candidate = prepare(fixture)
+    expect(bindNativeOwnershipReviews({ ...fixture, candidate, reviews: [] })).toMatchObject({ kind: "hold", reason: "ownership-review" })
+    const judge = fixture.judgment("J1", candidate)
+    expect(bindNativeOwnershipReviews({ ...fixture, candidate, reviews: [judge, judge] })).toMatchObject({ kind: "hold", reason: "ownership-review" })
+    const wrong = fixture.judgment("J2", candidate, { reviewed_manifest_sha256: "0".repeat(64) })
+    expect(bindNativeOwnershipReviews({ ...fixture, candidate, reviews: [judge, wrong] })).toMatchObject({ kind: "hold", reason: "ownership-review" })
+  })
+
+  test("NI-03 two bound mechanical decisions produce a validated private reader manifest", () => {
+    const fixture = nativeFixture()
+    const candidate = prepare(fixture)
+    const imported = bindNativeOwnershipReviews({ ...fixture, candidate, reviews: pair(fixture, candidate) })
+    if (imported.kind === "hold") throw new Error(JSON.stringify(imported))
+    const read = readOwnership(fixture.store, imported.manifest, { scope: fixture.plan.scope, key: fixture.key, maxBytes: 4096 }, fixture.current)
+    expect(read).toMatchObject({ kind: "ready", historical: false, knowledge: { authority: { basis: "synthetic fixture only" } } })
+    expect(fixture.store.get(imported.importReceipt)).toMatchObject({ kind: "ownership-native-import-receipt" })
+    // This reader is the private CAS validator. No host runtime, policy, projection or publication is constructed.
+  })
+
+  test("NI-04 identical prose with changed authority invalidates old decisions", () => {
+    const fixture = nativeFixture()
+    const previous = prepare(fixture, "unchanged prose\n")
+    const next = prepare(fixture, "unchanged prose\n", { authorityBasis: "a different synthetic authority" })
+    const previousResult = candidateResult(fixture.store, previous)
+    const nextResult = candidateResult(fixture.store, next)
+    expect(nextResult.body).toBe(previousResult.body)
+    expect(next.candidate).not.toBe(previous.candidate)
+    expect(bindNativeOwnershipReviews({ ...fixture, candidate: next, reviews: pair(fixture, previous) })).toMatchObject({ kind: "hold", reason: "ownership-review" })
+  })
+
+  test("NI-05 rehashed candidate forgery cannot replace the preserved producer result", () => {
+    const fixture = nativeFixture()
+    const original = prepare(fixture)
+    const originalDocument = fixture.store.get(original.candidate) as { pending: readonly { result: Hash }[] }
+    const alteredResult: OwnershipResult = { ...candidateResult(fixture.store, original), gaps: [] }
+    const forged = { ...originalDocument, pending: originalDocument.pending.map((entry) => ({ ...entry, result: fixture.store.put(alteredResult) })) }
+    const document = bytes(JSON.stringify(forged, null, 2) + "\n")
+    const candidate: NativeOwnershipCandidate = {
+      kind: "candidate", candidate: fixture.store.put(forged),
+      reviewDocument: fixture.store.put({ kind: "ownership-body", version: 1, bytes: Array.from(document) }),
+      reviewedManifestSha256: sha256(document),
+    }
+    expect(bindNativeOwnershipReviews({ ...fixture, candidate, reviews: pair(fixture, candidate) })).toMatchObject({ kind: "hold", reason: "ownership-integrity", evidence: ["native-original-result-binding"] })
+  })
+
+  test("NI-06 source drift before binding rejects the captured candidate", () => {
+    const fixture = nativeFixture()
+    const candidate = prepare(fixture)
+    fixture.files.set(fixture.source.input.key, bytes("export const value = 2\n"))
+    expect(bindNativeOwnershipReviews({ ...fixture, candidate, reviews: pair(fixture, candidate) })).toMatchObject({ kind: "hold", reason: "ownership-input-changed" })
+  })
+
+  test("NI-07 the producer cannot occupy either current judge identity", () => {
+    const fixture = nativeFixture()
+    const submission = { ...fixture.submission(), agentId: fixture.plan.reviewers.J1.id }
+    expect(prepareNativeOwnership({ ...fixture, submissions: [submission] })).toMatchObject({ kind: "hold", reason: "ownership-review", evidence: [fixture.key, "native-producer-cannot-review-own-output"] })
+  })
+
+  test("NI-08 L2 preserves accepted L1 and requires the exact preceding import receipt", () => {
+    const first = nativeFixture()
+    const firstCandidate = prepare(first)
+    const accepted = bindNativeOwnershipReviews({ ...first, candidate: firstCandidate, reviews: pair(first, firstCandidate) })
+    if (accepted.kind === "hold") throw new Error(JSON.stringify(accepted))
+    const previous = first.store.get(accepted.manifest) as OwnershipManifest
+    const firstArtifact = first.store.get(previous.entries[0]!.artifact) as OwnershipArtifact
+    const second = nativeFixture({ files: first.files, store: first.store, previous: { ...accepted, key: first.key, result: firstArtifact.result } })
+    const secondCandidate = prepare(second)
+    const imported = bindNativeOwnershipReviews({ ...second, candidate: secondCandidate, reviews: pair(second, secondCandidate) })
+    if (imported.kind === "hold") throw new Error(JSON.stringify(imported))
+    const manifest = first.store.get(imported.manifest) as OwnershipManifest
+    expect(manifest.entries.map((entry) => entry.key)).toEqual([first.key, second.key])
+    expect(manifest.entries[0]).toEqual(previous.entries[0])
+    const invalidPlan = { ...second.plan, previousImportReceipt: first.store.put({ kind: "synthetic-unrelated-receipt" }) }
+    expect(prepareNativeOwnership({ ...second, plan: invalidPlan, submissions: [second.submission()] })).toMatchObject({ kind: "hold", reason: "ownership-review" })
+  })
+
+  test("NI-09 a compact whole-scope control binds the complete entries, keys and roots", () => {
+    const fixture = nativeFixture({ compactScope: true })
+    const candidate = prepare(fixture)
+    expect(bindNativeOwnershipReviews({ ...fixture, candidate, reviews: pair(fixture, candidate) })).toMatchObject({ kind: "candidate" })
+    const scope = fixture.plan.controls.find((control) => control.role === "scope")!
+    expect(fixture.files.get(scope.input.key)!.byteLength).toBeLessThan(256000)
+  })
+
+  test("NI-10 a compact control rejects an entry changed without a new frozen scope", () => {
+    const fixture = nativeFixture({ compactScope: true })
+    const plan = { ...fixture.plan, entries: fixture.plan.entries.map((entry) => ({ ...entry, title: "unapproved altered title" })) }
