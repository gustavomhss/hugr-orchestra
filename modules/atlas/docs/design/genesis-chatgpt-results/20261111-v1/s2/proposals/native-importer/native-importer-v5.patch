+// Private nativeChatGPT candidate import. This command never emits or changes serving projection.
+import { createHash } from "node:crypto"
+import { lstatSync, readFileSync, realpathSync, writeFileSync } from "node:fs"
+import { dirname, join, resolve } from "node:path"
+import { asHash, id } from "@atlas/kernel"
+import { isOwnershipContract } from "@atlas/knowledge"
+import { isContainedIn } from "../packages/adapter-io/src/containment.js"
+import { CAS_REL } from "../packages/adapter-io/src/okf-store.js"
+import { headSha } from "../packages/adapter-io/src/run-git.js"
+import { ownershipInput } from "../packages/adapter-io/src/ownership-input.js"
+import { createDiskStore } from "../packages/adapter-io/src/store.js"
+import { bindNativeOwnershipReviews, isNativeOwnershipPlan, prepareNativeOwnership } from "../packages/adapter-io/src/ownership-native-import.js"
+import type { NativeOwnershipCandidate, NativeOwnershipJudgeSubmission, NativeOwnershipSubmission } from "../packages/adapter-io/src/ownership-native-import.js"
+
+import type { HistoricalOwnershipSubmission } from "../packages/adapter-io/src/ownership-historical-import.js"
+
+const sha256 = (bytes: Uint8Array) => createHash("sha256").update(bytes).digest("hex")
+const object = (value: unknown): value is Record<string, unknown> => typeof value === "object" && value !== null && !Array.isArray(value)
+const text = (value: unknown): value is string => typeof value === "string" && value.trim().length > 0
+const hash = (value: unknown): value is string => typeof value === "string" && /^[0-9a-f]{64}$/.test(value)
+
+const mode = Bun.argv[2]
+if (!Bun.argv[3] || !Bun.argv[4] || !Bun.argv[5] || mode !== "prepare" && mode !== "bind")
+  throw new Error("Usage: ownership-native-import.ts prepare|bind <isolated-candidate-repo> <bundle.json> <new-result.json>")
+const repo = realpathSync(resolve(Bun.argv[3]))
+if (realpathSync(dirname(import.meta.path)) !== realpathSync(join(repo, "modules", "atlas", "scripts")))
+  throw new Error("native-code-root-mismatch: execute the importer from the target candidate checkout")
+const bundlePath = realpathSync(resolve(Bun.argv[4]))
+const root = dirname(bundlePath)
+const bundle: unknown = JSON.parse(readFileSync(bundlePath, "utf8"))
+if (!object(bundle) || bundle.kind !== "ownership-native-bundle" || bundle.version !== 1)
+  throw new Error("native-bundle-malformed")
+const planOriginal = original(bundle.plan)
+const plan: unknown = JSON.parse(new TextDecoder("utf-8", { fatal: true, ignoreBOM: true }).decode(planOriginal.bytes))
+if (!isNativeOwnershipPlan(plan)) throw new Error("native-plan-malformed")
+if (headSha(repo) !== plan.implementationRevision) throw new Error("native-implementation-revision-mismatch")
+const recipe = plan.controls.find((control) => control.role === "recipe")
+if (recipe?.input.key !== "file:modules/atlas/scripts/ownership-native-import.ts" || sha256(readFileSync(import.meta.path)) !== recipe.origin.sha256)
+  throw new Error("native-executing-recipe-mismatch")
+const implementationKey = "file:modules/atlas/packages/adapter-io/src/ownership-native-import.ts"
+if (plan.entries.some((entry) => !entry.inputs.some((input) => input.key === implementationKey && input.version === ownershipInput(repo, implementationKey))))
+  throw new Error("native-importer-implementation-unbound")
+const historicalKey = "file:modules/atlas/packages/adapter-io/src/ownership-historical-import.ts"
+if (plan.entries.some((entry) => entry.reuse !== undefined && !entry.inputs.some((input) => input.key === historicalKey && input.version === ownershipInput(repo, historicalKey))))
+  throw new Error("historical-importer-implementation-unbound")
+const sourceCaptureKeys = ["file:modules/atlas/packages/adapter-io/src/ownership-source-capture.ts",
+  "file:modules/atlas/packages/adapter-io/src/ownership-input.ts", "file:modules/atlas/packages/adapter-io/src/run-git.ts"]
+if (plan.entries.some((entry) => entry.inputs.some((input) => ["blob:", "link:", "retained:", "source-members:"].some((prefix) => input.key.startsWith(prefix))) &&
+  sourceCaptureKeys.some((key) => !entry.inputs.some((input) => input.key === key && input.version === ownershipInput(repo, key)))))
+  throw new Error("native-source-capture-implementation-unbound")
+const store = createDiskStore(join(repo, CAS_REL))
+const readControlBytes = (key: string): Uint8Array | undefined => {
+  if (!key.startsWith("file:")) return undefined
+  try { return read(repo, key.slice(5)) } catch { return undefined }
+}
+const contractControl = plan.controls.find((control) => control.role === "contract")
+const contractBytes = contractControl === undefined ? undefined : readControlBytes(contractControl.input.key)
+if (contractBytes === undefined || sha256(contractBytes) !== contractControl?.origin.sha256) throw new Error("native-contract-control-unavailable")
+const contract: unknown = JSON.parse(new TextDecoder("utf-8", { fatal: true, ignoreBOM: true }).decode(contractBytes))
+if (!isOwnershipContract(contract) || id(contract) !== plan.contract || store.put(contract) !== plan.contract)
+  throw new Error("native-contract-control-mismatch")
+const access = { store, current: (key: string) => ownershipInput(repo, key), readControlBytes, plan }
+const result = mode === "prepare"
+  ? prepareNativeOwnership({ ...access, submissions: submissions(bundle.submissions), historicalSubmissions: historicalSubmissions(bundle.historical) })
+  : bindNativeOwnershipReviews({ ...access, candidate: candidate(bundle.candidate), reviews: reviews(bundle.reviews) })
+writeFileSync(resolve(Bun.argv[5]), JSON.stringify(result, null, 2) + "\n", { flag: "wx" })
+console.log(JSON.stringify(result))
+process.exitCode = result.kind === "hold" ? 2 : 0
+
+function submissions(value: unknown): readonly NativeOwnershipSubmission[] {
+  if (!Array.isArray(value)) throw new Error("native-submissions-malformed")
+  return value.map((entry) => {
+    if (!object(entry) || !text(entry.key) || !text(entry.sessionId) || !text(entry.agentId) || !text(entry.attemptId))
+      throw new Error("native-submission-identity-malformed")
+    return { key: entry.key, sessionId: entry.sessionId, agentId: entry.agentId, attemptId: entry.attemptId, request: original(entry.request), response: original(entry.response), receipt: original(entry.receipt) }
+  })
+}
+
+function historicalSubmissions(value: unknown): readonly HistoricalOwnershipSubmission[] {
+  if (value === undefined) return []
+  if (!Array.isArray(value)) throw new Error("historical-submissions-malformed")
+  return value.map((entry) => {
+    if (!object(entry) || !text(entry.key) || !Array.isArray(entry.originals)) throw new Error("historical-submission-malformed")
+    const originals = entry.originals.map((item) => {
+      if (!object(item) || !text(item.role) || !["body", "manifest", "acceptance", "source-freeze", "review-1", "review-2", "original-body", "correction", "prefreeze", "historical-approvals"].includes(item.role))
+        throw new Error("historical-original-role-malformed")
+      return { role: item.role as HistoricalOwnershipSubmission["originals"][number]["role"], original: original(item.original) }
+    })
+    return { key: entry.key, originals }
+  })
+}
+
+function reviews(value: unknown): readonly NativeOwnershipJudgeSubmission[] {
+  if (!Array.isArray(value)) throw new Error("native-reviews-malformed")
+  return value.map((entry) => {
+    if (!object(entry) || entry.role !== "J1" && entry.role !== "J2" || !text(entry.reviewer) || !text(entry.epoch))
+      throw new Error("native-review-identity-malformed")
+    return { role: entry.role, reviewer: entry.reviewer, epoch: entry.epoch, request: original(entry.request), response: original(entry.response), receipt: original(entry.receipt) }
+  })
+}
+
+function candidate(value: unknown): NativeOwnershipCandidate {
+  if (!object(value) || value.kind !== "candidate" || !hash(value.candidate) || !hash(value.reviewDocument) || !hash(value.reviewedManifestSha256))
+    throw new Error("native-candidate-ref-malformed")
+  // This value is parsed again and integrity checked against the CAS inside the binder.
+  return { kind: "candidate", candidate: asHash(value.candidate), reviewDocument: asHash(value.reviewDocument), reviewedManifestSha256: value.reviewedManifestSha256 }
+}
+
+function original(value: unknown) {
+  if (!object(value) || !text(value.path) || !hash(value.sha256)) throw new Error("native-original-ref-malformed")
+  const bytes = read(root, value.path)
+  if (sha256(bytes) !== value.sha256) throw new Error("native-original-digest-mismatch")
+  return { bytes, sha256: value.sha256 }
+}
+
+function read(base: string, path: string): Uint8Array {
+  if (path.startsWith("/") || path.includes("\\") || /^[A-Za-z]:/.test(path) || path.split("/").some((part) => !part || part === "." || part === ".." || part === ".git" || part === ".atlas"))
+    throw new Error("native-input-path-refused")
+  const file = realpathSync(resolve(base, path))
+  if (!isContainedIn(base, file)) throw new Error("native-input-path-outside-root")
+  const stat = lstatSync(file)
+  if (!stat.isFile() || stat.size > 8 * 1024 * 1024) throw new Error("native-input-file-refused")
+  return new Uint8Array(readFileSync(file))
+}
