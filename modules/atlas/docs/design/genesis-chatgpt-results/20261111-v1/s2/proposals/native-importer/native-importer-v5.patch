+    !object(value.roots) || Object.keys(value.roots).length === 0) return false
+  const keys = value.requiredKeys
+  return Object.entries(value.roots).every(([need, key]) => isOwnershipNeed(need) && text(key) && keys.includes(key))
+}
diff --git a/modules/atlas/packages/adapter-io/test/fixtures/ownership-native-fixture.ts b/modules/atlas/packages/adapter-io/test/fixtures/ownership-native-fixture.ts
new file mode 100644
--- /dev/null
+++ b/modules/atlas/packages/adapter-io/test/fixtures/ownership-native-fixture.ts
@@ -0,0 +1,133 @@
+// Synthetic transport records for mechanical CI checks only. These are never campaign evidence.
+import { createHash } from "node:crypto"
+import { createStore, id } from "@atlas/kernel"
+import type { Hash } from "@atlas/contracts"
+import type { StoreApi } from "@atlas/kernel"
+import type { OwnershipInput, OwnershipManifest, OwnershipResult } from "@atlas/knowledge"
+import type { NativeOwnershipCandidate, NativeOwnershipJudgeSubmission, NativeOwnershipPlan, NativeOwnershipSubmission } from "../../src/ownership-native-import.js"
+import type { HistoricalOwnershipSubmission, HistoricalReuseSpec } from "../../src/ownership-historical-import.js"
+
+export const bytes = (value: string) => new TextEncoder().encode(value)
+export const sha256 = (value: Uint8Array) => createHash("sha256").update(value).digest("hex")
+export const raw = (value: unknown) => {
+  const data = bytes(JSON.stringify(value, null, 2) + "\n")
+  return { bytes: data, sha256: sha256(data) }
+}
+export const sourceVersion = (data: Uint8Array) => id({ kind: "ownership-source", version: 1, bytes: Array.from(data) })
+const revision = "1".repeat(40)
+const reservation = { commit: revision, path: "fixture/reservation.json", sha256: "a".repeat(64) }
+
+export function file(files: Map<string, Uint8Array>, path: string, data: Uint8Array) {
+  const key = `file:${path}`
+  files.set(key, data)
+  return { origin: { commit: revision, path, sha256: sha256(data) }, input: { key, version: sourceVersion(data) } }
+}
+
+export function nativeFixture(options: {
+  files?: Map<string, Uint8Array>; store?: StoreApi; inputs?: readonly OwnershipInput[]; reuse?: HistoricalReuseSpec; compactScope?: boolean
+  previous?: { manifest: Hash; importReceipt: Hash; key: string; result: Hash }
+} = {}) {
+  const store = options.store ?? createStore()
+  const files = options.files ?? new Map<string, Uint8Array>()
+  const source = file(files, "fixture/source.ts", bytes("export const value = 1\n"))
+  const contractObject = { kind: "ownership-contract", version: 1, criteria: ["AC-04", "CC-3"] }
+  const contract = store.put(contractObject)
+  const reviewers = { J1: { id: "fixture-current-judge-1", epoch: "fixture-epoch" }, J2: { id: "fixture-current-judge-2", epoch: "fixture-epoch" } }
+  const layer = options.previous === undefined ? 1 : 2
+  const key = `fixture-L${layer}`
+  const entry = {
+    key, title: "Synthetic CI ownership", need: "evidence" as const, inputs: options.inputs ?? [source.input],
+    dependencies: options.previous === undefined ? [] : [{ key: options.previous.key, result: options.previous.result }],
+    navigation: [], ...(options.reuse === undefined ? {} : { reuse: options.reuse }),
+  }
+  const previous = options.previous === undefined ? undefined : store.get(options.previous.manifest) as OwnershipManifest
+  const requiredKeys = [...(previous?.entries.map((item) => item.key) ?? []), key]
+  const roots = { evidence: key }
+  const scope = "synthetic-native-ci"
+  const controls: NativeOwnershipPlan["controls"][number][] = []
+  const control = (role: NativeOwnershipPlan["controls"][number]["role"], value: unknown) => {
+    const binding = file(files, `fixture/controls/L${layer}/${role}.json`, raw(value).bytes)
+    controls.push({ role, ...binding })
+  }
+  control("scope", { kind: "ownership-native-scope", campaign: "20261111-v1", scope, layer, sourceRevision: revision, protocolRevision: revision,
+    ...(options.compactScope ? { version: 2, entriesHash: id([entry]), requiredKeysHash: id(requiredKeys), rootsHash: id(roots) } : { version: 1, entries: [entry], requiredKeys, roots }) })
+  control("criteria", { fixture: true, criteria: contractObject.criteria })
+  control("contract", contractObject)
+  control("envelope", { fixture: true, nativeCallsAllowed: 0 })
+  control("recipe", { fixture: true, recipe: "mechanical transport only" })
+  control("reviewers", { kind: "ownership-native-reviewers", version: 1, campaign: "20261111-v1", reviewers })
+  if (options.previous !== undefined) control("previous-layer", {
+    kind: "ownership-native-layer-acceptance", version: 1, campaign: "20261111-v1", scope, layer: 1,
+    manifest: options.previous.manifest, importReceipt: options.previous.importReceipt, decision: "ACCEPTED_SCOPED", reviewers,
+  })
+  const plan: NativeOwnershipPlan = {
+    kind: "ownership-native-plan", version: 1, campaign: "20261111-v1", scope, layer,
+    sourceRevision: revision, protocolRevision: revision, implementationRevision: revision, controls, contract, reviewers,
+    previousManifest: options.previous?.manifest ?? null, previousImportReceipt: options.previous?.importReceipt ?? null,
+    entries: [entry], requiredKeys, roots,
+  }
+  const current = (input: string) => { const data = files.get(input); return data === undefined ? undefined : sourceVersion(data) }
+  const access = { store, plan, current, readControlBytes: (input: string) => files.get(input) }
+  const submission = (body = "Cafe\u0301: synthetic evidence only\n", changes: Record<string, unknown> = {}): NativeOwnershipSubmission => {
+    const inputs = [...new Map([...controls.map((item) => item.input), ...entry.inputs].map((input) => [input.key, input])).values()].sort((a, b) => a.key < b.key ? -1 : 1)
+    const request = raw({ kind: "ownership-native-request", version: 1, plan: id(plan), key, inputs, dependencies: entry.dependencies, task: "Synthetic transport CI; no native agent dispatch" })
+    const response = raw({ kind: "ownership-native-response", version: 1, requestSha256: request.sha256, key, body, authorityBasis: "synthetic fixture only", validity: "supported", gaps: ["not semantic acceptance"], evidence: ["synthetic fixture"], ...changes })
+    const identity = { key, sessionId: "fixture-s2", agentId: "fixture-producer", attemptId: "fixture-attempt" }
+    const receipt = raw({ kind: "ownership-native-transport-receipt", version: 1, adapter: "nativeChatGPT", campaign: plan.campaign, completion: "COMPLETED", ...identity, requestSha256: request.sha256, responseSha256: response.sha256, reservation })
+    return { ...identity, request, response, receipt }
+  }
+  const judgment = (role: "J1" | "J2", candidate: NativeOwnershipCandidate, changes: Record<string, unknown> = {}): NativeOwnershipJudgeSubmission => {
+    const appointed = reviewers[role]
+    const request = raw({ kind: "ownership-native-judge-request", version: 1, campaign: plan.campaign, judge_role: role, reviewer: appointed.id, epoch: appointed.epoch, reviewed_manifest_sha256: candidate.reviewedManifestSha256, candidate_revision: revision })
+    const response = raw({ campaign: plan.campaign, judge_role: role, reviewed_manifest_sha256: candidate.reviewedManifestSha256, candidate_revision: revision, decision: "PASS", criteria: contractObject.criteria.map((name) => ({ id: name, verdict: "PASS", reason: "Synthetic mechanical assertion only", evidence: ["fixture"] })), critical_findings: [], permitted_unknowns: [], optional_suggestions: [], ...changes })
+    const receipt = raw({ kind: "ownership-native-transport-receipt", version: 1, adapter: "nativeChatGPT", campaign: plan.campaign, completion: "COMPLETED", sessionId: "fixture-s5", agentId: appointed.id, epoch: appointed.epoch, attemptId: `fixture-${role}`, requestSha256: request.sha256, responseSha256: response.sha256, reservation })
+    return { role, reviewer: appointed.id, epoch: appointed.epoch, request, response, receipt }
+  }
+  return { ...access, files, key, source, submission, judgment }
+}
+
+export function historicalFixture(options: { derivative?: boolean; duplicateJudge?: boolean; wrongDerivativeApproval?: boolean } = {}) {
+  const files = new Map<string, Uint8Array>()
+  const source = file(files, "fixture/historical-source.ts", bytes("export const historical = 1\n"))
+  const sourceRevision = "a".repeat(40)
+  const manifestId = "b".repeat(64)
+  const originals: HistoricalOwnershipSubmission["originals"][number][] = []
+  const inputs = [source.input]
+  const historicalFile = (role: HistoricalOwnershipSubmission["originals"][number]["role"], name: string, data: Uint8Array) => {
+    const binding = file(files, `fixture/history/${name}`, data)
+    originals.push({ role, original: { bytes: data, sha256: sha256(data) } })
+    inputs.push(binding.input)
+    return binding.origin
+  }
+  const originalBytes = bytes("Cafe\u0301: historical synthetic fixture\n")
+  const body = historicalFile("body", "body.md", options.derivative ? bytes("Corrected synthetic history\n") : originalBytes)
+  const originalBody = options.derivative ? historicalFile("original-body", "original.md", originalBytes) : body
+  const review1 = historicalFile("review-1", "judge-1.json", raw({ manifestID: manifestId, verdict: "PASS" }).bytes)
+  const review2 = historicalFile("review-2", "judge-2.json", raw({ manifestID: manifestId, verdict: "PASS", fixture: 2 }).bytes)
+  const manifest = historicalFile("manifest", "manifest.json", raw({ manifestID: manifestId, sourceRevision, outputs: [{ file: originalBody.path.split("/").at(-1), bodySha256: originalBody.sha256 }], limits: "Historical manifest is research only" }).bytes)
+  const acceptance = historicalFile("acceptance", "acceptance.json", raw({
+    manifestID: manifestId, sourceRevision, status: "ACCEPTED_RESEARCH_ONLY", scope: "historical synthetic fixture",
+    comparisonLimits: "No model comparison is authorized", unknowns: ["Runtime not executed"],
+    judgments: [review1, review2].map((review, index) => ({ judge: `old-${index}`, sessionID: options.duplicateJudge ? "old-session" : `old-session-${index}`, messageID: `old-message-${index}`, file: review.path.split("/").at(-1), sha256: review.sha256, verdict: "PASS" })),
+  }).bytes)
+  const sourceFreeze = historicalFile("source-freeze", "source-freeze.json", raw({ sourceRevision, sources: [{ path: source.origin.path, sourceSha256: source.origin.sha256 }] }).bytes)
+  const derivative = () => {
+    const correction = historicalFile("correction", "correction.json", raw({ baseline: sourceRevision, amendments: [{ file: "body.md", bodySha256: body.sha256, originalBodySha256: originalBody.sha256 }], limitation: "Correction still requires new binding" }).bytes)
+    const candidateID = "d".repeat(64)
+    const prefreeze = historicalFile("prefreeze", "prefreeze.json", raw({ sourceCorrectionManifestSha256: correction.sha256, candidateID }).bytes)
+    const approvals = historicalFile("historical-approvals", "approvals.json", raw([1, 2].map((index) => ({ manifestID: options.wrongDerivativeApproval ? "e".repeat(64) : candidateID, verdict: "PASS", sessionID: `derivative-${index}`, messageID: `derivative-message-${index}` }))).bytes)
+    return { originalBody, correction, prefreeze, approvals }
+  }
+  const spec: HistoricalReuseSpec = {
+    kind: "ownership-historical-reuse", version: 1, sourceRevision, manifestId, body, manifest, acceptance, sourceFreeze, reviews: [review1, review2],
+    authorityBasis: "new synthetic binding, never historical approval", gaps: [], evidence: ["synthetic fixture, not campaign evidence"], derivative: options.derivative ? derivative() : null,
+  }
+  const fixture = nativeFixture({ files, inputs, reuse: spec })
+  const submission: HistoricalOwnershipSubmission = { key: fixture.key, originals }
+  return { ...fixture, historicalSubmission: submission, historicalSpec: spec }
+}
+
+export function candidateResult(store: StoreApi, candidate: NativeOwnershipCandidate): OwnershipResult {
+  const document = store.get(candidate.candidate) as { pending: readonly { result: Hash }[] }
+  return store.get(document.pending[0]!.result) as OwnershipResult
+}
