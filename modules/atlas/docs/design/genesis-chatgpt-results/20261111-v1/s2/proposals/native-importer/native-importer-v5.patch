+import { describe, expect, test } from "vitest"
+import type { OwnershipBody, OwnershipManifest, OwnershipArtifact, OwnershipReceipt, OwnershipReview } from "@atlas/knowledge"
+import { bindNativeOwnershipReviews, prepareNativeOwnership } from "../src/ownership-native-import.js"
+import { bytes, candidateResult, historicalFixture } from "./fixtures/ownership-native-fixture.js"
+
+const prepare = (fixture: ReturnType<typeof historicalFixture>) => prepareNativeOwnership({
+  ...fixture, submissions: [], historicalSubmissions: [fixture.historicalSubmission],
+})
+
+describe("historical reuse transport; historical approval is never current acceptance", () => {
+  test("HI-01 retains bytes and all visible historical limitations in the new result", () => {
+    const fixture = historicalFixture()
+    const candidate = prepare(fixture)
+    if (candidate.kind === "hold") throw new Error(JSON.stringify(candidate))
+    const result = candidateResult(fixture.store, candidate)
+    const body = fixture.store.get(result.body) as OwnershipBody
+    expect(new Uint8Array(body.bytes)).toEqual(bytes("Cafe\u0301: historical synthetic fixture\n"))
+    expect(result.gaps).toContain("Historical manifest is research only")
+    expect(result.gaps).toContain("No model comparison is authorized")
+    expect(result.gaps).toContain("Runtime not executed")
+    const document = fixture.store.get(candidate.candidate) as { pending: readonly { producer: unknown; historical: unknown }[] }
+    expect(document.pending[0]?.producer).toEqual({ adapter: "historical-body-rebinding" })
+    expect(document.pending[0]?.historical).toMatchObject({ mode: "historical-body-new-binding", historicalRecipe: "UNAVAILABLE_NOT_RECONSTRUCTED", recipeAndContract: "NEW_S5_BINDING_REQUIRED" })
+  })
+
+  test("HI-02 two historical PASS records cannot stand in for either current judge", () => {
+    const fixture = historicalFixture()
+    const candidate = prepare(fixture)
+    if (candidate.kind === "hold") throw new Error(JSON.stringify(candidate))
+    expect(bindNativeOwnershipReviews({ ...fixture, candidate, reviews: [] })).toMatchObject({ kind: "hold", reason: "ownership-review" })
+    const imported = bindNativeOwnershipReviews({ ...fixture, candidate, reviews: [fixture.judgment("J1", candidate), fixture.judgment("J2", candidate)] })
+    if (imported.kind === "hold") throw new Error(JSON.stringify(imported))
+    const manifest = fixture.store.get(imported.manifest) as OwnershipManifest
+    const artifact = fixture.store.get(manifest.entries[0]!.artifact) as OwnershipArtifact
+    const receipt = fixture.store.get(artifact.receipt) as OwnershipReceipt
+    const identities = receipt.reviews.map((ref) => (fixture.store.get(ref) as OwnershipReview).reviewer)
+    expect(identities).toEqual([fixture.plan.reviewers.J1.id, fixture.plan.reviewers.J2.id])
+  })
+
+  test("HI-03 a tampered historical original or changed semantic source is refused", () => {
+    const fixture = historicalFixture()
+    const altered = { ...fixture.historicalSubmission, originals: fixture.historicalSubmission.originals.map((entry) => entry.role === "body" ? { ...entry, original: { ...entry.original, bytes: bytes("rewritten body") } } : entry) }
+    expect(prepareNativeOwnership({ ...fixture, submissions: [], historicalSubmissions: [altered] })).toMatchObject({ kind: "hold", reason: "ownership-integrity" })
+    fixture.files.set("file:fixture/historical-source.ts", bytes("export const historical = 2\n"))
+    expect(prepare(fixture)).toMatchObject({ kind: "hold", reason: "ownership-input-changed" })
+  })
+
+  test("HI-04 two review files from one historical judge session do not establish a pair", () => {
+    expect(prepare(historicalFixture({ duplicateJudge: true }))).toMatchObject({ kind: "hold", reason: "ownership-review", evidence: ["historical-reviewer-identities"] })
+  })
+
+  test("HI-05 a corrected body keeps its original and correction limitation", () => {
+    const fixture = historicalFixture({ derivative: true })
+    const candidate = prepare(fixture)
+    if (candidate.kind === "hold") throw new Error(JSON.stringify(candidate))
+    const result = candidateResult(fixture.store, candidate)
+    expect(result.gaps).toContain("Correction still requires new binding")
+    const body = fixture.store.get(result.body) as OwnershipBody
+    expect(new Uint8Array(body.bytes)).toEqual(bytes("Corrected synthetic history\n"))
+    const document = fixture.store.get(candidate.candidate) as { pending: readonly { originals: readonly { role: string }[] }[] }
+    expect(document.pending[0]?.originals.map((entry) => entry.role)).toContain("original-body")
+  })
+
+  test("HI-06 derivative approvals for another candidate cannot validate the correction", () => {
+    expect(prepare(historicalFixture({ derivative: true, wrongDerivativeApproval: true }))).toMatchObject({ kind: "hold", reason: "ownership-review", evidence: ["fixture-L1", "historical-derivative-binding"] })
+  })
+})
diff --git a/modules/atlas/packages/adapter-io/test/ownership-native-import.test.ts b/modules/atlas/packages/adapter-io/test/ownership-native-import.test.ts
