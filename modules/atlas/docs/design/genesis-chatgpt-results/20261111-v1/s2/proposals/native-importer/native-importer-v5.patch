+++ b/modules/atlas/packages/adapter-io/src/ownership-historical-import.ts
@@ -0,0 +1,206 @@
+// Historical body reuse is a new private binding, never an original native model response.
+import { createHash } from "node:crypto"
+import type { Hash } from "@atlas/contracts"
+import { id } from "@atlas/kernel"
+import type { StoreApi } from "@atlas/kernel"
+import { isOwnershipBody } from "@atlas/knowledge"
+import type { OwnershipInput, OwnershipRefusal, OwnershipResult } from "@atlas/knowledge"
+
+type Ref = { readonly commit: string; readonly path: string; readonly sha256: string }
+type Original = { readonly bytes: Uint8Array; readonly sha256: string }
+type HistoricalRole = "body" | "manifest" | "acceptance" | "source-freeze" | "review-1" | "review-2" | "original-body" | "correction" | "prefreeze" | "historical-approvals"
+
+export interface HistoricalReuseSpec {
+  readonly kind: "ownership-historical-reuse"; readonly version: 1
+  readonly sourceRevision: string; readonly manifestId: string
+  readonly body: Ref; readonly manifest: Ref; readonly acceptance: Ref; readonly sourceFreeze: Ref
+  readonly reviews: readonly [Ref, Ref]
+  readonly authorityBasis: string; readonly gaps: readonly string[]; readonly evidence: readonly string[]
+  readonly derivative: null | { readonly originalBody: Ref; readonly correction: Ref; readonly prefreeze: Ref; readonly approvals: Ref }
+}
+
+export interface HistoricalOwnershipSubmission {
+  readonly key: string
+  readonly originals: readonly { readonly role: HistoricalRole; readonly original: Original }[]
+}
+
+export type HistoricalStoredOriginal = { readonly role: HistoricalRole; readonly origin: Ref; readonly body: Hash }
+export type HistoricalPreparedEntry = {
+  readonly kind: "historical-entry"; readonly result: Hash; readonly originals: readonly HistoricalStoredOriginal[]
+  readonly comparison: {
+    readonly mode: "historical-body-new-binding"; readonly historicalManifest: string
+    readonly historicalSourceRevision: string; readonly historicalScope: string
+    readonly originalBodySha256: string; readonly retainedBodySha256: string
+    readonly sourceFilesCompared: readonly string[]; readonly targetScope: string
+    readonly targetContract: Hash; readonly historicalContractSha256: string | null
+    readonly historicalRecipe: "UNAVAILABLE_NOT_RECONSTRUCTED"; readonly recipeAndContract: "NEW_S5_BINDING_REQUIRED"
+  }
+}
+
+/** Metadata and hashes retain history; only the current S5 binder may create current reviews. */
+export function prepareHistoricalOwnershipEntry(request: {
+  readonly store: StoreApi; readonly scope: string; readonly contract: Hash
+  readonly inputs: readonly OwnershipInput[]; readonly spec: HistoricalReuseSpec
+  readonly submission: HistoricalOwnershipSubmission
+  readonly current: (key: string) => string | undefined
+  readonly readControlBytes: (key: string) => Uint8Array | undefined
+}): HistoricalPreparedEntry | OwnershipRefusal {
+  const spec = request.spec
+  if (!isHistoricalReuseSpec(spec)) return hold("malformed-ownership", ["historical-spec"])
+  const expected = references(spec)
+  if (!Array.isArray(request.submission.originals) || request.submission.originals.length !== expected.length ||
+    new Set(request.submission.originals.map((value) => value.role)).size !== expected.length)
+    return hold("ownership-missing", [request.submission.key, "historical-originals"])
+  const originals: HistoricalStoredOriginal[] = []
+  const bytes = new Map<HistoricalRole, Uint8Array>()
+  for (const item of expected) {
+    const original = request.submission.originals.find((value) => value.role === item.role)?.original
+    const input = request.inputs.find((value) => value.key === `file:${item.origin.path}`)
+    if (original === undefined || original.bytes.length === 0 || original.sha256 !== item.origin.sha256 || sha256(original.bytes) !== item.origin.sha256)
+      return hold("ownership-integrity", [request.submission.key, item.role, "historical-original-digest"])
+    const version = id({ kind: "ownership-source", version: 1, bytes: Array.from(original.bytes) })
+    if (input?.version !== version || request.current(input.key) !== version)
+      return hold("ownership-input-changed", [item.origin.path, "historical-input-binding"])
+    const body = { kind: "ownership-body", version: 1, bytes: Array.from(original.bytes) }
+    const stored = request.store.put(body)
+    if (stored !== id(body) || !sameStored(request.store, stored, body)) return hold("ownership-integrity", [item.role])
+    originals.push({ role: item.role, origin: item.origin, body: stored })
+    bytes.set(item.role, original.bytes)
+  }
+  const manifest = json(bytes.get("manifest"))
+  const acceptance = json(bytes.get("acceptance"))
+  const freeze = json(bytes.get("source-freeze"))
+  if (!object(manifest) || !object(acceptance) || manifest.manifestID !== spec.manifestId || acceptance.manifestID !== spec.manifestId ||
+    (manifest.sourceRevision ?? manifest.baseline) !== spec.sourceRevision || (acceptance.sourceRevision ?? acceptance.baseline) !== spec.sourceRevision ||
+    !text(acceptance.status) || !acceptance.status.startsWith("ACCEPTED_") || !Array.isArray(acceptance.judgments) ||
+    acceptance.judgments.length !== 2 || !acceptance.judgments.every(object))
+    return hold("ownership-review", [request.submission.key, "historical-acceptance"])
+  const scope = text(acceptance.scope) ? acceptance.scope : text(manifest.scope) ? manifest.scope : undefined
+  if (scope === undefined) return hold("ownership-scope", [request.submission.key, "historical-scope"])
+  const originalBody = spec.derivative?.originalBody ?? spec.body
+  const rows = Array.isArray(manifest.outputs) ? manifest.outputs : [{ file: manifest.bodyFile, bodySha256: manifest.bodySha256 }]
+  if (!rows.some((row) => object(row) && row.file === basename(originalBody.path) && row.bodySha256 === originalBody.sha256))
+    return hold("ownership-integrity", [request.submission.key, "historical-body-manifest-binding"])
+  const judges = acceptance.judgments
+  if (!judges.every((judge) => text(judge.judge) && text(judge.sessionID) && text(judge.messageID) && judge.verdict === "PASS") ||
+    new Set(judges.map((judge) => judge.sessionID)).size !== 2 || new Set(judges.map((judge) => judge.judge)).size !== 2)
+    return hold("ownership-review", ["historical-reviewer-identities"])
+  const reviewDirectory = spec.acceptance.path.slice(0, spec.acceptance.path.lastIndexOf("/") + 1)
+  if (!judges.every((judge) => text(judge.file) && basename(judge.file) === judge.file &&
+    spec.reviews.some((review) => review.path === reviewDirectory + judge.file && review.sha256 === judge.sha256)) ||
+    new Set(judges.map((judge) => judge.file)).size !== 2)
+    return hold("ownership-review", ["historical-review-file-coverage"])
+  for (const [index, origin] of spec.reviews.entries()) {
+    const judge = judges.find((value) => value.file === basename(origin.path) && value.sha256 === origin.sha256)
+    const reviewBytes = bytes.get(index === 0 ? "review-1" : "review-2")
+    const review = json(reviewBytes)
+    const prose = utf8(reviewBytes)
+    const reviewed = object(review) ? review.manifestID : prose?.split("\n").find((line) => line.startsWith("Reviewed manifest:"))?.slice(18).trim()
+    const verdict = object(review) ? review.verdict : prose?.split("\n").find((line) => line.startsWith("Verdict:"))?.slice(8).trim()
+    if (judge === undefined || reviewed !== spec.manifestId || verdict !== "PASS")
+      return hold("ownership-review", [request.submission.key, "historical-original-review", origin.path])
+  }
+  if (!object(freeze) || (freeze.sourceRevision ?? freeze.baseline) !== spec.sourceRevision ||
+    !Array.isArray(freeze.sources) || freeze.sources.length === 0 || !freeze.sources.every(object))
+    return hold("malformed-ownership", ["historical-source-freeze"])
+  const compared: string[] = []
+  for (const source of freeze.sources) {
+    if (!path(source.path) || !hash(source.sourceSha256)) return hold("malformed-ownership", ["historical-source-row"])
+    const key = `file:${source.path}`
+    const captured = request.readControlBytes(key)
+    if (captured === undefined) return hold("ownership-input-unavailable", [key])
+    const version = id({ kind: "ownership-source", version: 1, bytes: Array.from(captured) })
+    if (sha256(captured) !== source.sourceSha256 || request.inputs.find((input) => input.key === key)?.version !== version || request.current(key) !== version)
+      return hold("ownership-input-changed", [key, "historical-source-drift"])
+    compared.push(key)
+  }
+  if (new Set(compared).size !== compared.length) return hold("malformed-ownership", ["historical-duplicate-source"])
+  const derivativeLimits: string[] = []
+  if (spec.derivative !== null) {
+    const correction = json(bytes.get("correction"))
+    const prefreeze = json(bytes.get("prefreeze"))
+    const approvals = json(bytes.get("historical-approvals"))
+    if (!object(correction) || correction.baseline !== spec.sourceRevision || !Array.isArray(correction.amendments) ||
+      !correction.amendments.some((item) => object(item) && item.file === basename(spec.body.path) && item.bodySha256 === spec.body.sha256 && item.originalBodySha256 === originalBody.sha256) ||
+      !object(prefreeze) || prefreeze.sourceCorrectionManifestSha256 !== spec.derivative.correction.sha256 || !hash(prefreeze.candidateID) ||
+      !Array.isArray(approvals) || approvals.length !== 2 || !approvals.every((item) => object(item) && item.manifestID === prefreeze.candidateID && item.verdict === "PASS" && text(item.sessionID) && text(item.messageID)) ||
+      new Set(approvals.map((item) => object(item) ? item.sessionID : undefined)).size !== 2)
+      return hold("ownership-review", [request.submission.key, "historical-derivative-binding"])
+    if (text(correction.limitation)) derivativeLimits.push(correction.limitation)
+  }
+  const bodyBytes = bytes.get("body")!
+  if (!textBody(utf8(bodyBytes))) return hold("malformed-ownership", ["historical-body-utf8"])
+  const body = originals.find((original) => original.role === "body")!.body
+  const historicalGaps = [manifest.limits, manifest.comparisonLimits, acceptance.limits, acceptance.remaining, acceptance.comparisonLimits,
+    ...(Array.isArray(acceptance.unknowns) ? acceptance.unknowns : []), ...(Array.isArray(acceptance.notClaimed) ? acceptance.notClaimed : []), ...derivativeLimits].filter(text)
+  const result: OwnershipResult = {
+    kind: "ownership-result", version: 1, body, authority: { scope: request.scope, basis: spec.authorityBasis }, validity: "supported",
+    gaps: [...new Set([...spec.gaps, `Historical acceptance scope: ${scope}`, ...historicalGaps, "Original historical producer recipe/request is not reconstructed; this is a new import binding."])],
+    evidence: [...new Set([...spec.evidence, `historical-manifest:${spec.manifestId}`, `body-sha256:${spec.body.sha256}`, ...originals.map((original) => `${original.role}:${original.body}`)])],
+  }
+  const resultRef = request.store.put(result)
+  if (!sameStored(request.store, resultRef, result)) return hold("ownership-integrity", ["historical-result-write"])
+  return {
+    kind: "historical-entry", result: resultRef, originals,
+    comparison: { mode: "historical-body-new-binding", historicalManifest: spec.manifestId, historicalSourceRevision: spec.sourceRevision, historicalScope: scope,
+      originalBodySha256: originalBody.sha256, retainedBodySha256: spec.body.sha256, sourceFilesCompared: compared, targetScope: request.scope,
+      targetContract: request.contract, historicalContractSha256: hash(manifest.contractSha256) ? manifest.contractSha256 : null,
+      historicalRecipe: "UNAVAILABLE_NOT_RECONSTRUCTED", recipeAndContract: "NEW_S5_BINDING_REQUIRED" },
+  }
+}
+
+export function restoreHistoricalSubmission(store: StoreApi, key: string, originals: unknown): HistoricalOwnershipSubmission | undefined {
+  if (!Array.isArray(originals)) return undefined
+  const restored: { role: HistoricalRole; original: Original }[] = []
+  for (const value of originals) {
+    if (!object(value) || !role(value.role) || !reference(value.origin) || !hash(value.body)) return undefined
+    const body = store.get(value.body)
+    if (!isOwnershipBody(body) || id(body) !== value.body) return undefined
+    const bytes = new Uint8Array(body.bytes)
+    if (sha256(bytes) !== value.origin.sha256) return undefined
+    restored.push({ role: value.role, original: { bytes, sha256: value.origin.sha256 } })
+  }
+  return { key, originals: restored }
+}
+
+export function isHistoricalReuseSpec(value: unknown): value is HistoricalReuseSpec {
+  return object(value) && sameKeys(value, ["kind", "version", "sourceRevision", "manifestId", "body", "manifest", "acceptance", "sourceFreeze", "reviews", "authorityBasis", "gaps", "evidence", "derivative"]) &&
+    value.kind === "ownership-historical-reuse" && value.version === 1 && typeof value.sourceRevision === "string" && /^[0-9a-f]{40}$/.test(value.sourceRevision) && hash(value.manifestId) &&
+    [value.body, value.manifest, value.acceptance, value.sourceFreeze].every(reference) && Array.isArray(value.reviews) && value.reviews.length === 2 && value.reviews.every(reference) && value.reviews[0]!.path !== value.reviews[1]!.path &&
+    text(value.authorityBasis) && strings(value.gaps) && strings(value.evidence) &&
+    (value.derivative === null || object(value.derivative) && sameKeys(value.derivative, ["originalBody", "correction", "prefreeze", "approvals"]) && Object.values(value.derivative).every(reference))
+}
+
+function references(spec: HistoricalReuseSpec): readonly { role: HistoricalRole; origin: Ref }[] {
+  return [
+    { role: "body", origin: spec.body }, { role: "manifest", origin: spec.manifest }, { role: "acceptance", origin: spec.acceptance },
+    { role: "source-freeze", origin: spec.sourceFreeze }, { role: "review-1", origin: spec.reviews[0] }, { role: "review-2", origin: spec.reviews[1] },
+    ...(spec.derivative === null ? [] : [
+      { role: "original-body" as const, origin: spec.derivative.originalBody }, { role: "correction" as const, origin: spec.derivative.correction },
+      { role: "prefreeze" as const, origin: spec.derivative.prefreeze }, { role: "historical-approvals" as const, origin: spec.derivative.approvals },
+    ]),
+  ]
+}
+
+const sha256 = (value: Uint8Array) => createHash("sha256").update(value).digest("hex")
+const object = (value: unknown): value is Record<string, unknown> => typeof value === "object" && value !== null && !Array.isArray(value)
+const textBody = (value: unknown): value is string => typeof value === "string" && value.trim().length > 0
+const text = (value: unknown): value is string => textBody(value) && value.normalize("NFC") === value
+const strings = (value: unknown): value is readonly string[] => Array.isArray(value) && value.every(text)
+const hash = (value: unknown): value is Hash => typeof value === "string" && /^[0-9a-f]{64}$/.test(value)
+const path = (value: unknown): value is string => text(value) && !value.startsWith("/") && !value.includes("\\") && !/^[A-Za-z]:/.test(value) && value.split("/").every((part) => !!part && ![".", "..", ".git", ".atlas"].includes(part))
+const reference = (value: unknown): value is Ref => object(value) && sameKeys(value, ["commit", "path", "sha256"]) && typeof value.commit === "string" && /^[0-9a-f]{40}$/.test(value.commit) && path(value.path) && hash(value.sha256)
+const sameKeys = (value: Record<string, unknown>, keys: readonly string[]) => Object.keys(value).length === keys.length && Object.keys(value).every((key) => keys.includes(key))
+const basename = (value: string) => value.slice(value.lastIndexOf("/") + 1)
+const role = (value: unknown): value is HistoricalRole => typeof value === "string" && ["body", "manifest", "acceptance", "source-freeze", "review-1", "review-2", "original-body", "correction", "prefreeze", "historical-approvals"].includes(value)
+const hold = (reason: OwnershipRefusal["reason"], evidence: readonly string[]): OwnershipRefusal => ({ kind: "hold", reason, evidence })
+function utf8(bytes: Uint8Array | undefined): string | undefined {
+  try { return bytes === undefined ? undefined : new TextDecoder("utf-8", { fatal: true, ignoreBOM: true }).decode(bytes) } catch { return undefined }
+}
+function json(bytes: Uint8Array | undefined): unknown {
+  try { const value = utf8(bytes); return value === undefined ? undefined : JSON.parse(value) } catch { return undefined }
+}
+function sameStored(store: StoreApi, ref: Hash, value: unknown): boolean {
+  const stored = store.get(ref)
+  return stored !== undefined && id(stored) === ref && id(value) === ref
+}
diff --git a/modules/atlas/packages/adapter-io/src/ownership-native-import.ts b/modules/atlas/packages/adapter-io/src/ownership-native-import.ts
