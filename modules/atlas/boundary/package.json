{
  "name": "@orchestra/atlas-boundary",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "exports": {
    ".": {
      "types": "./src/generated/boundary.d.ts",
      "default": "./src/generated/boundary.js"
    },
    "./materialize": {
      "types": "./src/generated/materialize.d.ts",
      "default": "./src/generated/materialize.js"
    },
    "./native-header": {
      "types": "./src/generated/native-header.d.ts",
      "default": "./src/generated/native-header.js"
    },
    "./native-memory": {
      "types": "./src/generated/native-memory.d.ts",
      "default": "./src/generated/native-memory.js"
    },
    "./surface": {
      "types": "./src/generated/surface.d.ts",
      "default": "./src/generated/surface.js"
    },
    "./mine": {
      "types": "./src/generated/mine.d.ts",
      "default": "./src/generated/mine.js"
    },
    "./context": {
      "types": "./src/generated/context.d.ts",
      "default": "./src/generated/context.js"
    }
  },
  "scripts": {
    "generate": "bun script/build.ts",
    "check:generated": "bun script/build.ts --check",
    "typecheck": "tsgo --noEmit",
    "test": "bun test --timeout 30000"
  },
  "dependencies": {
    "web-tree-sitter": "0.23.2"
  },
  "devDependencies": {
    "@bufbuild/protobuf": "2.12.0",
    "@c4312/scip": "0.1.0",
    "@noble/hashes": "1.8.0",
    "@tsconfig/bun": "catalog:",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "@typescript/native-preview": "catalog:",
    "dts-bundle-generator": "9.5.1"
  }
}
