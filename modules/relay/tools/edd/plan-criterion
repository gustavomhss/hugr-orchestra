#!/usr/bin/env python3
"""plan-criterion — exit 0 iff ONE named criterion of a plan-check phase is PASS.

`plan-check` grades a whole phase: it reports every criterion and exits non-zero if any FAILed. A
Relay control is finer than that — each criterion is its own control, with its own verdict, oracle
sha and origin on the chain, so a failure localizes to the criterion rather than to the phase.

This is the adapter between the two. It runs `plan-check --json` once per invocation, which is
wasteful compared to one run per phase, and that is a deliberate trade: the alternative is a phase
-level control whose failure tells you "FRAME is wrong" and nothing else, which is precisely the
localization the state machine exists to provide.

    plan-criterion <phase> <criterion> [--plan-dir DIR] [--repo-root DIR]

exit 0  the criterion is PASS
exit 1  the criterion is FAIL, SKIP, or absent from the report
exit 2  plan-check could not be run or produced no parseable report

SKIP is a FAILURE here, not a pass. plan-check skips a criterion when the inputs it needs are
missing, and a control that cannot be evaluated has not been satisfied — the same rule the gate
applies to a judge whose diff cannot be computed.
"""
import argparse
import json
import os
import subprocess
import sys

HERE = os.path.dirname(os.path.abspath(__file__))


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("phase")
    ap.add_argument("criterion")
    ap.add_argument("--plan-dir", default="plan")
    ap.add_argument("--repo-root", default=".")
    a = ap.parse_args()

    r = subprocess.run([sys.executable, os.path.join(HERE, "plan-check"),
                        "--phase", a.phase, "--plan-dir", a.plan_dir,
                        "--repo-root", a.repo_root, "--json"],
                       capture_output=True, text=True)
    try:
        report = json.loads(r.stdout or "{}")
    except json.JSONDecodeError:
        print(f"plan-criterion: plan-check produced no parseable report for phase {a.phase!r}",
              file=sys.stderr)
        print(r.stderr.strip()[:400], file=sys.stderr)
        return 2

    rows = report if isinstance(report, list) else report.get("results", report.get("criteria", []))
    for row in rows:
        if row.get("criterion") == a.criterion:
            status = row.get("status")
            if status == "PASS":
                return 0
            print(f"{status} {a.criterion} — {row.get('evidence', '')}", file=sys.stderr)
            return 1
    print(f"plan-criterion: {a.criterion!r} is not a criterion of phase {a.phase!r}", file=sys.stderr)
    return 1


if __name__ == "__main__":
    sys.exit(main())
