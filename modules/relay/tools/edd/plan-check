def chk_characterization_pinned_where_behavior_exists(ctx):
    """"every package touching existing behavior carries its characterization
    command" (frozen Verify)."""
    err = require(ctx, "frame")
    if err:
        return FAIL, err
    pinning = g(ctx.frame, "pinning", default=[])
    if not isinstance(pinning, list) or not pinning:
        return PASS, "0 pinning entries in frame.json (nothing to carry into packets)"
    if not ctx.packet_files:
        return FAIL, "no packets/*.md found"
    all_text = ctx.all_packet_text()
    bad = []
    for p in pinning:
        if not isinstance(p, dict):
            continue
        cmd = p.get("characterization_command")
        if not nonempty_str(cmd):
            bad.append(f"{p.get('seam','?')}: characterization_command empty in frame.json")
            continue
        # characterization_command often carries trailing explanatory prose after
        # the runnable part (e.g. "cargo test -p foo (existing suite: ...)"); match
        # on the leading command token, not the full annotated string.
        core = re.split(r"\s\(|\n", cmd, maxsplit=1)[0].strip()
        if cmd not in all_text and (not core or core not in all_text):
            bad.append(f"{p.get('seam','?')}: characterization_command not found in any packet")
    if bad:
        return FAIL, truncate_list(bad)
    return PASS, f"{len(pinning)} pinning entries, each characterization_command carried into a packet"


def chk_undo_present_where_system_changes(ctx):
    """"every change to a running system knows how it is taken back" (law 10;
    frozen Verify; undo_present_where_system_changes checklist key) — checked
    at packet level (the CARVE-level artifact check is undo_named_where_needed)."""
    err = require(ctx, "packages")
    if err:
        return FAIL, err
    if not ctx.packet_files:
        return FAIL, "no packets/*.md found"
    heading = re.compile(r"##.{0,10}(how this is taken back|rollback|undo)", re.IGNORECASE)
    bad = []
    for p in g(ctx.packages, "packages", default=[]):
        if not isinstance(p, dict) or p.get("kind") != "work":
            continue
        pid = p.get("id", "?")
        name, txt = packet_text_for(ctx, pid)
        if txt is None:
            bad.append(f"{pid}: no matching packet file")
            continue
        if not heading.search(txt):
            bad.append(f"{pid}: no 'how this is taken back' section in packet")
    if bad:
        return FAIL, truncate_list(bad)
    return PASS, "all work packages' packets carry a 'how this is taken back' section"


def _transitive_deps(pkgs_by_id, pid, seen=None):
    seen = seen if seen is not None else set()
    if pid in seen:
        return seen
    seen.add(pid)
    p = pkgs_by_id.get(pid)
    for d in (p.get("deps") or []) if isinstance(p, dict) else []:
        _transitive_deps(pkgs_by_id, d, seen)
    return seen


def _new_file_paths(pkgs_by_id, pid):
    p = pkgs_by_id.get(pid)
    if not isinstance(p, dict):
        return set()
    return {e.get("path") for e in (p.get("allow_list") or [])
            if isinstance(e, dict) and e.get("new") is True and nonempty_str(e.get("path"))}


def chk_anchors_present(ctx):
    """"every referenced file, symbol, contract, mock exists — or resolves to
    a `new: true` allow-list entry of a package this one depends on, the
    anchor marked as future work rather than presented as existing code"
    (frozen Verify, doc sha a944e7c19eae) — checked against the 'Your
    anchors' section, the packet's curated pointer into real code (existing,
    or a depended-on sibling's not-yet-built file)."""
    if not ctx.packet_files:
        return FAIL, "no packets/*.md found"
    heading = re.compile(r"##\s*your anchors", re.IGNORECASE)
    path_re = re.compile(r"`([A-Za-z0-9_./-]+\.[A-Za-z][A-Za-z0-9]{0,5})(:[0-9,\-]+)?`")

    pkgs_by_id = {p.get("id"): p for p in g(ctx.packages, "packages", default=[]) if isinstance(p, dict)}

    bad = []
    future = []
    total = 0
    for name, txt in ctx.packet_files.items():
        m = heading.search(txt)
        if not m:
            continue  # anchors section is conventional, not schema-mandated; nothing to check
        section = txt[m.end():]
        nxt = re.search(r"\n##\s", section)
        if nxt:
            section = section[:nxt.start()]

        # which package owns this packet? (same stem/substring heuristic as packet_text_for)
        owner_pid = None
        stem = name[:-3] if name.endswith(".md") else name
        for pid in pkgs_by_id:
            if pid == stem or (pid and pid in name):
                owner_pid = pid
                break
        dep_ids = (_transitive_deps(pkgs_by_id, owner_pid) - {owner_pid}) if owner_pid else set()

        for match in path_re.finditer(section):
            path = match.group(1)
            total += 1
            if ctx.repo_anchor_resolves(path):
                continue
            clean = re.sub(r":\d+(-\d+)?$", "", path.strip())
            hit_pkg = None
            for dep_pid in dep_ids:
                new_paths = _new_file_paths(pkgs_by_id, dep_pid)
                if clean in new_paths or Path(clean).name in {Path(x).name for x in new_paths}:
                    hit_pkg = dep_pid
                    break
            if hit_pkg:
                future.append(f"{name}: {path} (future anchor into {hit_pkg}'s new file)")
                continue
            bad.append(f"{name}: {path}")
    if bad:
        return FAIL, truncate_list(bad)
    if total == 0:
        return PASS, "no file-path anchors found to check (no packet has a parseable 'Your anchors' path)"
    if future:
        return PASS, (f"{total} anchor path(s): {len(future)} future anchor(s) into a depended-on "
                       f"package's new file ({truncate_list(future, 3)}), rest resolve under {ctx.repo_root}")
    return PASS, f"{total} anchor path(s) across packets, all resolve under {ctx.repo_root}"


def chk_holdout_separated(ctx):
    """"every holdout entry resolving to a ledger artifact whose content
    appears nowhere under plan/ or in any packet (digest scan, not trust)"
    (frozen Verify). The leak scan excludes `holdout_ledger/` — the declared,
    by-convention standalone ledger location "beside the plan artifacts"
    (doc sha 4a61f9c33733) — since the held-out content legitimately lives
    there; a digest match anywhere else still fails as a leak."""
    err = require(ctx, "manifest")
    if err:
        return FAIL, err
    holdout = g(ctx.manifest, "holdout", default=None)
    if not isinstance(holdout, list):
        return FAIL, "manifest.holdout missing (must be a list)"
    if not holdout:
        return FAIL, "manifest.holdout is empty"

    plan_files = find_all_files(ctx.plan_dir, exclude_dirnames={HOLDOUT_LEDGER_DIRNAME})
    plan_digests = {}
    for f in plan_files:
        d = sha256_file(f)
        if d:
            plan_digests.setdefault(d, []).append(str(f.relative_to(ctx.plan_dir)))

    bad = []
    in_ledger_dir = 0
    for h in holdout:
        if not isinstance(h, dict):
            bad.append("malformed holdout entry")
            continue
        sid = h.get("story", "?")
        digest = h.get("digest")
        ledger_ref = h.get("ledger_ref")
        # ledger_ref may itself carry "<path> @ sha256:<digest>" (doc sha
        # 4a61f9c33733); if so, cross-check it against the declared digest field.
        embedded_path, embedded_digest = parse_at_sha256_ref(ledger_ref)
        if embedded_digest is not None:
            if is_real_sha256(digest) and embedded_digest != digest:
                bad.append(f"{sid}: ledger_ref's embedded digest ({embedded_digest}) "
                            f"disagrees with the declared digest field ({digest})")
            ledger_ref = embedded_path
            if not is_real_sha256(digest):
                digest = embedded_digest
        if not is_real_sha256(digest):
            bad.append(f"{sid}: digest={digest!r} not a real sha256 (placeholder)")
            continue
        if digest in plan_digests:
            bad.append(f"{sid}: LEAKED — digest matches file(s) under plan-dir: {truncate_list(plan_digests[digest], 3)}")
            continue
        resolved = ctx.plan_path_resolve(ledger_ref) if nonempty_str(ledger_ref) else None
        if resolved is not None:
            actual = sha256_file(resolved)
            if actual != digest:
                bad.append(f"{sid}: declared digest does not match {ledger_ref} content ({actual})")
            elif HOLDOUT_LEDGER_DIRNAME in resolved.parts:
                in_ledger_dir += 1
        elif not nonempty_str(ledger_ref):
            bad.append(f"{sid}: ledger_ref empty")
    if bad:
        return FAIL, truncate_list(bad, 8)
    if in_ledger_dir:
        return PASS, (f"{len(holdout)} holdout entries: real digests, none leaked outside plan-dir "
                       f"({in_ledger_dir} of them content only in declared ledger dir "
                       f"'{HOLDOUT_LEDGER_DIRNAME}/')")
    return PASS, f"{len(holdout)} holdout entries: real digests, none leaked under plan-dir"


def chk_holdout_covers_merge_gating_stories(ctx):
    """"every merge-gating story holding a holdout entry — partial coverage is
    the self-grading gap wearing a mechanism's name" (frozen Verify — no
    checklist key of its own; coined here as holdout_covers_merge_gating_stories)."""
    err = require(ctx, "packages", "manifest")
    if err:
        return FAIL, err
    gating = set()
    for p in g(ctx.packages, "packages", default=[]):
        if isinstance(p, dict):
            gating.update(p.get("enacts_stories") or [])
    if not gating:
        return FAIL, "no enacted stories found across packages.json"
    covered = {h.get("story") for h in g(ctx.manifest, "holdout", default=[]) if isinstance(h, dict)}
    exceptions = {e.get("story") for e in g(ctx.manifest, "holdout_exceptions", default=[]) if isinstance(e, dict) and nonempty_str(e.get("reason"))}
    missing = sorted(gating - covered - exceptions)
    if missing:
        return FAIL, f"merge-gating stories with no holdout entry and no holdout_exceptions reason: {truncate_list(missing)}"
    return PASS, f"{len(gating)} merge-gating stories, all covered by holdout[] or a reasoned holdout_exceptions entry"


def chk_policy_complete(ctx):
    """"every policy field present" (frozen Verify)."""
    err = require(ctx, "manifest")
    if err:
        return FAIL, err
    policy = g(ctx.manifest, "policy", default=None)
    if not isinstance(policy, dict):
        return FAIL, "manifest.policy missing or not an object"
    missing = []
    if not isinstance(policy.get("repair_attempts"), int) or policy.get("repair_attempts", 0) <= 0:
        missing.append("repair_attempts(int>0)")
    for k in ("no_progress_rule", "escalation_trigger", "branch_age_ceiling", "merge_cadence", "queue_full_rule"):
        if not nonempty_str(policy.get(k)):
            missing.append(k)
    if policy.get("restart_from_original") is not True:
        missing.append("restart_from_original(true)")
    if not isinstance(policy.get("check_tiers"), list) or not policy.get("check_tiers"):
        missing.append("check_tiers[]")
    if not isinstance(policy.get("ambiguity_defaults"), list) or not policy.get("ambiguity_defaults"):
        missing.append("ambiguity_defaults[]")
    cs = policy.get("constants_source")
    if not isinstance(cs, str) or not (cs.startswith("measured") or cs.startswith("default_unmeasured")):
        missing.append(f"constants_source(got {cs!r})")
    if missing:
        return FAIL, f"policy missing/invalid: {', '.join(missing)}"
    return PASS, "manifest.policy carries all required fields"


def _resolve_path_maybe_absolute(ctx, path_str):
    """plan_path_resolve, but also accepts an absolute path outside plan-dir
    (the standalone `<path> @ sha256:<digest>` form names an absolute path,
    doc sha 4a61f9c33733) — Path('/a') / '/b' already collapses to '/b' in
    pathlib, so plan_path_resolve's own join handles this; this wrapper just
    documents that and keeps the call site readable."""
    return ctx.plan_path_resolve(path_str)


def _resolve_verdict(ctx):
    """Returns (verdict_dict_or_None, evidence_str_describing_source_or_failure).
    Handles: an inline verdict object, a bare JSON path, and the standalone-run
    `<path> @ sha256:<digest>` form (doc sha 4a61f9c33733) — for the latter,
    both legs are checked: the path must resolve to real JSON with a `verdict`
    field, AND the file's own sha256 must match the declared digest leg."""
    vr = g(ctx.manifest, "verdict_ref", default=None)
    if isinstance(vr, dict) and nonempty_str(vr.get("verdict")):
        return vr, "verdict inline in manifest.verdict_ref"

    at_path, at_digest = parse_at_sha256_ref(vr)
    if at_digest is not None:
        resolved = _resolve_path_maybe_absolute(ctx, at_path)
        if resolved is None:
            return None, f"verdict_ref names {at_path!r} (standalone '<path> @ sha256:' form) but it does not resolve"
        actual = sha256_file(resolved)
        if actual != at_digest:
            return None, f"{at_path} exists but its sha256 ({actual}) does not match the declared digest leg ({at_digest})"
        data, err = load_json(resolved)
        if data is not None and nonempty_str(data.get("verdict")):
            return data, f"verdict loaded from {at_path} (digest leg verified: {at_digest})"
        return None, f"{at_path} exists and digest matches, but has no usable 'verdict' field ({err or 'parsed but missing verdict'})"

    path = None
    if isinstance(vr, dict):
        path = vr.get("path")
    elif isinstance(vr, str) and not is_real_sha256(vr) and "://" not in vr and vr.strip().endswith(".json"):
        path = vr.strip()
    if path:
        resolved = ctx.plan_path_resolve(path)
        if resolved is not None:
            data, err = load_json(resolved)
            if data is not None and nonempty_str(data.get("verdict")):
                return data, f"verdict loaded from {path}"
            return None, f"{path} exists but has no usable 'verdict' field ({err or 'parsed but missing verdict'})"
        return None, f"verdict_ref names {path!r} but it does not resolve under plan-dir"
    return None, f"verdict_ref={vr!r} does not resolve to an actual verdict object (URI/placeholder, no local file)"


def chk_hostile_read_approved(ctx):
    """"the hostile-read verdict present and APPROVE — a FIXES-NEEDED verdict
    loops the macro, it does not pass" (frozen Verify)."""
    err = require(ctx, "manifest")
    if err:
        return FAIL, err
    verdict, evidence = _resolve_verdict(ctx)
    if verdict is None:
        return FAIL, evidence
    v = verdict.get("verdict")
    if v == "APPROVE":
        return PASS, f"{evidence}: APPROVE"
    if v == "FIXES-NEEDED":
        return FAIL, f"{evidence}: verdict is FIXES-NEEDED — loops the macro, does not pass"
    return FAIL, f"{evidence}: verdict={v!r}, must be APPROVE|FIXES-NEEDED"


def chk_downpath_or_irreversible(ctx):
    """"a runnable down-path including retention and cleanup, or the change is
    declared irreversible on the record ... with the hostile read required to
    acknowledge it explicitly" (law 10; frozen Verify;
    downpath_or_irreversible_for_schema_and_data checklist key). `undo` is now
    an array of layers (schema doc fb2c41e78c72); a `declared_irreversible`
    layer is the structural marker. Old single-object fixtures (undo.command
    containing the word "irreversible") are still detected best-effort so this
    downstream semantic check stays informative even when
    undo_named_where_needed has already failed that package's shape."""
    err = require(ctx, "packages")
    if err:
        return FAIL, err
    pkgs = [p for p in g(ctx.packages, "packages", default=[]) if isinstance(p, dict)]
    irreversible = []
    for p in pkgs:
        u = p.get("undo")
        found = False
        if isinstance(u, list):
            found = any(isinstance(layer, dict) and layer.get("mechanism") == "declared_irreversible" for layer in u)
        elif isinstance(u, dict):
            cmd = u.get("command") or ""
            found = isinstance(cmd, str) and "irreversible" in cmd.lower()
        if found:
            irreversible.append(p.get("id", "?"))
    if not irreversible:
        return PASS, "no package's undo declares itself irreversible (nothing requiring a hostile-read acknowledgment)"
    verdict, evidence = _resolve_verdict(ctx)
    if verdict is None:
        return FAIL, f"{truncate_list(irreversible)} declared irreversible, but hostile-read verdict unresolvable ({evidence})"
    verdict_text = json.dumps(verdict).lower()
    missing = [pid for pid in irreversible if "irreversible" not in verdict_text]
    if missing:
        return FAIL, f"declared irreversible but not acknowledged anywhere in the hostile-read verdict: {truncate_list(missing)}"
    return PASS, f"{truncate_list(irreversible)} declared irreversible and acknowledged in the hostile-read verdict"


def chk_tripwires_armed(ctx):
    """"every plan claim resolves to an armed tripwire" (frozen Verify) —
    structural completeness of the armed set is checked mechanically; whether
    literally every claim has a tripwire is a coverage judgment this script
    does not attempt (see README)."""
    err = require(ctx, "manifest")
    if err:
        return FAIL, err
    tw = g(ctx.manifest, "tripwires", default=None)
    if not isinstance(tw, list) or not tw:
        return FAIL, "manifest.tripwires missing or empty"
    bad = []
    for i, t in enumerate(tw):
        if not isinstance(t, dict):
            bad.append(f"tripwires[{i}] not an object")
            continue
        missing = [k for k in ("id", "guards_claim", "observable", "threshold", "on_fire") if not nonempty_str(t.get(k))]
        if missing:
            bad.append(f"{t.get('id', i)}: missing {','.join(missing)}")
    if bad:
        return FAIL, truncate_list(bad)
    return PASS, f"{len(tw)} tripwires, all carry id+guards_claim+observable+threshold+on_fire"


def chk_residual_doubts_listed(ctx):
    """"the verdict's residual doubts carried into the manifest — an empty
    list is a statement, never an omission" (frozen Verify)."""
    err = require(ctx, "manifest")
    if err:
        return FAIL, err
    rd = g(ctx.manifest, "residual_doubts", default=None)
    if not isinstance(rd, list):
        return FAIL, "manifest.residual_doubts missing (must be a list; empty is a valid statement)"
    verdict, _evidence = _resolve_verdict(ctx)
    if verdict is not None:
        v_doubts = verdict.get("residual_doubts")
        if isinstance(v_doubts, list) and v_doubts and not rd:
            return FAIL, f"hostile-read verdict carries {len(v_doubts)} residual doubt(s) but manifest.residual_doubts is empty"
    return PASS, f"manifest.residual_doubts present, {len(rd)} entries"


DISPATCH_CHECKS = [
    ("packets_self_contained", chk_packets_self_contained),
    ("stories_inlined_with_enactments", chk_stories_inlined_with_enactments),
    ("red_first_instructed", chk_red_first_instructed),
    ("acceptance_builder_runnable", chk_acceptance_builder_runnable),
    ("ambiguity_defaults_inlined", chk_ambiguity_defaults_inlined),
    ("characterization_pinned_where_behavior_exists", chk_characterization_pinned_where_behavior_exists),
    ("undo_present_where_system_changes", chk_undo_present_where_system_changes),
    ("anchors_present", chk_anchors_present),
    ("holdout_separated", chk_holdout_separated),
    ("holdout_covers_merge_gating_stories", chk_holdout_covers_merge_gating_stories),
    ("policy_complete", chk_policy_complete),
    ("hostile_read_approved", chk_hostile_read_approved),
    ("downpath_or_irreversible_for_schema_and_data", chk_downpath_or_irreversible),
    ("tripwires_armed", chk_tripwires_armed),
    ("residual_doubts_listed", chk_residual_doubts_listed),
]


PHASES = {
    "frame": FRAME_CHECKS,
    "carve": CARVE_CHECKS,
    "sequence": SEQUENCE_CHECKS,
    "dispatch": DISPATCH_CHECKS,
}


# --------------------------------------------------------------------------
# Runner
# --------------------------------------------------------------------------

def git_toplevel(start="."):
    try:
        out = subprocess.run(
            ["git", "-C", str(start), "rev-parse", "--show-toplevel"],
            capture_output=True, text=True, timeout=10,
        )
        if out.returncode == 0:
            return out.stdout.strip()
    except (OSError, subprocess.SubprocessError):
        pass
    return None


def run_phase(phase, plan_dir, repo_root):
    ctx = Ctx(plan_dir, repo_root)
    results = []
    for criterion, fn in PHASES[phase]:
        try:
            status, evidence = fn(ctx)
        except Exception as e:  # noqa: BLE001 — a check must never crash the run
            status, evidence = FAIL, f"internal check error ({type(e).__name__}): {e}"
        results.append(Result(criterion, status, evidence))
    return results


def main(argv=None):
    parser = argparse.ArgumentParser(
        prog="plan-check",
        description="Mechanical verifier for the EDD planning protocol's gates.",
    )
    parser.add_argument("--phase", required=True, choices=sorted(PHASES.keys()))
    parser.add_argument("--plan-dir", default=".")
    parser.add_argument("--repo-root", default=None)
    parser.add_argument("--json", action="store_true")
    args = parser.parse_args(argv)

    plan_dir = Path(args.plan_dir)
    if not plan_dir.is_dir():
        print(f"plan-check: error: --plan-dir {plan_dir} is not a directory", file=sys.stderr)
        return 2

    if args.repo_root:
        repo_root = Path(args.repo_root)
        if not repo_root.is_dir():
            print(f"plan-check: error: --repo-root {repo_root} is not a directory", file=sys.stderr)
            return 2
    else:
        top = git_toplevel(".")
        repo_root = Path(top) if top else Path(".").resolve()

    results = run_phase(args.phase, plan_dir, repo_root)

    if args.json:
        print(json.dumps([r.to_json() for r in results], indent=2))
    else:
        for r in results:
            print(r.line())

    return 1 if any(r.status == FAIL for r in results) else 0


if __name__ == "__main__":
    sys.exit(main())
