def chk_waits_owned_and_escalatable(ctx):
    """"Every wait the work will meet ... each with owner, assumed-or-measured
    duration, and escalation trigger" (SEQUENCE.waits procedure;
    waits_owned_and_escalatable checklist key)."""
    err = require(ctx, "sequence")
    if err:
        return FAIL, err
    waits = g(ctx.sequence, "waits", default=None)
    if not isinstance(waits, list) or not waits:
        return FAIL, "sequence.waits missing or empty (the review/merge wait always exists)"
    bad = []
    for w in waits:
        if not isinstance(w, dict):
            bad.append("non-object wait")
            continue
        wid = w.get("id", "?")
        missing = [k for k in ("waits_on", "owner", "basis", "escalate_after") if not nonempty_str(str(w.get(k, "")))]
        if not isinstance(w.get("expected_days"), (int, float)):
            missing.append("expected_days(number)")
        if w.get("basis") not in (None, "assumption", "measured"):
            pass  # already checked non-empty above; enum-checked below
        if w.get("basis") not in ("assumption", "measured"):
            missing.append(f"basis(got {w.get('basis')!r})")
        if not isinstance(w.get("serves"), list) or not w.get("serves"):
            missing.append("serves[]")
        if missing:
            bad.append(f"{wid}: {','.join(sorted(set(missing)))}")
    if bad:
        return FAIL, truncate_list(bad)
    return PASS, f"{len(waits)} waits, all carry waits_on+owner+expected_days+basis+escalate_after+serves"


def chk_windows_batched_or_justified(ctx):
    """"every window serving more than one story batched, or the separation
    justified — `unbatched_because` owed only where another wait shares the
    same `waits_on`, a lone window has nothing to batch with" (law 1;
    sequenced Verify; windows_batched_or_justified checklist key; doc sha
    a944e7c19eae)."""
    err = require(ctx, "sequence")
    if err:
        return FAIL, err
    waits = [w for w in g(ctx.sequence, "waits", default=[]) if isinstance(w, dict)]
    waits_on_counts = {}
    for w in waits:
        waits_on_counts[w.get("waits_on")] = waits_on_counts.get(w.get("waits_on"), 0) + 1

    bad = []
    windowed = 0
    lone = 0
    for w in waits:
        if not nonempty_str(w.get("starts_after")):
            continue
        windowed += 1
        serves = w.get("serves") or []
        if len(serves) > 1:
            continue  # inherently batched
        shares_waits_on = waits_on_counts.get(w.get("waits_on"), 0) > 1
        if not shares_waits_on:
            lone += 1  # lone window — nothing to batch with, nothing owed
            continue
        if not nonempty_str(w.get("unbatched_because")):
            bad.append(f"{w.get('id','?')}: shares waits_on={w.get('waits_on')!r} with another wait, "
                        f"serves<=1, no unbatched_because")
    if bad:
        return FAIL, truncate_list(bad)
    return PASS, (f"{windowed} window-shaped wait(s): {lone} lone window (nothing to batch with), "
                  f"rest batch >1 story or state unbatched_because where another wait shared the same waits_on")


def chk_rungs_enabled_or_downgraded(ctx):
    """"every rung above E2 resolving to an enabler, a wait, or a recorded
    downgrade" (sequenced Verify)."""
    err = require(ctx, "frame", "sequence")
    if err:
        return FAIL, err
    stories = [s for s in g(ctx.frame, "stories", default=[]) if isinstance(s, dict)]
    above_e2 = [s for s in stories if s.get("rung") in E_ORDER and E_ORDER[s["rung"]] > E_ORDER["E2"]]
    if not above_e2:
        return PASS, "no story above E2"
    enablers = g(ctx.sequence, "enablers", default=[])
    enabler_rungs = {e.get("enables_rung") for e in enablers if isinstance(e, dict)}
    waits = g(ctx.sequence, "waits", default=[])
    served_ids = set()
    for w in waits if isinstance(waits, list) else []:
        if isinstance(w, dict):
            served_ids.update(w.get("serves") or [])
    downgraded_ids = {d.get("story") for d in g(ctx.sequence, "downgrades", default=[]) if isinstance(d, dict)}

    bad = []
    for s in above_e2:
        sid = s.get("id", "?")
        rung = s["rung"]
        ok = (rung in enabler_rungs) or (sid in served_ids) or (sid in downgraded_ids)
        if not ok:
            bad.append(f"{sid}(rung {rung})")
    if bad:
        return FAIL, f"no enabler/wait/downgrade accounts for: {truncate_list(bad)}"
    return PASS, f"{len(above_e2)} stories above E2, each resolves to an enabler, a wait, or a downgrade"


def chk_obligations_owned_dated_and_gating(ctx):
    """"Obligations that outlive merge ... each with owner, due date, and the
    action it gates" (SEQUENCE.waits procedure; obligations_owned_dated_and_gating
    checklist key)."""
    err = require(ctx, "sequence")
    if err:
        return FAIL, err
    obs = g(ctx.sequence, "obligations", default=None)
    if not isinstance(obs, list):
        return FAIL, "sequence.obligations missing (must be a list, empty allowed)"
    bad = []
    for i, o in enumerate(obs):
        if not isinstance(o, dict):
            bad.append(f"obligations[{i}] not an object")
            continue
        missing = [k for k in ("gates_action", "owner", "due") if not nonempty_str(o.get(k))]
        if o.get("kind") not in ("proof", "record"):
            missing.append(f"kind(got {o.get('kind')!r})")
        elif o["kind"] == "proof" and not nonempty_str(o.get("rung")):
            missing.append("rung(required for kind=proof)")
        if missing:
            bad.append(f"obligations[{i}]: {','.join(missing)}")
    if bad:
        return FAIL, truncate_list(bad)
    return PASS, f"{len(obs)} obligations, all carry kind+owner+due+gates_action"


def chk_downgrades_authorized_or_blocking(ctx):
    """"Downgrades carry authorized_by, or decision_needed_from when nobody
    present holds the authority" (SEQUENCE.waits procedure;
    downgrades_authorized_or_blocking checklist key)."""
    err = require(ctx, "sequence")
    if err:
        return FAIL, err
    dg = g(ctx.sequence, "downgrades", default=None)
    if not isinstance(dg, list):
        return FAIL, "sequence.downgrades missing (must be a list, empty allowed)"
    bad = []
    for i, d in enumerate(dg):
        if not isinstance(d, dict):
            bad.append(f"downgrades[{i}] not an object")
            continue
        missing = [k for k in ("story", "from", "to", "justification") if not nonempty_str(d.get(k))]
        has_auth = nonempty_str(d.get("authorized_by"))
