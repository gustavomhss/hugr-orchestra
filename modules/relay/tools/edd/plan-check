# --------------------------------------------------------------------------
# Result plumbing
# --------------------------------------------------------------------------

PASS, FAIL, SKIP = "PASS", "FAIL", "SKIP"

E_ORDER = {"E1": 1, "E2": 2, "E3": 3, "E4": 4, "E5": 5}
# T4 is empirical (it saw behavior) so it is treated as at least as strong as
# T1 for "weakest tier" purposes; T3 is always the floor. See planning-protocol.md
# "Scope tiers" table, lines ~76-96.
TIER_STRENGTH = {"T4": 0, "T1": 1, "T2": 2, "T3": 3}
SHA256_RE = re.compile(r"^sha256:[0-9a-f]{64}$")


class Result:
    __slots__ = ("criterion", "status", "evidence")

    def __init__(self, criterion, status, evidence):
        self.criterion = criterion
        self.status = status
        self.evidence = evidence

    def line(self):
        return f"{self.status} {self.criterion} — {self.evidence}"

    def to_json(self):
        return {"criterion": self.criterion, "status": self.status, "evidence": self.evidence}


def truncate_list(items, n=6):
    items = list(items)
    if len(items) <= n:
        return ", ".join(str(i) for i in items)
    return ", ".join(str(i) for i in items[:n]) + f", ...and {len(items) - n} more"


# --------------------------------------------------------------------------
# Generic helpers
# --------------------------------------------------------------------------

def load_json(path):
    """Returns (data, error_string). Never raises."""
    try:
        with open(path, "r", encoding="utf-8") as f:
            return json.load(f), None
    except FileNotFoundError:
        return None, f"file not found: {path}"
    except json.JSONDecodeError as e:
        return None, f"invalid JSON in {path}: {e}"
    except OSError as e:
        return None, f"cannot read {path}: {e}"


def sha256_file(path):
    try:
        h = hashlib.sha256()
        with open(path, "rb") as f:
            for chunk in iter(lambda: f.read(65536), b""):
                h.update(chunk)
        return "sha256:" + h.hexdigest()
    except OSError:
        return None


def is_real_sha256(s):
    return isinstance(s, str) and bool(SHA256_RE.match(s))


def g(d, *path, default=None):
    """Safe nested getter: g(d, 'a', 'b', default=[]) ~= d.get('a',{}).get('b',[])."""
    cur = d
    for p in path:
        if not isinstance(cur, dict):
            return default
        cur = cur.get(p, None)
        if cur is None:
            return default
    return cur if cur is not None else default


def nonempty_str(v):
    return isinstance(v, str) and v.strip() != ""


AT_SHA256_RE = re.compile(r"^(?P<path>.+?)\s@\ssha256:(?P<digest>[0-9a-f]{64})$")


def parse_at_sha256_ref(s):
    """Parses the standalone-run `<path> @ sha256:<digest>` ref format (doc
    sha 4a61f9c33733, "Run without an enforcer": 'A standalone verdict_ref
    renders as `<path> @ sha256:<digest>` — both legs checkable'). Returns
    (path, "sha256:<digest>") or (None, None) if `s` isn't in this shape.
    Applies to any *_ref field that may use the format, not only verdict_ref."""
    if not isinstance(s, str):
        return None, None
    m = AT_SHA256_RE.match(s.strip())
    if not m:
        return None, None
    return m.group("path"), "sha256:" + m.group("digest")


def resolve_ref_digest(ref_value):
    """A manifest *_ref field may be:
    - {"path": "...", "digest": "sha256:..."}  (execD / template shape)
    - "<path> @ sha256:<digest>"  (standalone-run shape, doc sha 4a61f9c33733)
    - a bare "sha256:..." string (older-form shape)
    - a bare non-digest string (URI, prose placeholder) -> unresolved
    Returns (path_or_None, digest_or_None).
    """
    if isinstance(ref_value, dict):
        return ref_value.get("path"), ref_value.get("digest")
    if isinstance(ref_value, str):
        path, digest = parse_at_sha256_ref(ref_value)
        if digest is not None:
            return path, digest
        if is_real_sha256(ref_value):
            return None, ref_value
        return None, None
    return None, None


