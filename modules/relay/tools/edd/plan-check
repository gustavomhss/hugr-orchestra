        return FAIL, truncate_list(bad)
    return PASS, f"{len(dg)} downgrades, each carries authorized_by or decision_needed_from"


def chk_contracts_frozen_before_dependents(ctx):
    """"No package that consumes an interface is dispatched before that
    interface is frozen" (law 7; sequenced Verify; contracts_frozen_before_dependents
    checklist key)."""
    err = require(ctx, "packages", "sequence")
    if err:
        return FAIL, err
    cf = g(ctx.sequence, "contract_freezes", default=None)
    if not isinstance(cf, list):
        return FAIL, "sequence.contract_freezes missing (must be a list, empty allowed)"
    if not cf:
        return PASS, "no contract_freezes declared"
    pkgs = {p.get("id"): p for p in g(ctx.packages, "packages", default=[]) if isinstance(p, dict)}
    positions = {o.get("package"): o.get("position") for o in g(ctx.sequence, "order", default=[]) if isinstance(o, dict)}
    bad = []
    for i, entry in enumerate(cf):
        if not isinstance(entry, dict) or not isinstance(entry.get("frozen_before"), list) or not entry.get("frozen_before"):
            bad.append(f"contract_freezes[{i}]: malformed / empty frozen_before")
            continue
        for dep_pkg in entry["frozen_before"]:
            p = pkgs.get(dep_pkg)
            if p is None:
                bad.append(f"contract_freezes[{i}]: frozen_before references unknown package {dep_pkg!r}")
                continue
            deps = p.get("deps") or []
            dep_pos = positions.get(dep_pkg)
            producer_ok = any(
                positions.get(d) is not None and dep_pos is not None and positions[d] < dep_pos
                for d in deps
            )
            if not deps or not producer_ok:
                bad.append(f"{dep_pkg}: no preceding deps[] package to justify the contract freeze")
    if bad:
        return FAIL, truncate_list(bad)
    return PASS, f"{len(cf)} contract_freezes, each frozen_before package has a preceding deps[] producer"


def chk_order_acyclic_and_justified(ctx):
    """"Dependency edges (cycles are carving defects, never scheduling inputs)"
    and "Sequence ... skeleton or reproduction first ..." (SEQUENCE.order
    procedure; order_acyclic_and_justified checklist key). Also checks that a
    conflicting pair's later package is marked forced_serial, not an unrelated
    rationale."""
    err = require(ctx, "packages", "sequence")
    if err:
        return FAIL, err
    n = num_packages(ctx)
    order = g(ctx.sequence, "order", default=[])
    if n < 2:
        if not order:
            return SKIP, "single-package plan — proportionality row 1 disables SEQUENCE.order"
        # falls through to validate if a single-package plan chose to render one anyway
    if not isinstance(order, list) or (n >= 2 and not order):
        return FAIL, f"{n} packages but sequence.order is empty/missing"

    valid_rationales = {"skeleton", "repro", "risk", "cost_of_delay", "opens_window", "forced_serial", "dependency"}
    bad = []
    pos_of = {}
    for i, o in enumerate(order):
        if not isinstance(o, dict) or not nonempty_str(o.get("package")) or not isinstance(o.get("position"), int):
            bad.append(f"order[{i}] malformed")
            continue
        if o.get("rationale") not in valid_rationales:
            bad.append(f"{o['package']}: rationale={o.get('rationale')!r} invalid")
        pos_of[o["package"]] = o["position"]

    positions = sorted(pos_of.values())
    if positions != list(range(1, len(pos_of) + 1)):
        bad.append(f"positions not a dense 1..N sequence: {positions}")

    pkgs = {p.get("id"): p for p in g(ctx.packages, "packages", default=[]) if isinstance(p, dict)}
    for pid, pos in pos_of.items():
        p = pkgs.get(pid)
        if p is None:
            bad.append(f"order references unknown package {pid!r}")
            continue
        for dep in p.get("deps") or []:
            dep_pos = pos_of.get(dep)
            if dep_pos is None:
                bad.append(f"{pid}: deps on {dep!r} which has no order position")
            elif dep_pos >= pos:
                bad.append(f"{pid}: deps on {dep} but {dep}'s position ({dep_pos}) is not before its own ({pos}) — cycle/misorder")

    conflicts = g(ctx.packages, "conflict_pairs", default=[])
    for c in conflicts if isinstance(conflicts, list) else []:
        if not isinstance(c, dict):
            continue
        a, b = c.get("a"), c.get("b")
        if a in pos_of and b in pos_of:
            later = a if pos_of[a] > pos_of[b] else b
            rationale = next((o.get("rationale") for o in order if isinstance(o, dict) and o.get("package") == later), None)
            if rationale not in ("forced_serial", "dependency"):
                bad.append(f"{later}: conflicts with {b if later == a else a} (shared allow-list files) "
                            f"but order.rationale={rationale!r}, expected forced_serial or dependency")

    if bad:
        return FAIL, truncate_list(bad)
    return PASS, f"{len(order)} order entries: acyclic against deps[], valid rationale, conflicts serialized"


def chk_parallel_sets_disjoint(ctx):
    """"parallel sets from pairwise-disjoint allow-lists, hotspots and T3-only
    scopes serialized ... and every package appearing in exactly one set —
    serial work renders as singleton sets, an empty list is not a statement"
    (SEQUENCE.order procedure + sequenced Verify, doc sha cc458f984138;
    parallel_sets_disjoint checklist key)."""
    err = require(ctx, "packages", "sequence")
    if err:
        return FAIL, err
    n = num_packages(ctx)
    psets = g(ctx.sequence, "parallel_sets", default=[])
    if n < 2 and not psets:
        return SKIP, "single-package plan — proportionality row 1 disables SEQUENCE.order/parallel_sets"
    if not isinstance(psets, list):
        return FAIL, "sequence.parallel_sets missing (must be a list)"
    pkgs = {p.get("id"): p for p in g(ctx.packages, "packages", default=[]) if isinstance(p, dict)}
    allow = {pid: {e.get("path") for e in (p.get("allow_list") or []) if isinstance(e, dict)}
             for pid, p in pkgs.items()}
    bad = []
    for si, pset in enumerate(psets):
        if not isinstance(pset, list):
            bad.append(f"parallel_sets[{si}] not a list")
            continue
        for i in range(len(pset)):
            for j in range(i + 1, len(pset)):
                a, b = pset[i], pset[j]
                shared = allow.get(a, set()) & allow.get(b, set())
                if shared:
                    bad.append(f"{a}+{b} declared parallel but share {truncate_list(shared, 3)}")
        if len(pset) > 1:
            t3 = [pid for pid in pset if pkgs.get(pid, {}).get("scope_tier") == "T3"]
            if t3:
                bad.append(f"T3-only package(s) {truncate_list(t3)} grouped in a parallel set of size {len(pset)} (must serialize)")

    # Every package appears in exactly one set — serial work renders as
    # singleton sets; an empty parallel_sets with real packages is a FAIL,
    # never a silent statement.
    all_ids = set(pkgs.keys())
    flat = [pid for pset in psets if isinstance(pset, list) for pid in pset]
    counts = Counter(flat)
    unknown = sorted(set(flat) - all_ids)
    duplicated = sorted(pid for pid, c in counts.items() if c > 1)
    missing = sorted(all_ids - set(flat))
    if unknown:
        bad.append(f"parallel_sets reference unknown package(s): {truncate_list(unknown)}")
    if duplicated:
        bad.append(f"package(s) appear in more than one parallel set: {truncate_list(duplicated)}")
    if missing:
        bad.append(f"package(s) missing from parallel_sets entirely (an empty list is not a "
                   f"statement — every package needs a set, serial work as a singleton): {truncate_list(missing)}")

    if bad:
        return FAIL, truncate_list(bad)
    return PASS, (f"{len(psets)} parallel set(s), pairwise disjoint on allow-lists, no T3-only "
                  f"package grouped, all {len(all_ids)} package(s) partitioned exactly once")


def chk_risk_phase_capped(ctx):
    """"risk retirement capped at the constant and labelled as such" (SEQUENCE.order
    procedure; risk_phase_capped checklist key; constant: 25% of packages at 4+
    packages, vacuous below that)."""
    err = require(ctx, "sequence")
    if err:
        return FAIL, err
    n = num_packages(ctx)
    rp = g(ctx.sequence, "risk_phase", default=None)
    if not isinstance(rp, dict):
        return FAIL, "sequence.risk_phase missing or not an object"
    if not isinstance(rp.get("packages"), list):
        return FAIL, "risk_phase.packages missing (must be a list)"
    if rp.get("labelled") is not True:
        return FAIL, "risk_phase.labelled is not true"
    if n < 4:
        return PASS, f"{n} packages (<4) — cap vacuously met per constants table"
    cap_fraction = rp.get("cap_fraction", 0.25)
    if not isinstance(cap_fraction, (int, float)):
        return FAIL, f"risk_phase.cap_fraction={cap_fraction!r} not numeric"
    cap = int(cap_fraction * n + 1e-9)
    if len(rp["packages"]) > cap:
        return FAIL, f"{len(rp['packages'])} risk-first packages exceeds cap {cap} ({cap_fraction}*{n})"
    return PASS, f"{len(rp['packages'])} risk-first packages within cap {cap} ({cap_fraction}*{n})"


def chk_forecast_has_basis_and_wait_share(ctx):
    """"every forecast duration carries a basis and the wait share is present"
    (sequenced Verify)."""
    err = require(ctx, "sequence")
    if err:
        return FAIL, err
    f = g(ctx.sequence, "forecast", default=None)
    if not isinstance(f, dict):
        return FAIL, "sequence.forecast missing or not an object"
    missing = []
    if f.get("most_likely") in (None, ""):
        missing.append("most_likely")
    rng = f.get("range")
    if not isinstance(rng, list) or len(rng) != 2:
        missing.append("range[opt,pess]")
    if not nonempty_str(f.get("basis")):
        missing.append("basis")
    ws = f.get("wait_share")
    if not isinstance(ws, (int, float)) or not (0 <= ws <= 1):
        missing.append(f"wait_share(got {ws!r}, must be 0..1)")
    if not isinstance(f.get("assumptions"), list):
        missing.append("assumptions[]")
    if not nonempty_str(f.get("revisit_trigger")):
        missing.append("revisit_trigger")
    if missing:
        return FAIL, f"forecast missing: {', '.join(missing)}"
    return PASS, f"most_likely={f['most_likely']}, wait_share={ws}, basis set, revisit_trigger set"


def chk_commitment_within_authority(ctx):
    """"only what fits inside declared authority may be marked committed"
    (law 9; sequenced Verify; commitment_within_authority checklist key)."""
    err = require(ctx, "frame", "sequence")
    if err:
        return FAIL, err
    f = g(ctx.sequence, "forecast", default={})
    ct = f.get("commitment_type")
    if ct not in ("forecast_only", "committed"):
        return FAIL, f"forecast.commitment_type={ct!r}, must be forecast_only|committed"
