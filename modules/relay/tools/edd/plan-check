# Context: everything a check needs, loaded once, defensively
# --------------------------------------------------------------------------

class Ctx:
    def __init__(self, plan_dir, repo_root):
        self.plan_dir = Path(plan_dir)
        self.repo_root = Path(repo_root)

        self._repo_basenames = None  # lazy index, built by repo_anchor_resolves()

        self.frame, self.frame_err = load_json(self.plan_dir / "frame.json")
        self.packages, self.packages_err = load_json(self.plan_dir / "packages.json")
        self.sequence, self.sequence_err = load_json(self.plan_dir / "sequence.json")
        self.manifest, self.manifest_err = load_json(self.plan_dir / "manifest.json")

        packets_dir = self.plan_dir / "packets"
        self.packet_files = {}   # package_id-ish filename stem -> text
        self.packet_paths = {}   # filename -> Path
        if packets_dir.is_dir():
            for p in sorted(packets_dir.glob("*.md")):
                txt = read_text(p)
                if txt is not None:
                    self.packet_files[p.name] = txt
                    self.packet_paths[p.name] = p

    def repo_path_exists(self, relpath):
        if not isinstance(relpath, str) or not relpath.strip():
            return False
        # strip a trailing :line or :line-line anchor if present
        clean = re.sub(r":\d+(-\d+)?$", "", relpath.strip())
        try:
            return (self.repo_root / clean).exists()
        except OSError:
            return False

    def repo_anchor_resolves(self, relpath):
        """Like repo_path_exists, but falls back to a basename search across the
        repo tree for a bare/partial filename (e.g. a packet prose mention of
        `paths.rs` when the same file is elsewhere cited by its full path) —
        used only by the anchors_present heuristic, never by scope/allow-list
        checks, where a bare-filename false-negative would hide a real gap."""
        if self.repo_path_exists(relpath):
            return True
        clean = re.sub(r":\d+(-\d+)?$", "", relpath.strip())
        basename = Path(clean).name
        if not basename:
            return False
        if self._repo_basenames is None:
            self._repo_basenames = set()
            for dirpath, dirnames, filenames in os.walk(self.repo_root):
                dirnames[:] = [d for d in dirnames if d != ".git"]
                for fn in filenames:
                    self._repo_basenames.add(fn)
        return basename in self._repo_basenames

    def plan_path_resolve(self, relpath):
        """Resolve a path that may be relative to plan_dir (including '../' escapes,
        used by standalone holdout stores). Returns Path or None."""
        if not isinstance(relpath, str) or not relpath.strip():
            return None
        if "://" in relpath:
            return None
        try:
            candidate = (self.plan_dir / relpath).resolve()
            return candidate if candidate.exists() else None
        except OSError:
            return None

    def all_packet_text(self):
        return "\n".join(self.packet_files.values())


def require(ctx, *names):
    """Returns None if all named artifacts loaded cleanly, else an evidence string."""
    missing = []
    for n in names:
        data = getattr(ctx, n)
        err = getattr(ctx, f"{n}_err")
        if data is None:
            missing.append(err or f"{n}.json missing")
    if missing:
        return "; ".join(missing)
    return None


