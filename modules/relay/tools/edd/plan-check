UNDO_MECHANISMS = ("flag", "revert", "reverse_migration", "declared_irreversible")


def chk_undo_named_where_needed(ctx):
    """"its undo mechanism is named here" (CARVE.carve procedure; law 10;
    undo_named_where_needed checklist key). `undo` is an ORDERED ARRAY of layers
    (schema doc fb2c41e78c72): [{mechanism: flag|revert|reverse_migration|
    declared_irreversible, command}] — declared_irreversible's `command` carries
    the declaration text in place of a runnable command. Applied to every
    kind=work package, since a merged work package is by definition a change
    to the running system. The old single-object shape is a FAIL, not aliased."""
    err = require(ctx, "packages")
    if err:
        return FAIL, err
    pkgs = g(ctx.packages, "packages", default=[])
    work = [p for p in pkgs if isinstance(p, dict) and p.get("kind") == "work"]
    bad = []
    for p in work:
        pid = p.get("id", "?")
        u = p.get("undo")
        if isinstance(u, dict):
            bad.append(f"{pid}: undo is a single object (old shape) — schema now requires an array of layers")
            continue
        if not isinstance(u, list) or not u:
            bad.append(f"{pid}: undo missing or not a non-empty array of layers")
            continue
        for i, layer in enumerate(u):
            if not isinstance(layer, dict) or layer.get("mechanism") not in UNDO_MECHANISMS \
                    or not nonempty_str(layer.get("command")):
                bad.append(f"{pid}.undo[{i}]: mechanism/command missing or mechanism not in {UNDO_MECHANISMS}")
    if bad:
        return FAIL, truncate_list(bad)
    return PASS, f"{len(work)} work packages, all name an undo mechanism"


def chk_merge_rungs_set(ctx):
    """"every package carrying its merge rung, equal to the highest rung its
    merge-required stories demand" (carved Verify)."""
    err = require(ctx, "frame", "packages")
    if err:
        return FAIL, err
    story_rung = {s.get("id"): s.get("rung") for s in g(ctx.frame, "stories", default=[]) if isinstance(s, dict)}
    pkgs = g(ctx.packages, "packages", default=[])
    bad = []
    for p in pkgs if isinstance(pkgs, list) else []:
        pid = p.get("id", "?") if isinstance(p, dict) else "?"
        mr = p.get("merge_rung")
        if mr not in E_ORDER:
            bad.append(f"{pid}: merge_rung={mr!r} invalid")
            continue
        story_ids = p.get("enacts_stories") or []
        rungs = []
        for sid in story_ids:
            r = story_rung.get(sid)
            if r not in E_ORDER:
                bad.append(f"{pid}: enacted story {sid} not found in frame.stories (or has no valid rung)")
                continue
            rungs.append(r)
        if not rungs:
            continue
        expected = max(rungs, key=lambda r: E_ORDER[r])
        if E_ORDER[mr] != E_ORDER[expected]:
            bad.append(f"{pid}: merge_rung={mr} but highest enacted-story rung is {expected}")
    if bad:
        return FAIL, truncate_list(bad)
    return PASS, f"{len(pkgs)} packages: merge_rung equals the highest rung among enacted stories"


def chk_conflict_pairs_computed(ctx):
    """"conflict pairs computed from intersections, not asserted" (carved
    Verify) — recomputed from allow-list intersections and compared to the
    declared conflict_pairs, not trusted. Also carries the Hotspot
    definition's scope rule (doc sha cc458f984138): "the decile computed
    repo-wide, but recorded only where it intersects an allow-list — a
    hotspot no package touches serializes nothing and is noise in the
    record." Any declared `hotspots[]` entry that isn't in ANY package's
    allow-list fails here, naming the out-of-scope path."""
    err = require(ctx, "packages")
    if err:
        return FAIL, err
    pkgs = g(ctx.packages, "packages", default=[])
    if not isinstance(pkgs, list):
        return FAIL, "packages.json packages[] missing"
    allow = {}
    for p in pkgs:
        if not isinstance(p, dict):
            continue
        pid = p.get("id", "?")
        allow[pid] = {e.get("path") for e in (p.get("allow_list") or []) if isinstance(e, dict) and e.get("path")}
    all_allow_listed = set().union(*allow.values()) if allow else set()
    ids = sorted(allow)
    computed = {}
    for i in range(len(ids)):
        for j in range(i + 1, len(ids)):
            a, b = ids[i], ids[j]
            shared = allow[a] & allow[b]
            if shared:
                computed[frozenset((a, b))] = shared

    declared = g(ctx.packages, "conflict_pairs", default=None)
    if not isinstance(declared, list):
        return FAIL, "packages.json conflict_pairs missing (must be a list, empty allowed)"
    declared_map = {}
    bad = []
    for entry in declared:
        if not isinstance(entry, dict) or not nonempty_str(entry.get("a")) or not nonempty_str(entry.get("b")):
            bad.append(f"malformed conflict_pairs entry {entry!r}")
            continue
        key = frozenset((entry["a"], entry["b"]))
        declared_map[key] = set(entry.get("shared") or [])

    missing_pairs = [tuple(sorted(k)) for k in computed if k not in declared_map]
    extra_pairs = [tuple(sorted(k)) for k in declared_map if k not in computed]
    mismatched = [tuple(sorted(k)) for k in (computed.keys() & declared_map.keys())
                  if computed[k] != declared_map[k]]
    if missing_pairs:
        bad.append(f"undeclared but real (shared files): {truncate_list(missing_pairs)}")
    if extra_pairs:
        bad.append(f"declared but no actual shared file: {truncate_list(extra_pairs)}")
    if mismatched:
        bad.append(f"shared[] list wrong for: {truncate_list(mismatched)}")

    hotspots = g(ctx.packages, "hotspots", default=[])
    if not isinstance(hotspots, list):
        bad.append("packages.json hotspots missing (must be a list, empty allowed)")
    else:
        out_of_scope = [h for h in hotspots if h not in all_allow_listed]
        if out_of_scope:
            bad.append(f"hotspot(s) not in any package's allow-list (noise in the record per the "
                       f"Hotspot definition's recording rule): {truncate_list(out_of_scope)}")

    if bad:
        return FAIL, "; ".join(bad)
    return PASS, (f"{len(computed)} conflicting pair(s) recomputed from allow-list intersections match "
                  f"declared conflict_pairs; {len(hotspots)} hotspot(s) all intersect some allow-list")


def chk_sizing_claims_recorded(ctx):
    """"the sizing claim is recorded and will be graded by tripwire" (CARVE.size
    procedure; sizing_claims_recorded checklist key)."""
    err = require(ctx, "packages")
    if err:
        return FAIL, err
    pkgs = g(ctx.packages, "packages", default=[])
    bad = []
    for p in pkgs if isinstance(pkgs, list) else []:
        pid = p.get("id", "?") if isinstance(p, dict) else "?"
        s = p.get("sizing")
        if not isinstance(s, dict) or s.get("mode") not in ("session", "checkpointed"):
            bad.append(f"{pid}: sizing.mode invalid/missing")
            continue
        basis = s.get("claim_basis")
        if not isinstance(basis, str) or not (basis.startswith("measured") or basis.startswith("default_unmeasured")):
            bad.append(f"{pid}: sizing.claim_basis={basis!r} (must start with measured|default_unmeasured)")
    if bad:
        return FAIL, truncate_list(bad)
    return PASS, f"{len(pkgs)} packages, all carry sizing.mode + claim_basis"


def chk_upstream_binding_carried(ctx):
    """"the frame's upstream binding carried forward unchanged" (carved
    Verify — no checklist key of its own; coined here as
    upstream_binding_carried per protocol doc a944e7c19eae).
    packages.json now carries a top-level `upstream_binding` echoed verbatim
    from frame.json; this check compares them for equality."""
    err = require(ctx, "frame", "packages")
    if err:
        return FAIL, err
    frame_ub = g(ctx.frame, "upstream_binding", default=None)
    pkg_ub = ctx.packages.get("upstream_binding") if isinstance(ctx.packages, dict) else None
    if not ctx.packages or "upstream_binding" not in ctx.packages:
        return FAIL, "packages.json upstream_binding field missing"
    if pkg_ub != frame_ub:
        return FAIL, f"packages.json upstream_binding differs from frame.json's (packages={pkg_ub!r} vs frame={frame_ub!r})"
    return PASS, "packages.json upstream_binding matches frame.json's verbatim"


