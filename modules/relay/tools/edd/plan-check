def chk_requirements_partition_over_closers(ctx):
    """"requirements partition exactly over closers (no orphans, no double
    closers — a global requirement still has one closer)" (carved Verify — no
    checklist key of its own; coined here)."""
    err = require(ctx, "frame", "packages")
    if err:
        return FAIL, err
    req_ids = [r.get("id") for r in g(ctx.frame, "requirements", default=[]) if isinstance(r, dict) and r.get("id")]
    if not req_ids:
        return FAIL, "no requirements found in frame.json to partition"
    pkgs = g(ctx.packages, "packages", default=[])
    counts = {rid: 0 for rid in req_ids}
    unknown = []
    for p in pkgs if isinstance(pkgs, list) else []:
        for rid in (p.get("closes_reqs") or []) if isinstance(p, dict) else []:
            if rid in counts:
                counts[rid] += 1
            else:
                unknown.append(f"{p.get('id','?')} closes unknown req {rid!r}")
    orphans = [rid for rid, c in counts.items() if c == 0]
    doubles = [f"{rid}(x{c})" for rid, c in counts.items() if c > 1]
    bad = []
    if orphans:
        bad.append(f"orphaned (closed by none): {truncate_list(orphans)}")
    if doubles:
        bad.append(f"double-closed: {truncate_list(doubles)}")
    if unknown:
        bad.append(truncate_list(unknown))
    if bad:
        return FAIL, "; ".join(bad)
    return PASS, f"{len(req_ids)} requirements each closed by exactly one package"


def chk_packages_cut(ctx):
    """"Cut the work into packages, each the smallest independently mergeable
    unit" (CARVE.carve procedure; packages_cut checklist key)."""
    err = require(ctx, "packages")
    if err:
        return FAIL, err
    pkgs = g(ctx.packages, "packages", default=None)
    if not isinstance(pkgs, list) or not pkgs:
        return FAIL, "packages.json packages[] missing or empty"
    bad = []
    for p in pkgs:
        if not isinstance(p, dict):
            bad.append("non-object package")
            continue
        pid = p.get("id", "<no id>")
        missing = [k for k in ("id", "intent") if not nonempty_str(p.get(k))]
        if p.get("kind") not in ("work", "discovery"):
            missing.append(f"kind(got {p.get('kind')!r})")
        for lk in ("closes_reqs", "enacts_stories", "allow_list", "out_of_scope", "deps"):
            if not isinstance(p.get(lk), list):
                missing.append(f"{lk}(list)")
        if missing:
            bad.append(f"{pid}: {','.join(missing)}")
    if bad:
        return FAIL, truncate_list(bad)
    return PASS, f"{len(pkgs)} packages, all carry required shape"


