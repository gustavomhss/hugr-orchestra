def chk_upstream_bound(ctx):
    """"the upstream binding present in one of its two forms" (framed Verify)."""
    err = require(ctx, "frame")
    if err:
        return FAIL, err
    ub = g(ctx.frame, "upstream_binding", default=None)
    if not isinstance(ub, dict):
        return FAIL, "frame.upstream_binding missing or not an object"
    kind = ub.get("kind")
    if kind == "inherited":
        if not nonempty_str(ub.get("digest")):
            return FAIL, "upstream_binding.kind=inherited but digest is empty/missing"
        return PASS, f"kind=inherited, digest={ub.get('digest')}"
    if kind == "reconstructed":
        missing = [k for k in ("source", "digest") if not nonempty_str(ub.get(k))]
        if missing:
            return FAIL, f"upstream_binding.kind=reconstructed missing field(s): {', '.join(missing)}"
        return PASS, f"kind=reconstructed, source set, digest={ub.get('digest')}"
    return FAIL, f"upstream_binding.kind is {ub.get('kind')!r}, must be inherited|reconstructed"


def chk_inputs_classified(ctx):
    """"every input carrying a provenance class" (framed Verify)."""
    err = require(ctx, "frame")
    if err:
        return FAIL, err
    inputs = g(ctx.frame, "inputs", default=None)
    if not isinstance(inputs, list) or not inputs:
        return FAIL, "frame.inputs missing or empty"
    bad = []
    for i, item in enumerate(inputs):
        if not isinstance(item, dict):
            bad.append(f"inputs[{i}] not an object")
            continue
        cls = item.get("class")
        if cls not in ("inherited", "reconstructed", "asserted"):
            bad.append(f"inputs[{i}].class={cls!r}")
            continue
        missing = [k for k in ("input", "wrong_if", "could_confirm") if not nonempty_str(item.get(k))]
        if missing:
            bad.append(f"inputs[{i}] missing {','.join(missing)}")
    if bad:
        return FAIL, truncate_list(bad)
    return PASS, f"{len(inputs)} inputs, all carry a valid class + wrong_if + could_confirm"


def chk_authority_declared(ctx):
    """"the authority declaration present with who holds what is missing" (framed Verify)."""
    err = require(ctx, "frame")
    if err:
        return FAIL, err
    auth = g(ctx.frame, "authority", default=None)
    if not isinstance(auth, dict):
        return FAIL, "frame.authority missing or not an object"
    level = auth.get("level")
    if level not in ("full", "partial", "none"):
        return FAIL, f"authority.level={level!r}, must be full|partial|none"
    if level in ("partial", "none"):
        mhb = auth.get("missing_held_by")
        empty = mhb is None or (isinstance(mhb, str) and not mhb.strip()) or (isinstance(mhb, (dict, list)) and not mhb)
        if empty:
            return FAIL, f"authority.level={level} but missing_held_by is empty"
    return PASS, f"level={level}, missing_held_by present where required"


def chk_decision_rights_named(ctx):
    """"both decision rights named" (framed Verify)."""
    err = require(ctx, "frame")
    if err:
        return FAIL, err
    dr = g(ctx.frame, "decision_rights", default=None)
    if not isinstance(dr, dict):
        return FAIL, "frame.decision_rights missing or not an object"
    missing = [k for k in ("scope_change", "merge") if not nonempty_str(dr.get(k))]
    if missing:
        return FAIL, f"decision_rights missing: {', '.join(missing)}"
    return PASS, f"scope_change={dr['scope_change']!r}, merge={dr['merge']!r}"


def chk_campaign_call_made(ctx):
    """"the campaign call recorded either way" (framed Verify)."""
    err = require(ctx, "frame")
    if err:
        return FAIL, err
    camp = g(ctx.frame, "campaign", default=None)
    if not isinstance(camp, dict):
        return FAIL, "frame.campaign missing or not an object"
    if not isinstance(camp.get("opened"), bool):
        return FAIL, f"campaign.opened={camp.get('opened')!r}, must be boolean"
    if camp["opened"] and not nonempty_str(camp.get("kind")):
        return FAIL, "campaign.opened=true but kind is empty"
    if not nonempty_str(camp.get("named_reason")):
        return FAIL, "campaign.named_reason is empty"
    return PASS, f"opened={camp['opened']}, named_reason present"


def chk_baseline_captured(ctx):
    """"the baseline present with suite state and promise level, and the repo's
    enforced gates recorded (an empty list is a statement)" (framed Verify)."""
    err = require(ctx, "frame")
    if err:
        return FAIL, err
    b = g(ctx.frame, "baseline", default=None)
    if not isinstance(b, dict):
        return FAIL, "frame.baseline missing or not an object"
    suite = b.get("suite")
    if suite not in ("green", "red", "absent", "unmeasured"):
        return FAIL, f"baseline.suite={suite!r}, must be green|red|absent|unmeasured"
    promise = b.get("promise")
    if promise not in ("full", "seam_only"):
        return FAIL, f"baseline.promise={promise!r}, must be full|seam_only"
    if "repo_gates" not in ctx.frame or not isinstance(ctx.frame.get("repo_gates"), list):
        return FAIL, "frame.repo_gates missing or not a list (an empty list is a statement, absence is not)"
    return PASS, f"suite={suite}, promise={promise}, repo_gates: {len(ctx.frame['repo_gates'])} entries"


def chk_impact_depth_declared(ctx):
    """"every impact entry carries a tier and the set carries a depth" (framed Verify)."""
    err = require(ctx, "frame")
    if err:
        return FAIL, err
    impact = g(ctx.frame, "impact", default=None)
    if not isinstance(impact, dict):
        return FAIL, "frame.impact missing or not an object"
    depth = impact.get("depth")
    if not (depth == "direct" or depth == "full" or (isinstance(depth, str) and re.match(r"^transitive_\d+$", depth))):
        return FAIL, f"impact.depth={depth!r}, must be direct|transitive_N|full"
    entries = impact.get("entries")
    if not isinstance(entries, list) or not entries:
        return FAIL, "impact.entries missing or empty"
    bad = []
    for i, e in enumerate(entries):
        if not isinstance(e, dict) or not nonempty_str(e.get("path")) or e.get("tier") not in ("T1", "T2", "T3", "T4"):
            bad.append(f"entries[{i}]={e!r}")
    if bad:
        return FAIL, truncate_list(bad)
    return PASS, f"depth={depth}, {len(entries)} entries all carry a valid tier"


def chk_repro_state_recorded(ctx):
    """"defect work either reproduced or its first package is the reproduction"
    (framed Verify)."""
    err = require(ctx, "frame")
    if err:
        return FAIL, err
    repro = g(ctx.frame, "repro", default=None)
    if not isinstance(repro, dict):
        return FAIL, "frame.repro missing or not an object"
    state = repro.get("state")
    if state not in ("reproduced", "is_first_package", "no_defect"):
        return FAIL, f"repro.state={state!r}, must be reproduced|is_first_package|no_defect"
    return PASS, f"state={state}"


def chk_pinning_decided(ctx):
    """"every pinning decision carrying its seam, the behavior, and either an
    existing pin or the characterization command that will create one" (framed Verify)."""
    err = require(ctx, "frame")
    if err:
        return FAIL, err
    pinning = g(ctx.frame, "pinning", default=None)
    if not isinstance(pinning, list):
        return FAIL, "frame.pinning missing (must be a list, empty allowed if nothing needs pinning)"
    bad = []
    for i, p in enumerate(pinning):
        if not isinstance(p, dict):
            bad.append(f"pinning[{i}] not an object")
            continue
        missing = [k for k in ("seam", "behavior", "characterization_command") if not nonempty_str(p.get(k))]
        if not isinstance(p.get("exists"), bool):
            missing.append("exists(bool)")
        if missing:
            bad.append(f"pinning[{i}] missing {','.join(missing)}")
    if bad:
        return FAIL, truncate_list(bad)
    return PASS, f"{len(pinning)} pinning entries, all carry seam+behavior+characterization_command"


def chk_requirements_quote_span(ctx):
    """"every requirement quotes a span" (framed Verify — no checklist key of its
    own; coined here as requirements_quote_span). Also validates the requirement's
    scope field (local|global), required by the schema (state contracts / FRAME)."""
    err = require(ctx, "frame")
    if err:
        return FAIL, err
    reqs = g(ctx.frame, "requirements", default=None)
    if not isinstance(reqs, list) or not reqs:
        return FAIL, "frame.requirements missing or empty"
    bad = []
    for r in reqs:
        if not isinstance(r, dict):
            bad.append("non-object requirement")
            continue
        rid = r.get("id", "<no id>")
        if not nonempty_str(r.get("text")):
            bad.append(f"{rid}: empty text")
        if r.get("scope") not in ("local", "global"):
            bad.append(f"{rid}: scope={r.get('scope')!r} (must be local|global)")
        q = r.get("quotes")
        if not isinstance(q, dict) or not nonempty_str(q.get("source")) or not nonempty_str(q.get("span")):
            bad.append(f"{rid}: quotes.source/quotes.span missing")
        if not nonempty_str(r.get("acceptance_source")):
            bad.append(f"{rid}: acceptance_source missing")
    if bad:
        return FAIL, truncate_list(bad)
    return PASS, f"{len(reqs)} requirements, all quote a source span and carry scope"


def chk_acceptance_resolves_to_commands(ctx):
    """"every acceptance criterion parses as a runnable command" (framed Verify)."""
    err = require(ctx, "frame")
    if err:
        return FAIL, err
    reqs = g(ctx.frame, "requirements", default=[])
    bad = []
    total = 0
    for r in reqs if isinstance(reqs, list) else []:
        rid = r.get("id", "<no id>") if isinstance(r, dict) else "<bad req>"
        acc = r.get("acceptance") if isinstance(r, dict) else None
        if not isinstance(acc, list) or not acc:
            bad.append(f"{rid}: acceptance missing/empty")
            continue
        for j, a in enumerate(acc):
            total += 1
            if not isinstance(a, dict) or not nonempty_str(a.get("criterion")) or not nonempty_str(a.get("command")):
                bad.append(f"{rid}.acceptance[{j}]: criterion/command missing")
    if bad:
        return FAIL, truncate_list(bad)
    return PASS, f"{total} acceptance criteria, all carry a non-empty command"


def chk_stories_full_with_enactment(ctx):
    """"every story carrying Given/When/Then, a rung, and an enactment with
    evidence keys" (framed Verify)."""
    err = require(ctx, "frame")
    if err:
        return FAIL, err
    stories = g(ctx.frame, "stories", default=None)
    if not isinstance(stories, list) or not stories:
        return FAIL, "frame.stories missing or empty"
    bad = []
    for s in stories:
        if not isinstance(s, dict):
            bad.append("non-object story")
            continue
        sid = s.get("id", "<no id>")
        missing = [k for k in ("given", "when", "then") if not nonempty_str(s.get(k))]
        if s.get("rung") not in E_ORDER:
            missing.append(f"rung(got {s.get('rung')!r})")
        en = s.get("enactment")
        if not isinstance(en, dict) or not nonempty_str(en.get("command")) or not nonempty_str(en.get("setting")) \
                or not isinstance(en.get("evidence_keys"), list) or not en.get("evidence_keys"):
            missing.append("enactment{command,setting,evidence_keys[]}")
        if s.get("red_state") not in ("seen_failing", "pending_red"):
            missing.append(f"red_state(got {s.get('red_state')!r})")
        if missing:
            bad.append(f"{sid}: {','.join(missing)}")
    if bad:
        return FAIL, truncate_list(bad)
    return PASS, f"{len(stories)} stories, all carry given/when/then + rung + enactment + red_state"


def chk_rung_requests_separated(ctx):
    """"no rung above authority without a request" (framed Verify)."""
    err = require(ctx, "frame")
    if err:
        return FAIL, err
    stories = g(ctx.frame, "stories", default=[])
    bad = []
    checked = 0
    for s in stories if isinstance(stories, list) else []:
        if not isinstance(s, dict):
            continue
        rr = s.get("rung_requested")
        if rr is None:
            continue
        checked += 1
        sid = s.get("id", "<no id>")
        missing = [k for k in ("requested_from", "decide_by") if not nonempty_str(s.get(k))]
        if rr not in E_ORDER:
            missing.append(f"rung_requested(got {rr!r})")
        elif s.get("rung") in E_ORDER and E_ORDER[rr] <= E_ORDER[s["rung"]]:
            missing.append(f"rung_requested({rr}) must exceed rung({s.get('rung')})")
        if missing:
            bad.append(f"{sid}: {','.join(missing)}")
    if bad:
        return FAIL, truncate_list(bad)
    return PASS, f"{checked} stories carry a rung_requested; all have requested_from+decide_by and rung_requested>rung"


def chk_questions_dated(ctx):
    """"every open question carrying an owner and an answer-by date" (framed Verify)."""
    err = require(ctx, "frame")
    if err:
        return FAIL, err
    qs = g(ctx.frame, "questions", default=None)
    if not isinstance(qs, list):
        return FAIL, "frame.questions missing (must be a list, empty allowed)"
    bad = []
    for i, q in enumerate(qs):
        if not isinstance(q, dict):
            bad.append(f"questions[{i}] not an object")
            continue
        missing = [k for k in ("q", "owner", "answer_by") if not nonempty_str(q.get(k))]
        if not isinstance(q.get("blocking"), bool):
            missing.append("blocking(bool)")
        if not nonempty_str(q.get("assumption_if_unanswered")):
            missing.append("assumption_if_unanswered")
        if missing:
            bad.append(f"questions[{i}]({q.get('q','')[:30]!r}): {','.join(missing)}")
    if bad:
        return FAIL, truncate_list(bad)
    return PASS, f"{len(qs)} questions, all carry owner+answer_by+blocking+assumption_if_unanswered"


def chk_readback_emitted(ctx):
    """"unconfirmed read-back passes, absent does not" (framed Verify)."""
    err = require(ctx, "frame")
    if err:
        return FAIL, err
    rb = g(ctx.frame, "readback", default=None)
    if not isinstance(rb, dict):
        return FAIL, "frame.readback missing or not an object"
    if not nonempty_str(rb.get("ref")):
        return FAIL, "readback.ref is empty"
    state = rb.get("state")
    if state not in ("unconfirmed", "confirmed", "unconfirmable"):
        return FAIL, f"readback.state={state!r}, must be unconfirmed|confirmed|unconfirmable"
    if state == "confirmed" and not nonempty_str(rb.get("confirmed_by")):
        return FAIL, "readback.state=confirmed but confirmed_by is empty"
    return PASS, f"state={state}, ref present"


