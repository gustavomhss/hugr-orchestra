def chk_scopes_are_allow_lists(ctx):
    """"every scope entry resolves in the repository or is marked `new: true`
    (entering at T3 by convention)" (carved Verify, schema doc fb2c41e78c72)."""
    err = require(ctx, "packages")
    if err:
        return FAIL, err
    pkgs = g(ctx.packages, "packages", default=[])
    bad = []
    total = 0
    for p in pkgs if isinstance(pkgs, list) else []:
        pid = p.get("id", "?") if isinstance(p, dict) else "?"
        for entry in (p.get("allow_list") or []) if isinstance(p, dict) else []:
            total += 1
            if not isinstance(entry, dict) or not nonempty_str(entry.get("path")):
                bad.append(f"{pid}: malformed allow_list entry")
                continue
            is_new = entry.get("new") is True
            if is_new:
                if entry.get("tier") != "T3":
                    bad.append(f"{pid}: {entry['path']} marked new:true but tier={entry.get('tier')!r} (new-file convention requires T3)")
                continue
            if not ctx.repo_path_exists(entry["path"]):
                bad.append(f"{pid}: {entry['path']} does not exist under repo-root and is not marked new:true")
    if bad:
        return FAIL, truncate_list(bad)
    return PASS, f"{total} allow-list entries across {len(pkgs)} packages, each resolves under {ctx.repo_root} or is marked new:true at T3"


def chk_tiers_carried(ctx):
    """"every scope entry carries a tier and every package its weakest-tier
    mark" (carved Verify)."""
    err = require(ctx, "packages")
    if err:
        return FAIL, err
    pkgs = g(ctx.packages, "packages", default=[])
    bad = []
    for p in pkgs if isinstance(pkgs, list) else []:
        pid = p.get("id", "?") if isinstance(p, dict) else "?"
        entries = p.get("allow_list") or []
        tiers = []
        for entry in entries:
            t = entry.get("tier") if isinstance(entry, dict) else None
            if t not in TIER_STRENGTH:
                bad.append(f"{pid}: allow_list entry tier={t!r} invalid")
                continue
            tiers.append(t)
        if not tiers:
            bad.append(f"{pid}: no valid-tier allow_list entries")
            continue
        weakest = max(tiers, key=lambda t: TIER_STRENGTH[t])
        declared = p.get("scope_tier")
        if declared not in TIER_STRENGTH:
            bad.append(f"{pid}: scope_tier={declared!r} invalid")
        elif TIER_STRENGTH[declared] != TIER_STRENGTH[weakest]:
            bad.append(f"{pid}: scope_tier={declared} but weakest allow_list tier is {weakest}")
    if bad:
        return FAIL, truncate_list(bad)
    return PASS, f"{len(pkgs)} packages: scope_tier matches weakest allow_list tier"


