ARTIFACT_FILENAMES = ("manifest.json", "plan.md", "friction.md", "frame.json", "packages.json", "sequence.json")


def packet_text_for(ctx, package_id):
    """Best-effort: find the packet .md whose filename stem matches package_id."""
    for name, txt in ctx.packet_files.items():
        stem = name[:-3] if name.endswith(".md") else name
        if stem == package_id or package_id in name:
            return name, txt
    return None, None


def chk_packets_self_contained(ctx):
    """""no packet references content outside itself"" (frozen Verify)."""
    if not ctx.packet_files:
        return FAIL, "no packets/*.md found"
    bad = []
    for name, txt in ctx.packet_files.items():
        low = txt.lower()
        refs = []
        for fn in ARTIFACT_FILENAMES:
            if fn in low:
                refs.append(fn)
        for other_name in ctx.packet_files:
            if other_name != name and other_name.lower() in low:
                refs.append(other_name)
        if refs:
            bad.append(f"{name}: references {truncate_list(sorted(set(refs)))}")
    if bad:
        return FAIL, truncate_list(bad, 8)
    return PASS, f"{len(ctx.packet_files)} packets, none reference sibling plan artifacts by name"


def _normalize_ws(s):
    """Collapse every run of whitespace (including a markdown line-wrap's
    newline) to a single space, and strip the ends. Packets are hand-wrapped
    prose/markdown, so a long enactment.command can legitimately wrap across
    lines without being a different string — this is what "verbatim" must
    mean once wrapping is in play (doc-clarified; see README)."""
    return re.sub(r"\s+", " ", s).strip() if isinstance(s, str) else s


def chk_stories_inlined_with_enactments(ctx):
    """"every story a packet's package enacts appears in that packet verbatim
    with rung and enactment" (frozen Verify) — compared whitespace-normalized
    (runs of whitespace collapsed to one space on both sides) so a packet's
    line-wrapping of a long command doesn't read as a mismatch."""
    err = require(ctx, "frame", "packages")
    if err:
        return FAIL, err
    if not ctx.packet_files:
        return FAIL, "no packets/*.md found"
    stories = {s.get("id"): s for s in g(ctx.frame, "stories", default=[]) if isinstance(s, dict)}
    bad = []
    checked = 0
    for p in g(ctx.packages, "packages", default=[]):
        if not isinstance(p, dict):
            continue
        pid = p.get("id", "?")
        name, txt = packet_text_for(ctx, pid)
        if txt is None:
            bad.append(f"{pid}: no matching packet file")
            continue
        norm_txt = _normalize_ws(txt)
        for sid in p.get("enacts_stories") or []:
            checked += 1
            s = stories.get(sid)
            if s is None:
                bad.append(f"{pid}: enacts unknown story {sid!r}")
                continue
            cmd = g(s, "enactment", "command", default="")
            rung = s.get("rung", "")
            missing = []
            norm_cmd = _normalize_ws(cmd)
            if not (nonempty_str(cmd) and (cmd in txt or (norm_cmd and norm_cmd in norm_txt))):
                missing.append("enactment.command not found verbatim (whitespace-normalized) in packet")
            if not (nonempty_str(rung) and rung in txt):
                missing.append(f"rung {rung!r} not found in packet")
            if missing:
                bad.append(f"{pid}/{sid}: {'; '.join(missing)}")
    if bad:
        return FAIL, truncate_list(bad, 8)
    return PASS, f"{checked} enacted stories, each inlined (command + rung) verbatim in its packet"


def chk_red_first_instructed(ctx):
    """"the standing instruction to enact the red first: run the enactment
    against the unchanged system and capture it failing" (DISPATCH.packets
    procedure; red_first_instructed checklist key)."""
    if not ctx.packet_files:
        return FAIL, "no packets/*.md found"
    pattern = re.compile(
        r"(red[\s-]*first|enact the red|capture it fail|run.{0,40}(unchanged|before).{0,40}fail"
        r"|capture.{0,20}fail|before writing any (fix|code))",
        re.IGNORECASE | re.DOTALL,
    )
    bad = [name for name, txt in ctx.packet_files.items() if not pattern.search(txt)]
    if bad:
        return FAIL, f"no red-first instruction found in: {truncate_list(bad)}"
    return PASS, f"{len(ctx.packet_files)} packets all instruct red-first enactment"


def chk_acceptance_builder_runnable(ctx):
    """"builder-runnable acceptance — the criteria the builder may see and run"
    (DISPATCH.packets procedure; acceptance_builder_runnable checklist key)."""
    if not ctx.packet_files:
        return FAIL, "no packets/*.md found"
    heading = re.compile(r"##\s*acceptance", re.IGNORECASE)
    runner = re.compile(r"`[^`\n]*\b(cargo|pytest|npm|make|sh |\./|python3?)\b[^`\n]*`")
    bad = []
    for name, txt in ctx.packet_files.items():
        m = heading.search(txt)
        if not m:
            bad.append(f"{name}: no '## Acceptance' section")
            continue
        section = txt[m.end():]
        nxt = re.search(r"\n##\s", section)
        if nxt:
            section = section[:nxt.start()]
        if not runner.search(section):
            bad.append(f"{name}: Acceptance section has no runnable-looking command")
    if bad:
        return FAIL, truncate_list(bad)
    return PASS, f"{len(ctx.packet_files)} packets carry an Acceptance section with runnable commands"


def chk_ambiguity_defaults_inlined(ctx):
    """"the ambiguity defaults packets will inline" (DISPATCH.policy procedure;
    ambiguity_defaults_inlined checklist key)."""
    if not ctx.packet_files:
        return FAIL, "no packets/*.md found"
    heading = re.compile(r"##.{0,40}ambiguous", re.IGNORECASE)
    bad = []
    for name, txt in ctx.packet_files.items():
        m = heading.search(txt)
        if not m:
            bad.append(f"{name}: no 'if something is ambiguous' section")
            continue
        section = txt[m.end():]
        nxt = re.search(r"\n##\s", section)
        if nxt:
            section = section[:nxt.start()]
        if len(section.strip()) < 20:
