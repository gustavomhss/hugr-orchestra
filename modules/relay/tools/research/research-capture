#!/usr/bin/env python3
"""research-capture — freeze a source at the moment it is read, and register it.

The protocol requires every retrieved source to be snapshotted, hashed and dated. Doing that by hand
is four steps an author will get wrong on a bad day, and a control that is tedious to satisfy honestly
is a control people learn to satisfy dishonestly. So this does it in one call and writes the register
entry itself.

    research-capture --url https://example.com/notes --into research/
    research-capture --file docs/runbook.md --into research/ --repo-root .
    research-capture --cmd 'grep -c def src/x.py' --into research/ --repo-root .

For `--url` and `--file` it stores the retrieved bytes under `<into>/snapshots/S-<n>.txt`, records the
sha256, stamps `retrieved_at`, and appends to `<into>/sources.json`. For `--cmd` it records the
command and its output — a command freezes itself, because `replay-evidence` can re-run it.

WHAT THIS DOES AND DOES NOT PROVE. It does not verify the world: a page can lie, and it can say
something different tomorrow. What the snapshot makes checkable is the REPORT against what was
actually retrieved — `research-check`'s `quotes_are_verbatim` requires every quoted span to be present
in this file, and `retrieved_sources_are_snapshotted` requires this file's hash to still match. The
retrieval date is carried so a reader can judge staleness themselves rather than be promised it.

Network access is deliberately confined to `--url` and uses the stdlib. If it is unavailable, capture
the page by whatever means you have and register it with `--file`; the register cannot tell the
difference and does not need to.

Usage: research-capture (--url URL | --file PATH | --cmd CMD) --into DIR [--repo-root DIR]
                        [--id S-n] [--at ISO8601] [--json]
Exit:  0 registered · 1 retrieval failed · 2 usage/IO error
"""
import argparse
import datetime
import hashlib
import json
import os
import re
import subprocess
import sys
import urllib.request

SOURCE_ID = re.compile(r"^S-(\d+)$")
EMPTY = {"searched": [], "not_searched": [], "sources": []}


def load_register(into):
    path = os.path.join(into, "sources.json")
    if not os.path.exists(path):
        return dict(EMPTY), path
    try:
        with open(path) as f:
            doc = json.load(f)
    except ValueError as e:
        print(f"research-capture: {path} is not valid JSON: {e}", file=sys.stderr)
        raise SystemExit(2)
    for k, v in EMPTY.items():
        doc.setdefault(k, list(v))
    return doc, path


def next_id(doc):
    used = [int(m.group(1)) for s in doc["sources"]
            for m in [SOURCE_ID.match(str(s.get("id", "")))] if m]
    return f"S-{max(used) + 1 if used else 1}"


def fetch(url):
    req = urllib.request.Request(url, headers={"User-Agent": "research-capture/1.0"})
    with urllib.request.urlopen(req, timeout=30) as r:
        raw = r.read()
    try:
        return raw.decode("utf-8")
    except UnicodeDecodeError:
        return raw.decode("latin-1")


def main():
    ap = argparse.ArgumentParser(description="Freeze and register a research source.")
    g = ap.add_mutually_exclusive_group(required=True)
    g.add_argument("--url")
    g.add_argument("--file")
    g.add_argument("--cmd")
    ap.add_argument("--into", required=True)
    ap.add_argument("--repo-root", default=".")
    ap.add_argument("--id")
    ap.add_argument("--at", help="retrieval timestamp; defaults to now, UTC, ISO 8601")
    ap.add_argument("--json", action="store_true", dest="as_json")
    a = ap.parse_args()

    os.makedirs(os.path.join(a.into, "snapshots"), exist_ok=True)
    doc, path = load_register(a.into)
    sid = a.id or next_id(doc)
    if not SOURCE_ID.match(sid):
        print(f"research-capture: {sid!r} is not an S-<n> id", file=sys.stderr)
        return 2
    if any(str(s.get("id")) == sid for s in doc["sources"]):
        print(f"research-capture: {sid} is already registered", file=sys.stderr)
        return 2
    when = a.at or datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")

    if a.cmd:
        r = subprocess.run(a.cmd, shell=True, cwd=a.repo_root, capture_output=True, text=True)
        entry = {"id": sid, "kind": "command", "ref": a.cmd, "retrieved_at": when,
                 "exit": r.returncode, "output": (r.stdout or "").strip()}
    else:
        if a.url:
            try:
                body = fetch(a.url)
            except Exception as e:                       # network/DNS/TLS/HTTP — reported, never faked
                print(f"research-capture: could not retrieve {a.url}: {e}", file=sys.stderr)
                return 1
            kind, ref = "web", a.url
        else:
            src = os.path.join(a.repo_root, a.file)
            try:
                with open(src) as f:
                    body = f.read()
            except OSError as e:
                print(f"research-capture: could not read {src}: {e}", file=sys.stderr)
                return 1
            kind, ref = "file", a.file
        rel = os.path.join("snapshots", f"{sid}.txt")
        with open(os.path.join(a.into, rel), "w") as f:
            f.write(body)
        entry = {"id": sid, "kind": kind, "ref": ref, "retrieved_at": when,
                 "snapshot": rel, "sha256": hashlib.sha256(body.encode()).hexdigest(),
                 "bytes": len(body.encode())}

    doc["sources"].append(entry)
    with open(path, "w") as f:
        json.dump(doc, f, indent=1)
        f.write("\n")

    if a.as_json:
        print(json.dumps(entry, indent=2))
    else:
        where = entry.get("snapshot", "(command output recorded)")
        print(f"{sid}  {entry['kind']}  {entry['ref'][:60]}  -> {where}  at {when}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
