        "id": "question",
        "title": "Bind the question",
        "instructions": ""
      },
      {
        "id": "survey",
        "title": "Survey the ground",
        "instructions": ""
      },
      {
        "id": "evidence",
        "title": "Establish the findings",
        "instructions": ""
      },
      {
        "id": "contest",
        "title": "Contest the findings",
        "instructions": ""
