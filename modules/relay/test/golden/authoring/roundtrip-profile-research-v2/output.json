      {
        "id": "evidence.cold_review",
        "macro": "evidence",
        "kind": "review",
        "title": "Cold review",
        "instructions": "Apply GROUNDED (the evidence supports the claim), TOOTHED (the falsifier could actually be observed) and ATOMIC (one claim per finding — this one is judgment, not machine-checkable). Write the review; the gate runs its OWN cold reviewer over findings.json and that one decides. Your verdict is not what opens the gate, so record what you actually found rather than what you need it to say",
        "checklist": [
          {
            "id": "evidence-withstands-cold-review",
            "paths": [
              "${research_dir}/findings.json"
            ],
            "judge": "Read the findings in the diff and judge them yourself; you are the cold reviewer, not a grader of one. Apply GROUNDED (the recorded evidence really supports the claim, and the quoted span covers every qualifier, comparison, subject and connector the claim uses), TOOTHED (the falsifier is a concrete observation someone could make) and ATOMIC (one claim per finding). PASS only if every finding in the diff satisfies all three. FAIL and name the finding ids if any does not. Do not consider whether a review file approved them.",
            "diff": true,
            "blocking": true,
            "origin": "pe-profile:research-v2@2.0.0"
          },
          {
            "id": "evidence-review-is-substantive",
            "assert": "the review carries at least 250 characters of findings",
            "cmd": "test \"$(jq -r '.findings // \"\" | length' ${research_dir}/review-evidence.json)\" -ge 250",
            "origin": "pe-profile:research-v2@2.0.0"
          },
          {
            "id": "evidence-review-engages-with-the-diff",
            "context": [
              "${research_dir}/review-evidence.json"
            ],
            "paths": [
              "${research_dir}/findings.json"
            ],
            "judge": "Does this review apply GROUNDED (the evidence really supports the claim), TOOTHED (the falsifier is a concrete observation) and ATOMIC (one claim per finding) to the findings in the diff, by id? FAIL if it approves or rejects without naming specific items from the diff, if it makes a claim the diff does not support, if it is generic enough to apply to any artifact of this kind, or if it leaves part of the diff unjudged.",
            "diff": true,
            "blocking": true,
            "origin": "pe-profile:research-v2@2.0.0"
          }
        ]
      },
