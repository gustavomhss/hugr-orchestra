        "id": "synthesis.conclude",
        "macro": "synthesis",
        "kind": "execute",
        "title": "Conclude",
        "instructions": "Declare the calibration policy FIRST — one rule, over kinds of evidence, fixing the starting level before any conclusion is looked at — then derive each conclusion's certainty from it: its kind's starting level, one downgrade per serious concern in a named GRADE domain. Where the four-level scale absorbs a concern or every label ties, say so in floor_disclosure and name what the reader should read instead. Say which A-<n> each conclusion discharges and what would change it",
        "checklist": [
          {
            "id": "conclusions-written",
            "assert": "this state wrote the conclusions",
            "cmd": "test -s ${research_dir}/conclusions.json",
            "origin": "pe-profile:research-v2@2.0.0"
          }
        ]
