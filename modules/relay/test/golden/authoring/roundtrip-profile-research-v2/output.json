      {
        "id": "synthesis.cold_review",
        "macro": "synthesis",
        "kind": "review",
        "title": "Cold review",
        "instructions": "Review the calibration POLICY once — is one rule over kinds of evidence sound, and does its floor_disclosure say what the tied labels no longer say? — then apply DERIVED (each conclusion follows from what it cites) and CALIBRATED (the label matches the evidence) to each conclusion AGAINST that policy. The starting level and the arithmetic are settled mechanically by the gate; do not propose a different scheme, review the declared one. Write the review; the gate runs its OWN cold reviewer over conclusions.json and that one decides. Your verdict is not what opens the gate, so record what you actually found rather than what you need it to say",
        "checklist": [
          {
            "id": "conclusions-withstand-cold-review",
            "paths": [
              "${research_dir}/conclusions.json"
            ],
            "judge": "Read the conclusions in the diff and judge them yourself; you are the cold reviewer, not a grader of one. For each conclusion, ask three questions. Does it follow from the findings it cites, or does it reach past them? Does the declared calibration_policy justify its starting level as a property of the KIND of evidence rather than of the claim? Is each downgrade a real concern in the domain it names? PASS only if every conclusion in the diff holds. FAIL and name the conclusion ids if any does not. The GRADE arithmetic is already checked mechanically by the gate — do not re-derive it, and do not propose a different calibration scheme. Do not consider whether a review file approved them.",
            "diff": true,
            "blocking": true,
            "origin": "pe-profile:research-v2@2.0.0"
          },
          {
            "id": "synthesis-review-is-substantive",
            "assert": "the review carries at least 250 characters of findings",
            "cmd": "test \"$(jq -r '.findings // \"\" | length' ${research_dir}/review-synthesis.json)\" -ge 250",
